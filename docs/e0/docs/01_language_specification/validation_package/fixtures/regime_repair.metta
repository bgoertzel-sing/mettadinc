;; Regime diagnosis and selective repair.  Specification, Section 13.4.
;; @excerpt regime
(DC.Module RegimeRepair
  (Profile Stochastic)
  (Use Decisions)
  (Carrier Signal (Of Symbol) (Enum Plus Minus))
  (Carrier Act    (Of Symbol) (Enum L R))
  (Carrier Unit   (Of Nat) (Enum 0))
  (Carrier Bit    (Of Nat) (Enum 0 1))
  (Map old-law (From (Product Signal Act)) (To (Law Bit)) (Body ($sa) (Coin (Rat 1 2))))
  (Map new-law (From (Product Signal Act)) (To (Law Bit))
    (Cases ((Tuple Plus L) (Point 1)) ((Tuple Plus R) (Point 0))
           ((Tuple Minus L) (Point 0)) ((Tuple Minus R) (Point 1))))
  (Measure Fair   (On Signal) (Masses (Plus (Rat 1 2)) (Minus (Rat 1 2))))
  (Measure Skewed (On Signal) (Masses (Plus (Rat 3 4)) (Minus (Rat 1 4))))
  (DecisionModel Old (States Signal) (Actions Act) (RewardLaw old-law) (Prior Fair))
  (DecisionModel New (States Signal) (Actions Act) (RewardLaw new-law) (Prior Fair))
  (Map rewards-new (From Signal) (To (Tuple (Law Bit) (Law Bit)))
    (Cases (Plus (Tuple (Point 1) (Point 0))) (Minus (Tuple (Point 0) (Point 1)))))
  (Map stay (From Signal) (To Signal) (Cases (Plus Plus) (Minus Minus)))
  (Map collapse (From Signal) (To Unit) (Cases (Plus 0) (Minus 0)))
  (Machine NewRegime (States Signal) (Observe reward-law rewards-new) (Action wait stay))
  (Representation Coarse (Of NewRegime) (Encode collapse))
  (Carrier Reading (Of Symbol) (Enum SaysPlus SaysMinus))
  (TransitionKernel SensorChannel (From Signal) (To Reading)
    (Row Plus  (Mass SaysPlus (Rat 9 10)) (Mass SaysMinus (Rat 1 10)))
    (Row Minus (Mass SaysPlus (Rat 1 10)) (Mass SaysMinus (Rat 9 10))))
  (ObservationMethod Sensor (Channel SensorChannel) (Cost (Rat 1 20))))
;; @end
!(dc.run RegimeRepair (CheckEqual (AverageModel Old (Under Fair)) (AverageModel New (Under Fair))))
!(dc.run RegimeRepair (AverageModel New (Under Skewed)))
!(dc.run RegimeRepair (InduceExact Coarse))
!(dc.run RegimeRepair (OptimizePolicy New (Through Coarse) (Under Fair)))
!(dc.run RegimeRepair (OptimizePolicy New (Under Fair)))
!(dc.run RegimeRepair (EvaluatePolicy New (With Sensor) (Under Fair)))
