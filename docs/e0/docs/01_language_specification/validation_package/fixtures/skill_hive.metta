;; Skill-transfer hive and tick library.  Specification, Sections 10.4 and 13.3.
;; @excerpt skill-hive
(DC.Module SkillHive
  (Profile Crisp)
  (Use Transfers Hives)
  (Carrier Beacon (Of Symbol) (Enum Left Right))
  (Carrier Choice (Of Symbol) (Enum ChooseLeft ChooseRight))
  (Carrier Reward (Of Nat) (Enum 0 1))
  (Map reward (From (Product Beacon Choice)) (To Reward)
    (Cases ((Tuple Left ChooseLeft) 1) ((Tuple Left ChooseRight) 0)
           ((Tuple Right ChooseLeft) 0) ((Tuple Right ChooseRight) 1)))
  (Map same-state  (From Beacon) (To Beacon) (Cases (Left Left) (Right Right)))
  (Map flip-state  (From Beacon) (To Beacon) (Cases (Left Right) (Right Left)))
  (Map same-method (From Choice) (To Choice) (Cases (ChooseLeft ChooseLeft) (ChooseRight ChooseRight)))
  (Map flip-method (From Choice) (To Choice) (Cases (ChooseLeft ChooseRight) (ChooseRight ChooseLeft)))
  (MethodSystem A (States Beacon) (Methods Choice) (Response reward))
  (MethodSystem B (States Beacon) (Methods Choice) (Response reward))
  (MethodSystem C (States Beacon) (Methods Choice) (Response reward))
  (Transfer AB (Source A) (Target B) (StatePullback same-state) (MethodPushforward same-method))
  (Transfer BC (Source B) (Target C) (StatePullback same-state) (MethodPushforward same-method))
  (Transfer BadCA  (Source C) (Target A) (StatePullback flip-state) (MethodPushforward same-method))
  (Transfer GoodCA (Source C) (Target A) (StatePullback flip-state) (MethodPushforward flip-method))
  (Derive ABchecked     (CheckTransfer AB))
  (Derive BCchecked     (CheckTransfer BC))
  (Derive GoodCAchecked (CheckTransfer GoodCA))
  (Derive RoundTrip (ComposeTransfers (Output ABchecked Transfer) (Output BCchecked Transfer)
                                      (Output GoodCAchecked Transfer)))
  (Symmetry MirrorA (Of A) (States flip-state) (Methods flip-method))
  (Symmetry MirrorB (Of B) (States flip-state) (Methods flip-method))
  (Symmetry MirrorC (Of C) (States flip-state) (Methods flip-method))
  (TransferHive Beacons (Member A) (Member B) (Member C)
    (Edge AB) (Edge BC) (Edge GoodCA) (Cycle A B C)
    (Gauge A MirrorA) (Gauge B MirrorB) (Gauge C MirrorC))
  (TransferHive BeaconsStrict (Member A) (Member B) (Member C)
    (Edge AB) (Edge BC) (Edge GoodCA) (Cycle A B C))
  (Derive Derived   (KernelOf Beacons))
  (Derive Saturated (KernelOf Beacons (Saturate Gauge))))
;; @end
;; @excerpt skill-hive-requests
!(dc.run SkillHive (CheckTransfer BadCA))
!(dc.run SkillHive (CheckValuePullback BadCA))
!(dc.run SkillHive GoodCAchecked)
!(dc.run SkillHive RoundTrip)
!(dc.run SkillHive (CheckTransferHive Beacons))
!(dc.run SkillHive (CheckTransferHive BeaconsStrict))
!(dc.run SkillHive (CheckKernelCoherence (Output Derived Hive)))
!(dc.run SkillHive (ConsensusCost (Output Derived Hive)))
!(dc.run SkillHive (CheckKernelCoherence (Output Saturated Hive)))
;; @end

;; @excerpt orientation
(DC.Module SkillHiveOriented
  (Profile Crisp)
  (Use Transfers)
  (Import SkillHive (Only Beacon Choice reward same-state flip-state flip-method))
  (MethodSystem A2 (States Beacon) (Methods Choice) (Response reward) (Observe orientation same-state))
  (MethodSystem C2 (States Beacon) (Methods Choice) (Response reward) (Observe orientation same-state))
  (Transfer GoodCA2 (Source C2) (Target A2) (StatePullback flip-state) (MethodPushforward flip-method)))
!(dc.run SkillHiveOriented (CheckTransfer GoodCA2))
;; @end

;; @excerpt tick-library
(DC.Module TickLibrary
  (Profile Crisp)
  (Use Transfers)
  (Carrier One (Of Symbol) (Enum here))
  (Carrier SourceLabel (Of Nat) (Enum 1 2))
  (Carrier TargetLabel (Of Nat) (Enum 1 2 3 4))
  (Map source-reward (From (Product One SourceLabel)) (To Rational)
    (Cases ((Tuple here 1) (Rat 3 4)) ((Tuple here 2) (Rat 3 4))))
  (Map target-reward (From (Product One TargetLabel)) (To Rational)
    (Cases ((Tuple here 1) 0) ((Tuple here 2) (Rat 3 4)) ((Tuple here 3) 1) ((Tuple here 4) (Rat 3 4))))
  (Map keep-here (From One) (To One) (Cases (here here)))
  (Map double-label (From SourceLabel) (To TargetLabel) (Table (1 2) (2 4)))
  (Map copy-label   (From SourceLabel) (To TargetLabel) (Table (1 1) (2 2)))
  (MethodSystem Coarse (States One) (Methods SourceLabel) (Response source-reward))
  (MethodSystem Fine   (States One) (Methods TargetLabel) (Response target-reward))
  (Transfer Translate (Source Coarse) (Target Fine) (StatePullback keep-here) (MethodPushforward double-label))
  (Transfer Copy      (Source Coarse) (Target Fine) (StatePullback keep-here) (MethodPushforward copy-label)))
!(dc.run TickLibrary (CheckTransfer Translate))
!(dc.run TickLibrary (LibraryGap Translate))
!(dc.run TickLibrary (CheckTransfer Copy (Metric ExpectedReward)))
!(dc.run TickLibrary (CheckTransfer Copy))
;; @end
