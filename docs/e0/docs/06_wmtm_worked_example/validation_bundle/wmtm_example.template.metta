;; WMTM's open-item store: the modules of the worked example of Part II of the guide,
;; 4 November 2026.  The deployment is simulated: eight weeks of the goal engine's
;; log-only phase, generated by models/wx_sim.py with the seed 20261104.  Forms marked
;; PROPOSED need registry patches: those of Part II (ls_registry_patch.json, among them
;; the View field of Keyed and the Population, Selection and Policy fields of Stream) and
;; of its predecessors, and the Scheme and MeanTimeToFalseAlarm arguments of Detect
;; (wx_registry_patch.json).  The lines ";; @excerpt <name>" and ";; @end" delimit the
;; excerpts printed in the guide.

;; ============================================================ 1. the store as deployed
;; @excerpt wmtm-store
(DC.Module WMTMStore
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use RationalArith Families Statistics)              ; PROPOSED (Part II)
  ;; the item machine and its statistics, unchanged from Part II
  (Import LiveOpenItems
    (Only Days Item ItemTime EngineTime EventStat JointStat WindowView))

  ;; the nag goal: follow up on an open item while it is at most two days old
  (Map nag (From Item) (To Bool) (Cases ((Tuple $a $c $e) (And (Not $c) (Le $a 2)))))
  (Machine NagTime (States Item) (Observe nag nag) (ActionsOf ItemTime))
  ;; its index: open, past two days, and the age while it is at most two days
  (Map sat-two (From Item) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $a $c $e)
      (Tuple (Not $c) (And (Not $c) (Lt 2 $a)) (If (And (Not $c) (Le $a 2)) $a 0)))))
  (Map sat-two-wait (Parameters ($d Days)) (From (Tuple Bool Bool Rational))
    (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $o $t $v)
      (Tuple $o (And $o (Or $t (Lt 2 (Add $v $d))))
             (If (And $o (Not (Or $t (Lt 2 (Add $v $d))))) (Add $v $d) 0)))))
  (Map sat-two-close (From (Tuple Bool Bool Rational)) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $o $t $v) (Tuple False False 0))))
  (Map sat-two-nag (From (Tuple Bool Bool Rational)) (To Bool)
    (Cases ((Tuple $o $t $v) (And $o (Not $t)))))
  (Statistic NagIndex (Of NagTime) (Encode sat-two)
    (Step (wait $d) (sat-two-wait $d) (For $d Days)) (Step reply sat-two-close)
    (Read nag sat-two-nag))

  ;; the store, keyed by the engine's deduplication key: the person and the topic label
  (Carrier Person (Of Symbol) (All))
  (Carrier Topic  (Of Symbol) (All))
  (Carrier ItemKey (Of (Tuple Symbol Symbol)) (Product Person Topic))
  (Store Items (Keys ItemKey) (Of ItemTime) (Global wait))      ; PROPOSED (Part II)
  (Keyed Records (Of Items) (Item EventStat))                  ; durable
  (Keyed EngineIndex (Of Items) (Item JointStat))              ; rebuilt from Records
  (Keyed NagIndexByKey (Of Items) (Item NagIndex)              ; rebuilt from Records
    (View NagTime)))                                           ; PROPOSED View (Part II)
;; @end

;; @excerpt wmtm-store-requests
!(dc.run WMTMStore (CheckStatistic EventStat (Method Symbolic)))
!(dc.run WMTMStore (CheckStatistic JointStat (Method Symbolic)))
!(dc.run WMTMStore (CheckStatistic NagIndex (Method Symbolic)))
!(dc.run WMTMStore (CheckNow WindowView))
!(dc.run WMTMStore (CheckUpdates WindowView))
!(dc.run WMTMStore (CheckStatistic Records (Method Lift)))
!(dc.run WMTMStore (CheckStatistic EngineIndex (Method Lift)))
!(dc.run WMTMStore (CheckStatistic NagIndexByKey (Method Lift)))
;; @end

;; ======================================== 2. the release: snooze and a three-day nag
;; @excerpt wmtm-release
(DC.Module WMTMRelease
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use RationalArith Families Statistics)
  (Import LiveOpenItems (Only Days joint-wait joint-reply joint-suggest joint-open))
  (Carrier Flag (Of Bool) (Enum False True))
  ;; an item: (age, closed, days since the closing reply, days of snooze left)
  (Carrier RawS (Of (Tuple Rational Bool Rational Rational))
    (Product Days Flag Days Days))
  (Map well-formed (From (Tuple Rational Bool Rational Rational)) (To Bool)
    (Cases ((Tuple $a $c $e $r) (Le $e $a))))
  (Carrier ItemS (Of (Tuple Rational Bool Rational Rational)) (Subset RawS well-formed))
  (Map wait (Parameters ($d Days)) (From ItemS) (To ItemS)
    (Cases ((Tuple $a $c $e $r) (Tuple (Add $a $d) $c (Add $e $d) (Max 0 (Sub $r $d))))))
  (Map on-reply (From ItemS) (To ItemS)
    (Cases ((Tuple $a $c $e $r) (Tuple $a True (If $c $e 0) $r))))
  ;; "remind me in s days": the snooze ends s days from now, or later if it already did
  (Map snooze (Parameters ($s Days)) (From ItemS) (To ItemS)
    (Cases ((Tuple $a $c $e $r) (Tuple $a $c $e (Max $r $s)))))
  (Map suggest (From ItemS) (To Bool)
    (Cases ((Tuple $a $c $e $r) (And (Not $c) (And (Le $a 7) (Le $r 0))))))
  (Map open (From ItemS) (To Bool) (Cases ((Tuple $a $c $e $r) (Not $c))))
  (Map nag-two (From ItemS) (To Bool)
    (Cases ((Tuple $a $c $e $r) (And (Not $c) (Le $a 2)))))
  (Map nag-three (From ItemS) (To Bool)
    (Cases ((Tuple $a $c $e $r) (And (Not $c) (Le $a 3)))))
  (Machine ItemSnooze (States ItemS) (Observe suggest suggest) (Observe open open)
    (Action (wait $d) (wait $d) (For $d Days)) (Action reply on-reply)
    (Action (snooze $s) (snooze $s) (For $s Days)))
  (Machine NagTwo (States ItemS) (Observe nag nag-two) (ActionsOf ItemSnooze))
  (Machine NagThree (States ItemS) (Observe nag nag-three) (ActionsOf ItemSnooze))

  ;; the engine index of the log-only phase, carried over without a step for the snooze
  (Map joint-carried (From ItemS) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $a $c $e $r)
      (Tuple $c (And (Not $c) (Lt 7 $a)) (If (And (Not $c) (Le $a 7)) $a 0)))))
  (Statistic JointCarried (Of ItemSnooze) (Encode joint-carried)
    (Step (wait $d) (joint-wait $d) (For $d Days)) (Step reply joint-reply)
    (Read suggest joint-suggest) (Read open joint-open))
  ;; the same index as a representation of the new machine: what it can still answer now
  (Representation CarriedIndex (Of ItemSnooze) (Encode joint-carried))
;; @end

;; @excerpt wmtm-release-record
  ;; the durable record: the age, whether the item is closed, and the snooze left
  (Map rec (From ItemS) (To (Tuple Rational Bool Rational))
    (Cases ((Tuple $a $c $e $r) (Tuple $a $c $r))))
  (Map rec-wait (Parameters ($d Days)) (From (Tuple Rational Bool Rational))
    (To (Tuple Rational Bool Rational))
    (Cases ((Tuple $a $c $r) (Tuple (Add $a $d) $c (Max 0 (Sub $r $d))))))
  (Map rec-reply (From (Tuple Rational Bool Rational)) (To (Tuple Rational Bool Rational))
    (Cases ((Tuple $a $c $r) (Tuple $a True $r))))
  (Map rec-snooze (Parameters ($s Days)) (From (Tuple Rational Bool Rational))
    (To (Tuple Rational Bool Rational))
    (Cases ((Tuple $a $c $r) (Tuple $a $c (Max $r $s)))))
  (Map rec-suggest (From (Tuple Rational Bool Rational)) (To Bool)
    (Cases ((Tuple $a $c $r) (And (Not $c) (And (Le $a 7) (Le $r 0))))))
  (Map rec-open (From (Tuple Rational Bool Rational)) (To Bool)
    (Cases ((Tuple $a $c $r) (Not $c))))
  (Statistic RecordS (Of ItemSnooze) (Encode rec)
    (Step (wait $d) (rec-wait $d) (For $d Days)) (Step reply rec-reply)
    (Step (snooze $s) (rec-snooze $s) (For $s Days))
    (Read suggest rec-suggest) (Read open rec-open))

  ;; the coarsest engine index: closed; open but out of the engine's reach for good
  ;; (past seven days, or snoozed past the seventh day); or live, with age and snooze
  (Map joint (From ItemS) (To (Tuple Bool Bool Rational Rational))
    (Cases ((Tuple $a $c $e $r)
      (Tuple $c (And (Not $c) (Lt 7 (Add $a $r)))
             (If (And (Not $c) (Le (Add $a $r) 7)) $a 0)
             (If (And (Not $c) (Le (Add $a $r) 7)) $r 0)))))
  (Map joint-s-wait (Parameters ($d Days)) (From (Tuple Bool Bool Rational Rational))
    (To (Tuple Bool Bool Rational Rational))
    (Cases ((Tuple $c $t $v $u)
      (Tuple $c (And (Not $c) (Or $t (Lt 7 (Add $v $d))))
             (If (And (Not $c) (Not (Or $t (Lt 7 (Add $v $d))))) (Add $v $d) 0)
             (If (And (Not $c) (Not (Or $t (Lt 7 (Add $v $d)))))
                 (Max 0 (Sub $u $d)) 0)))))
  (Map joint-s-reply (From (Tuple Bool Bool Rational Rational))
    (To (Tuple Bool Bool Rational Rational))
    (Cases ((Tuple $c $t $v $u) (Tuple True False 0 0))))
  (Map joint-s-snooze (Parameters ($s Days)) (From (Tuple Bool Bool Rational Rational))
    (To (Tuple Bool Bool Rational Rational))
    (Cases ((Tuple $c $t $v $u)
      (Tuple $c (And (Not $c) (Or $t (Lt 7 (Add $v (Max $u $s)))))
             (If (And (Not $c) (Not (Or $t (Lt 7 (Add $v (Max $u $s)))))) $v 0)
             (If (And (Not $c) (Not (Or $t (Lt 7 (Add $v (Max $u $s))))))
                 (Max $u $s) 0)))))
  (Map joint-s-suggest (From (Tuple Bool Bool Rational Rational)) (To Bool)
    (Cases ((Tuple $c $t $v $u) (And (Not $c) (And (Not $t) (Le $u 0))))))
  (Map joint-s-open (From (Tuple Bool Bool Rational Rational)) (To Bool)
    (Cases ((Tuple $c $t $v $u) (Not $c))))
  (Statistic JointS (Of ItemSnooze) (Encode joint)
    (Step (wait $d) (joint-s-wait $d) (For $d Days)) (Step reply joint-s-reply)
    (Step (snooze $s) (joint-s-snooze $s) (For $s Days))
    (Read suggest joint-s-suggest) (Read open joint-s-open))
;; @end

;; @excerpt wmtm-release-nag
  ;; the nag index: saturation at two days; the snooze does not change it
  (Map sat-two (From ItemS) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $a $c $e $r)
      (Tuple (Not $c) (And (Not $c) (Lt 2 $a)) (If (And (Not $c) (Le $a 2)) $a 0)))))
  (Map sat-two-wait (Parameters ($d Days)) (From (Tuple Bool Bool Rational))
    (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $o $t $v)
      (Tuple $o (And $o (Or $t (Lt 2 (Add $v $d))))
             (If (And $o (Not (Or $t (Lt 2 (Add $v $d))))) (Add $v $d) 0)))))
  (Map sat-close (From (Tuple Bool Bool Rational)) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $o $t $v) (Tuple False False 0))))
  (Map sat-keep (Parameters ($s Days)) (From (Tuple Bool Bool Rational))
    (To (Tuple Bool Bool Rational)) (Cases ((Tuple $o $t $v) (Tuple $o $t $v))))
  (Map sat-nag (From (Tuple Bool Bool Rational)) (To Bool)
    (Cases ((Tuple $o $t $v) (And $o (Not $t)))))
  (Statistic NagTwoIndex (Of NagTwo) (Encode sat-two)
    (Step (wait $d) (sat-two-wait $d) (For $d Days)) (Step reply sat-close)
    (Step (snooze $s) (sat-keep $s) (For $s Days)) (Read nag sat-nag))
  ;; the planned goal reads three days; the two-day index stores ages past two days alike
  (Representation TwoForThree (Of NagThree) (Encode sat-two))
  (Map sat-three (From ItemS) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $a $c $e $r)
      (Tuple (Not $c) (And (Not $c) (Lt 3 $a)) (If (And (Not $c) (Le $a 3)) $a 0)))))
  (Map sat-three-wait (Parameters ($d Days)) (From (Tuple Bool Bool Rational))
    (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $o $t $v)
      (Tuple $o (And $o (Or $t (Lt 3 (Add $v $d))))
             (If (And $o (Not (Or $t (Lt 3 (Add $v $d))))) (Add $v $d) 0)))))
  (Statistic NagThreeIndex (Of NagThree) (Encode sat-three)
    (Step (wait $d) (sat-three-wait $d) (For $d Days)) (Step reply sat-close)
    (Step (snooze $s) (sat-keep $s) (For $s Days)) (Read nag sat-nag))
  ;; rebuilding the new index from the durable record: the record is a statistic of
  ;; the machine that observes the new index, and its read map is the rebuild
  (Machine NewIndexView (States ItemS) (Observe index sat-three) (ActionsOf ItemSnooze))
  (Map rebuild-three (From (Tuple Rational Bool Rational)) (To (Tuple Bool Bool Rational))
    (Cases ((Tuple $a $c $r)
      (Tuple (Not $c) (And (Not $c) (Lt 3 $a)) (If (And (Not $c) (Le $a 3)) $a 0)))))
  (Statistic RebuildFromRecords (Of NewIndexView) (Encode rec)
    (Step (wait $d) (rec-wait $d) (For $d Days)) (Step reply rec-reply)
    (Step (snooze $s) (rec-snooze $s) (For $s Days)) (Read index rebuild-three))
  ;; the engine index is rebuilt from the durable record in the same way
  (Machine EngineIndexView (States ItemS) (Observe index joint) (ActionsOf ItemSnooze))
  (Map rebuild-joint (From (Tuple Rational Bool Rational))
    (To (Tuple Bool Bool Rational Rational))
    (Cases ((Tuple $a $c $r)
      (Tuple $c (And (Not $c) (Lt 7 (Add $a $r)))
             (If (And (Not $c) (Le (Add $a $r) 7)) $a 0)
             (If (And (Not $c) (Le (Add $a $r) 7)) $r 0)))))
  (Statistic RebuildEngineIndex (Of EngineIndexView) (Encode rec)
    (Step (wait $d) (rec-wait $d) (For $d Days)) (Step reply rec-reply)
    (Step (snooze $s) (rec-snooze $s) (For $s Days)) (Read index rebuild-joint))

  ;; the store after the release
  (Carrier Person (Of Symbol) (All))
  (Carrier Topic  (Of Symbol) (All))
  (Carrier ItemKey (Of (Tuple Symbol Symbol)) (Product Person Topic))
  (Store ItemsS (Keys ItemKey) (Of ItemSnooze) (Global wait))
  (Keyed RecordsByKey (Of ItemsS) (Item RecordS))
  (Keyed EngineIndexS (Of ItemsS) (Item JointS))
  (Keyed NagIndexS (Of ItemsS) (Item NagThreeIndex) (View NagThree)))
;; @end

;; @excerpt wmtm-release-requests
!(dc.run WMTMRelease (CheckStatistic JointCarried (Method Symbolic)))
!(dc.run WMTMRelease (CheckNow CarriedIndex))
!(dc.run WMTMRelease (CheckStatistic RecordS (Method Symbolic)))
!(dc.run WMTMRelease (CheckStatistic JointS (Method Symbolic)))
!(dc.run WMTMRelease (CheckStatistic NagTwoIndex (Method Symbolic)))
!(dc.run WMTMRelease (CheckNow TwoForThree))
!(dc.run WMTMRelease (CheckStatistic NagThreeIndex (Method Symbolic)))
!(dc.run WMTMRelease (CheckStatistic RebuildFromRecords (Method Symbolic)))
!(dc.run WMTMRelease (CheckStatistic RebuildEngineIndex (Method Symbolic)))
!(dc.run WMTMRelease (CheckStatistic EngineIndexS (Method Lift)))
!(dc.run WMTMRelease (CheckStatistic NagIndexS (Method Lift)))
;; @end

;; ======================================== 3. receipts, monitors and the gate
;; @excerpt wmtm-receipts
(DC.Module WMTMReceipts
  (Profile Stochastic)
  (Use Decisions Laws Families Monitors Estimates)     ; PROPOSED Estimates (Part II)
  ;; one receipt per reply, released at the next cycle: was the item proposed (stale)?
  (Stream Replies (Source "streams/replies.json")
    (Digest "{DIGEST:replies}")
    (Provenance "simulated: replies to items at most seven days old, days 0-55")
    (Population "replies to items at most seven days old at the next cycle")
    (Selection "one row per reply at the next cycle, after its review, by reply time")
    (Policy "log-only phase; parser v1, v2 from day 21 10:00 to day 24 12:00"))
  (Stream RepliesBefore (Source "streams/replies_before.json")
    (Digest "{DIGEST:replies_before}")
    (Provenance "simulated: the reply receipts of days 0-21, before the parser update")
    (Population "replies to items at most seven days old at the next cycle")
    (Selection "the rows of Replies released on days 0-21")
    (Policy "log-only phase; parser v1"))
  (Stream RepliesGate (Source "streams/replies_gate.json")
    (Digest "{DIGEST:replies_gate}")
    (Provenance "simulated: the reply receipts of days 28-55")
    (Population "replies to items at most seven days old at the next cycle")
    (Selection "the rows of Replies released on days 28-55")
    (Policy "log-only phase; parser v1, journal re-parsed on day 24"))
  ;; one receipt per key at its first proposal: the review's duplicate label
  (Stream KeysGate (Source "streams/keys_gate.json")
    (Digest "{DIGEST:keys_gate}")
    (Provenance "simulated: keys first proposed on days 28-55")
    (Population "keys that the event design proposes")
    (Selection "one row per key at its first proposal, days 28-55")
    (Policy "log-only phase; parser v1, journal re-parsed on day 24"))
  ;; one receipt per key at the end of its seven days: did each design decide wrongly?
  (Stream LivesGate (Source "streams/lives_gate.json")
    (Digest "{DIGEST:lives_gate}")
    (Provenance "simulated: keys whose daily decisions all fall on days 28-55")
    (Population "keys that are not duplicates and that either design proposed")
    (Selection "one row per key whose decisions all fall on days 28-55")
    (Policy "log-only phase; both designs; parser v1"))
  ;; one receipt per key at its first closing: was the closing note a real reply?
  (Stream ClosuresGate (Source "streams/closures_gate.json")
    (Digest "{DIGEST:closures_gate}")
    (Provenance "simulated: first closings learned between the cycles of days 27 and 55")
    (Population "first closings of keys that are not duplicates")
    (Selection "one row per key at the cycle after memory learns its first closing")
    (Policy "log-only phase; parser v1, journal re-parsed on day 24"))
  ;; the random audit at age four days, and the targeted audit after the alarm
  (Stream AuditRepliesGate (Source "streams/audit_replies_gate.json")
    (Digest "{DIGEST:audit_replies_gate}")
    (Provenance "simulated: audited items with a reply by age four, days 28-55")
    (Population "items, sampled at creation with probability 1/3")
    (Selection "one row per sampled item replied by age four, audited at four")
    (Policy "log-only phase; parser v1, journal re-parsed on day 24"))
  (Stream AuditOpenGate (Source "streams/audit_open_gate.json")
    (Digest "{DIGEST:audit_open_gate}")
    (Provenance "simulated: audited items without a reply by age four, days 28-55")
    (Population "items, sampled at creation with probability 1/3")
    (Selection "one row per sampled item not replied by age four, audited at four")
    (Policy "log-only phase; parser v1, journal re-parsed on day 24"))
  (Stream AuditAfterAlarm (Source "streams/audit_after_alarm.json")
    (Digest "{DIGEST:audit_after_alarm}")
    (Provenance "simulated: audited replies received after the receipts of the alarm")
    (Population "replies received from the alarm cycle to the audit on day 24")
    (Selection "every such reply, audited on day 24 at 09:00")
    (Policy "log-only phase; parser v2"))
  (Stream AuditV2 (Source "streams/audit_replies_v2.json")
    (Digest "{DIGEST:audit_replies_v2}")
    (Provenance "simulated: every reply between the parser update and the audit")
    (Population "replies received from the parser update to the audit on day 24")
    (Selection "every such reply, audited on day 24 at 09:00")
    (Policy "log-only phase; parser v2"))

  ;; the monitors: a missed reply that reaches a proposal, accepted at one in twenty
  (Carrier One  (Of Symbol) (Enum one))
  (Carrier Rate (Of Symbol) (Enum accepted tenth fifth twofifths))
  (Map miss-rate (From Rate) (To Rational01)
    (Table (accepted (Rat 1 20)) (tenth (Rat 1 10)) (fifth (Rat 1 5))
           (twofifths (Rat 2 5))))
  (Map stale (Parameters ($r Rate)) (From One) (To (Law Nat))
    (Body ($u) (Coin (miss-rate $r))))
  (Monitor MissTenth (Context One) (Null (stale accepted)) (Alternative (stale tenth))
    (Columns (observation "stale")))
  (Monitor MissFifth (Context One) (Null (stale accepted)) (Alternative (stale fifth))
    (Columns (observation "stale")))
  (Monitor MissTwoFifths (Context One) (Null (stale accepted))
    (Alternative (stale twofifths)) (Columns (observation "stale"))))
;; @end

;; @excerpt wmtm-monitor-requests
!(dc.run WMTMReceipts (CheckMonitor MissTenth))
!(dc.run WMTMReceipts (CheckMonitor MissFifth))
!(dc.run WMTMReceipts (CheckMonitor MissTwoFifths))
!(dc.run WMTMReceipts
   (Detect MissTenth MissFifth MissTwoFifths (On Replies) (Level (Rat 1 100))
           (Combine Mixture)))
!(dc.run WMTMReceipts
   (Detect MissTenth MissFifth MissTwoFifths (On Replies) (Combine Mixture)
           (Scheme ShiryaevRoberts) (MeanTimeToFalseAlarm 100000)))   ; PROPOSED Scheme
!(dc.run WMTMReceipts
   (EstimateRate (On RepliesBefore) (Column "stale") (Equals 1) (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (EstimateRate (On AuditAfterAlarm) (Column "missed") (Equals 1) (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (EstimateRate (On AuditV2) (Column "missed") (Equals 1) (Level (Rat 1 100))))
;; @end

;; @excerpt wmtm-gate-requests
!(dc.run WMTMReceipts
   (EstimateRate (On RepliesGate) (Column "stale") (Equals 1) (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (EstimateRate (On KeysGate) (Column "duplicate") (Equals 1) (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (EstimateRate (On ClosuresGate) (Column "spurious") (Equals 1) (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (CompareRates (On LivesGate) (First "window_bad") (Second "event_bad") (Equals 1)
                 (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (EstimateRate (On AuditRepliesGate) (Column "missed") (Equals 1) (Level (Rat 1 100))))
!(dc.run WMTMReceipts
   (EstimateRate (On AuditOpenGate) (Column "false_close") (Equals 1)
                 (Level (Rat 1 100))))
;; @end
