(DC.Module LN3
  (Profile Stochastic)
  (Use Linear)
  (Carrier Report (Of Nat) (Enum 0 1))
  (Carrier S (Of Symbol) (Enum s0 s1))
  (Map repS (From S) (To Report) (Cases (s0 0) (s1 1)))
  (TransitionKernel KSa0 (From S) (To S)
    (Row s0 (Mass s0 1))
    (Row s1 (Mass s1 1)))
  (Machine MS (States S) (Observe report repS) (Action a0 KSa0))
  (Carrier T (Of Symbol) (Enum t0 t1))
  (Map repT (From T) (To Report) (Cases (t0 0) (t1 1)))
  (TransitionKernel KTa0 (From T) (To T)
    (Row t0 (Mass t0 1))
    (Row t1 (Mass t1 1)))
  (Machine MT (States T) (Observe report repT) (Action a0 KTa0))
  (LinearArrow L (Source MS) (Target MT) (Kind Positive)
    (Matrix (Rows (s0 (t0 (Rat 1 2)) (t1 (Rat 1 2))) (s1 (t1 1)))))
  (Derive LC (CheckLinearArrow L)))
!(dc.run LN3 LC)
