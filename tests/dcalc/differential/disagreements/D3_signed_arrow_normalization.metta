(DC.Module LN2
  (Profile Stochastic)
  (Use Linear)
  (Carrier Report (Of Nat) (Enum 0 1))
  (Carrier S (Of Symbol) (Enum s0 s1 s2))
  (Map repS (From S) (To Report) (Cases (s0 1) (s1 0) (s2 1)))
  (TransitionKernel KSa0 (From S) (To S)
    (Row s0 (Mass s2 1))
    (Row s1 (Mass s2 1))
    (Row s2 (Mass s2 1)))
  (Machine MS (States S) (Observe report repS) (Action a0 KSa0))
  (Carrier T (Of Symbol) (Enum t0 t1 t2))
  (Map repT (From T) (To Report) (Cases (t0 0) (t1 1) (t2 1)))
  (TransitionKernel KTa0 (From T) (To T)
    (Row t0 (Mass t2 1))
    (Row t1 (Mass t2 1))
    (Row t2 (Mass t2 1)))
  (Machine MT (States T) (Observe report repT) (Action a0 KTa0))
  (LinearArrow L (Source MS) (Target MT) (Kind Signed)
    (Matrix (Rows (s0 (t1 2)) (s1 (t0 2)) (s2 (t2 2)))))
  (LinearArrow E (Source MS) (Target MT) (Kind Signed)
    (Matrix (Rows (s0 (t1 1)) (s1 (t0 1)) (s2 (t2 1)))))
  (Derive LC (CheckLinearArrow L))
  (Derive EC (CheckLinearArrow E)))
!(dc.run LN2 LC)
!(dc.run LN2 EC)
