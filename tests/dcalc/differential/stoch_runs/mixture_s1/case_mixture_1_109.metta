(DC.Module R109
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass v (Rat 3 4)) (Mass b0 (Rat 1 4)) (Mass u 0)) (Row v (Mass b0 (Rat 1 2)) (Mass u (Rat 1 2))) (Row w (Mass v (Rat 1 2)) (Mass b0 (Rat 1 3)) (Mass u (Rat 1 6))) (Row b0 (Mass b0 0) (Mass u (Rat 1 2)) (Mass w (Rat 1 2))))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R109 (MinimizeForQueries Chain))
!(dc.run R109 (TracePartition Chain))
!(dc.run R109 (MinimalLinear Chain))
!(dc.run R109 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R109 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R109 (CheckTrace Merge))
