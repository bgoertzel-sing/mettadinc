(DC.Module R112
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 0)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row y (Mass w 1)) (Row u (Mass b0 (Rat 3 4)) (Mass u (Rat 1 4))) (Row v (Mass v 1) (Mass b0 0)) (Row w (Mass b0 (Rat 3 8)) (Mass u (Rat 1 8)) (Mass v (Rat 1 2))) (Row b0 (Mass w 0) (Mass x (Rat 1 3)) (Mass v (Rat 2 3))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass v (Rat 1 3)) (Mass b0 (Rat 1 3)) (Mass u (Rat 1 3))) (Row v (Mass b0 0) (Mass v 1)) (Row w (Mass v (Rat 2 3)) (Mass b0 (Rat 1 6)) (Mass u (Rat 1 6))) (Row b0 (Mass w 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R112 (MinimizeForQueries Chain))
!(dc.run R112 (TracePartition Chain))
!(dc.run R112 (MinimalLinear Chain))
!(dc.run R112 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R112 (MeasureBehavioral Merge (Horizon (Steps 0))))
!(dc.run R112 (CheckTrace Merge))
