(DC.Module R12
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 4)) (Mass v (Rat 3 4))) (Row y (Mass w 1)) (Row u (Mass v 0) (Mass u 1)) (Row v (Mass b0 (Rat 5 6)) (Mass v (Rat 1 6))) (Row w (Mass v (Rat 1 8)) (Mass u (Rat 1 4)) (Mass b0 (Rat 5 8))) (Row b0 (Mass u (Rat 1 3)) (Mass y (Rat 1 2)) (Mass b0 (Rat 1 6))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass v (Rat 1 6)) (Mass b0 (Rat 5 6))) (Row v (Mass u (Rat 1 2)) (Mass b0 (Rat 1 2))) (Row w (Mass v (Rat 1 24)) (Mass b0 (Rat 7 12)) (Mass u (Rat 3 8))) (Row b0 (Mass u (Rat 1 2)) (Mass v (Rat 1 2))))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R12 (MinimizeForQueries Chain))
!(dc.run R12 (TracePartition Chain))
!(dc.run R12 (MinimalLinear Chain))
!(dc.run R12 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R12 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R12 (CheckTrace Merge))
