(DC.Module R127
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass u 0) (Mass b1 1)) (Row v (Mass v 1)) (Row w (Mass u 0) (Mass b1 (Rat 1 3)) (Mass v (Rat 2 3))) (Row b0 (Mass x 1)) (Row b1 (Mass b1 (Rat 5 6)) (Mass u (Rat 1 6))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b1 1) (Mass v 0)) (Row v (Mass v 0) (Mass b0 (Rat 2 3)) (Mass b1 (Rat 1 3))) (Row w (Mass b1 (Rat 5 9)) (Mass v 0) (Mass b0 (Rat 4 9))) (Row b0 (Mass w (Rat 1 2)) (Mass b0 (Rat 1 2)) (Mass y 0)) (Row b1 (Mass x 0) (Mass w 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R127 (MinimizeForQueries Chain))
!(dc.run R127 (TracePartition Chain))
!(dc.run R127 (MinimalLinear Chain))
!(dc.run R127 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R127 (MeasureBehavioral Merge (Horizon (Steps 3))))
!(dc.run R127 (CheckTrace Merge))
