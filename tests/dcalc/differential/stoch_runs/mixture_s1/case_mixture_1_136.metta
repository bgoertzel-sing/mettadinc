(DC.Module R136
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass u 1)) (Row v (Mass b0 (Rat 1 2)) (Mass u (Rat 1 2))) (Row w (Mass u (Rat 2 3)) (Mass b0 (Rat 1 3))) (Row b0 (Mass b0 (Rat 1 2)) (Mass x (Rat 1 2))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b0 (Rat 3 4)) (Mass u (Rat 1 4))) (Row v (Mass b0 1)) (Row w (Mass b0 (Rat 11 12)) (Mass u (Rat 1 12))) (Row b0 (Mass w 1) (Mass u 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R136 (MinimizeForQueries Chain))
!(dc.run R136 (TracePartition Chain))
!(dc.run R136 (MinimalLinear Chain))
!(dc.run R136 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R136 (MeasureBehavioral Merge (Horizon (Steps 2))))
!(dc.run R136 (CheckTrace Merge))
