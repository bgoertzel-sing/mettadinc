(DC.Module R150
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row y (Mass w 1)) (Row u (Mass v (Rat 3 4)) (Mass b0 (Rat 1 4)) (Mass u 0)) (Row v (Mass v (Rat 1 3)) (Mass u (Rat 2 3))) (Row w (Mass v (Rat 13 24)) (Mass b0 (Rat 1 8)) (Mass u (Rat 1 3))) (Row b0 (Mass y 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R150 (MinimizeForQueries Chain))
!(dc.run R150 (TracePartition Chain))
!(dc.run R150 (MinimalLinear Chain))
!(dc.run R150 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R150 (MeasureBehavioral Merge (Horizon (Steps 0))))
!(dc.run R150 (CheckTrace Merge))
