(DC.Module R153
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2) (b1 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass u 0) (Mass b1 (Rat 1 3)) (Mass b0 (Rat 2 3))) (Row v (Mass u (Rat 1 3)) (Mass b1 (Rat 1 2)) (Mass v (Rat 1 6))) (Row w (Mass u (Rat 1 9)) (Mass b1 (Rat 7 18)) (Mass b0 (Rat 4 9)) (Mass v (Rat 1 18))) (Row b0 (Mass v (Rat 1 3)) (Mass x (Rat 1 3)) (Mass y (Rat 1 3))) (Row b1 (Mass b0 (Rat 1 4)) (Mass w (Rat 1 2)) (Mass x (Rat 1 4))))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R153 (MinimizeForQueries Chain))
!(dc.run R153 (TracePartition Chain))
!(dc.run R153 (MinimalLinear Chain))
!(dc.run R153 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R153 (MeasureBehavioral Merge (Horizon (Steps 0))))
!(dc.run R153 (CheckTrace Merge))
