(DC.Module R160
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 0) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass u (Rat 3 4)) (Mass b1 (Rat 1 4))) (Row v (Mass b0 (Rat 1 3)) (Mass b1 (Rat 2 3)) (Mass u 0)) (Row w (Mass u (Rat 1 2)) (Mass b1 (Rat 7 18)) (Mass b0 (Rat 1 9))) (Row b0 (Mass v 1) (Mass u 0)) (Row b1 (Mass b0 (Rat 1 2)) (Mass y (Rat 1 2))))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R160 (MinimizeForQueries Chain))
!(dc.run R160 (TracePartition Chain))
!(dc.run R160 (MinimalLinear Chain))
!(dc.run R160 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R160 (MeasureBehavioral Merge (Horizon (Steps 3))))
!(dc.run R160 (CheckTrace Merge))
