(DC.Module R186
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass u 0) (Mass v (Rat 3 4)) (Mass b1 (Rat 1 4))) (Row v (Mass v 1) (Mass u 0)) (Row w (Mass u 0) (Mass v (Rat 5 6)) (Mass b1 (Rat 1 6))) (Row b0 (Mass y 1) (Mass x 0)) (Row b1 (Mass b0 1)))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b0 (Rat 2 3)) (Mass u (Rat 1 3)) (Mass b1 0)) (Row v (Mass b1 0) (Mass u (Rat 3 4)) (Mass v (Rat 1 4))) (Row w (Mass b0 (Rat 4 9)) (Mass u (Rat 17 36)) (Mass b1 0) (Mass v (Rat 1 12))) (Row b0 (Mass x 1)) (Row b1 (Mass x 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R186 (MinimizeForQueries Chain))
!(dc.run R186 (TracePartition Chain))
!(dc.run R186 (MinimalLinear Chain))
!(dc.run R186 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R186 (MeasureBehavioral Merge (Horizon (Steps 2))))
!(dc.run R186 (CheckTrace Merge))
