(DC.Module R20
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 0) (b1 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass v (Rat 1 3)) (Mass u (Rat 1 3)) (Mass b1 (Rat 1 3))) (Row v (Mass b1 (Rat 1 2)) (Mass u (Rat 1 2))) (Row w (Mass v (Rat 1 9)) (Mass u (Rat 4 9)) (Mass b1 (Rat 4 9))) (Row b0 (Mass w 1)) (Row b1 (Mass b1 (Rat 1 2)) (Mass u 0) (Mass y (Rat 1 2))))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R20 (MinimizeForQueries Chain))
!(dc.run R20 (TracePartition Chain))
!(dc.run R20 (MinimalLinear Chain))
!(dc.run R20 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R20 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R20 (CheckTrace Merge))
