(DC.Module R22
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 1) (b1 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row y (Mass w 1)) (Row u (Mass v (Rat 1 4)) (Mass b1 (Rat 3 4)) (Mass b0 0)) (Row v (Mass b0 0) (Mass u 1) (Mass v 0)) (Row w (Mass v (Rat 1 8)) (Mass b1 (Rat 3 8)) (Mass b0 0) (Mass u (Rat 1 2))) (Row b0 (Mass y 1)) (Row b1 (Mass w 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R22 (MinimizeForQueries Chain))
!(dc.run R22 (TracePartition Chain))
!(dc.run R22 (MinimalLinear Chain))
!(dc.run R22 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R22 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R22 (CheckTrace Merge))
