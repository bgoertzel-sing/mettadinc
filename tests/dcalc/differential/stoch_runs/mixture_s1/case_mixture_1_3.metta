(DC.Module R3
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 1) (b1 0)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass b1 (Rat 5 6)) (Mass u (Rat 1 6))) (Row v (Mass b0 1)) (Row w (Mass b1 (Rat 5 9)) (Mass u (Rat 1 9)) (Mass b0 (Rat 1 3))) (Row b0 (Mass x (Rat 1 3)) (Mass u (Rat 1 3)) (Mass b0 (Rat 1 3)) (Mass v 0)) (Row b1 (Mass u 1) (Mass v 0)))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b1 1)) (Row v (Mass b0 (Rat 1 2)) (Mass u (Rat 1 2))) (Row w (Mass b1 (Rat 2 3)) (Mass b0 (Rat 1 6)) (Mass u (Rat 1 6))) (Row b0 (Mass y (Rat 1 4)) (Mass b1 (Rat 3 4))) (Row b1 (Mass b1 (Rat 1 6)) (Mass v (Rat 5 6)) (Mass u 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R3 (MinimizeForQueries Chain))
!(dc.run R3 (TracePartition Chain))
!(dc.run R3 (MinimalLinear Chain))
!(dc.run R3 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R3 (MeasureBehavioral Merge (Horizon (Steps 3))))
!(dc.run R3 (CheckTrace Merge))
