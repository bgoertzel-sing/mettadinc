(DC.Module R32
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row y (Mass w 1)) (Row u (Mass v (Rat 1 2)) (Mass b1 (Rat 1 2))) (Row v (Mass u (Rat 1 2)) (Mass b0 (Rat 1 2))) (Row w (Mass v (Rat 1 4)) (Mass b1 (Rat 1 4)) (Mass u (Rat 1 4)) (Mass b0 (Rat 1 4))) (Row b0 (Mass y (Rat 1 2)) (Mass w (Rat 1 2)) (Mass x 0)) (Row b1 (Mass w 0) (Mass u 0) (Mass b0 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R32 (MinimizeForQueries Chain))
!(dc.run R32 (TracePartition Chain))
!(dc.run R32 (MinimalLinear Chain))
!(dc.run R32 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R32 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R32 (CheckTrace Merge))
