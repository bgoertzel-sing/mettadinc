(DC.Module R47
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 4)) (Mass v (Rat 3 4))) (Row y (Mass w 1)) (Row u (Mass v 0) (Mass b0 (Rat 1 2)) (Mass u (Rat 1 2))) (Row v (Mass v (Rat 1 2)) (Mass b0 (Rat 1 2)) (Mass b1 0)) (Row w (Mass v (Rat 3 8)) (Mass b0 (Rat 1 2)) (Mass u (Rat 1 8)) (Mass b1 0)) (Row b0 (Mass x 1) (Mass b1 0)) (Row b1 (Mass b1 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R47 (MinimizeForQueries Chain))
!(dc.run R47 (TracePartition Chain))
!(dc.run R47 (MinimalLinear Chain))
!(dc.run R47 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R47 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R47 (CheckTrace Merge))
