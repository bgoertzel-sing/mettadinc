(DC.Module R60
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 2) (b1 0)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass v (Rat 1 3)) (Mass u (Rat 1 3)) (Mass b1 (Rat 1 3))) (Row v (Mass v (Rat 1 2)) (Mass u (Rat 1 2))) (Row w (Mass v (Rat 4 9)) (Mass u (Rat 4 9)) (Mass b1 (Rat 1 9))) (Row b0 (Mass w 1) (Mass y 0)) (Row b1 (Mass v 0) (Mass u (Rat 1 2)) (Mass y (Rat 1 2))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass u 1) (Mass b0 0) (Mass b1 0)) (Row v (Mass b1 (Rat 2 3)) (Mass b0 (Rat 1 3))) (Row w (Mass u (Rat 1 3)) (Mass b0 (Rat 2 9)) (Mass b1 (Rat 4 9))) (Row b0 (Mass v 0) (Mass w (Rat 1 3)) (Mass u (Rat 2 3))) (Row b1 (Mass b0 0) (Mass x 1) (Mass v 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R60 (MinimizeForQueries Chain))
!(dc.run R60 (TracePartition Chain))
!(dc.run R60 (MinimalLinear Chain))
!(dc.run R60 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R60 (MeasureBehavioral Merge (Horizon (Steps 3))))
!(dc.run R60 (CheckTrace Merge))
