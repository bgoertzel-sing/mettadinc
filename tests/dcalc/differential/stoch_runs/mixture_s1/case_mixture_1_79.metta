(DC.Module R79
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 0)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass u 1) (Mass v 0)) (Row v (Mass b0 (Rat 1 3)) (Mass u (Rat 1 3)) (Mass v (Rat 1 3))) (Row w (Mass u (Rat 5 9)) (Mass v (Rat 2 9)) (Mass b0 (Rat 2 9))) (Row b0 (Mass v (Rat 1 2)) (Mass u (Rat 1 2)) (Mass b0 0)))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row v (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row w (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row b0 (Mass u 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R79 (MinimizeForQueries Chain))
!(dc.run R79 (TracePartition Chain))
!(dc.run R79 (MinimalLinear Chain))
!(dc.run R79 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R79 (MeasureBehavioral Merge (Horizon (Steps 0))))
!(dc.run R79 (CheckTrace Merge))
