(DC.Module R97
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 4)) (Mass v (Rat 3 4))) (Row y (Mass w 1)) (Row u (Mass v 1)) (Row v (Mass b0 (Rat 1 3)) (Mass v (Rat 1 3)) (Mass u (Rat 1 3))) (Row w (Mass v (Rat 1 2)) (Mass b0 (Rat 1 4)) (Mass u (Rat 1 4))) (Row b0 (Mass y 0) (Mass b0 1) (Mass w 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R97 (MinimizeForQueries Chain))
!(dc.run R97 (TracePartition Chain))
!(dc.run R97 (MinimalLinear Chain))
!(dc.run R97 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R97 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R97 (CheckTrace Merge))
