(DC.Module R116
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass v 1)) (Row v (Mass b0 (Rat 1 3)) (Mass u (Rat 1 3)) (Mass v (Rat 1 3))) (Row w (Mass v (Rat 7 9)) (Mass b0 (Rat 1 9)) (Mass u (Rat 1 9))) (Row b0 (Mass y (Rat 1 2)) (Mass v (Rat 1 2))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass u (Rat 1 3)) (Mass v (Rat 1 3)) (Mass b0 (Rat 1 3))) (Row v (Mass b0 1)) (Row w (Mass u (Rat 2 9)) (Mass v (Rat 2 9)) (Mass b0 (Rat 5 9))) (Row b0 (Mass v (Rat 1 2)) (Mass b0 (Rat 1 2))))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R116 (MinimizeForQueries Chain))
!(dc.run R116 (TracePartition Chain))
!(dc.run R116 (MinimalLinear Chain))
!(dc.run R116 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R116 (MeasureBehavioral Merge (Horizon (Steps 2))))
!(dc.run R116 (CheckTrace Merge))
