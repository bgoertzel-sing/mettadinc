(DC.Module R164
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 4)) (Mass v (Rat 3 4))) (Row y (Mass w 1)) (Row u (Mass v 1)) (Row v (Mass b0 (Rat 1 3)) (Mass u (Rat 1 3)) (Mass v (Rat 1 3))) (Row w (Mass v (Rat 1 2)) (Mass b0 (Rat 1 4)) (Mass u (Rat 1 4))) (Row b0 (Mass y 0) (Mass w 1) (Mass v 0)))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass u 1)) (Row v (Mass v (Rat 3 4)) (Mass u (Rat 1 4)) (Mass b0 0)) (Row w (Mass u (Rat 7 16)) (Mass v (Rat 9 16)) (Mass b0 0)) (Row b0 (Mass b0 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R164 (MinimizeForQueries Chain))
!(dc.run R164 (TracePartition Chain))
!(dc.run R164 (MinimalLinear Chain))
!(dc.run R164 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R164 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R164 (CheckTrace Merge))
