(DC.Module R184
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass v 1) (Mass b0 0)) (Row v (Mass b0 (Rat 1 2)) (Mass u (Rat 1 2))) (Row w (Mass v (Rat 2 3)) (Mass b0 (Rat 1 6)) (Mass u (Rat 1 6))) (Row b0 (Mass b0 (Rat 1 3)) (Mass y (Rat 1 3)) (Mass w (Rat 1 3))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b0 0) (Mass u 1)) (Row v (Mass u (Rat 1 3)) (Mass v (Rat 1 3)) (Mass b0 (Rat 1 3))) (Row w (Mass b0 (Rat 1 9)) (Mass u (Rat 7 9)) (Mass v (Rat 1 9))) (Row b0 (Mass b0 1) (Mass u 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R184 (MinimizeForQueries Chain))
!(dc.run R184 (TracePartition Chain))
!(dc.run R184 (MinimalLinear Chain))
!(dc.run R184 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R184 (MeasureBehavioral Merge (Horizon (Steps 3))))
!(dc.run R184 (CheckTrace Merge))
