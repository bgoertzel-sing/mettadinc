(DC.Module R199
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 0) (b1 0)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass v (Rat 1 6)) (Mass b0 (Rat 5 6))) (Row v (Mass u 1)) (Row w (Mass v (Rat 1 18)) (Mass b0 (Rat 5 18)) (Mass u (Rat 2 3))) (Row b0 (Mass u 1) (Mass v 0)) (Row b1 (Mass y 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R199 (MinimizeForQueries Chain))
!(dc.run R199 (TracePartition Chain))
!(dc.run R199 (MinimalLinear Chain))
!(dc.run R199 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R199 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R199 (CheckTrace Merge))
