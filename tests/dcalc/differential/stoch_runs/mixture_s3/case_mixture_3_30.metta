(DC.Module R30
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 1) (b1 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 4)) (Mass v (Rat 3 4))) (Row y (Mass w 1)) (Row u (Mass b1 (Rat 1 2)) (Mass b0 (Rat 1 2))) (Row v (Mass u (Rat 3 4)) (Mass b0 (Rat 1 4)) (Mass b1 0)) (Row w (Mass b1 (Rat 1 8)) (Mass b0 (Rat 5 16)) (Mass u (Rat 9 16))) (Row b0 (Mass w 1) (Mass b0 0)) (Row b1 (Mass v (Rat 1 3)) (Mass b0 (Rat 2 3))))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b0 1)) (Row v (Mass b0 (Rat 1 2)) (Mass v (Rat 1 4)) (Mass b1 (Rat 1 4))) (Row w (Mass b0 (Rat 5 8)) (Mass v (Rat 3 16)) (Mass b1 (Rat 3 16))) (Row b0 (Mass b1 (Rat 1 2)) (Mass w (Rat 1 2))) (Row b1 (Mass x 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R30 (MinimizeForQueries Chain))
!(dc.run R30 (TracePartition Chain))
!(dc.run R30 (MinimalLinear Chain))
!(dc.run R30 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R30 (MeasureBehavioral Merge (Horizon (Steps 3))))
!(dc.run R30 (CheckTrace Merge))
