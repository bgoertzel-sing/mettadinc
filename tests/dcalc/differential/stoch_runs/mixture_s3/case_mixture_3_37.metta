(DC.Module R37
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 1) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 4)) (Mass v (Rat 3 4))) (Row y (Mass w 1)) (Row u (Mass b1 0) (Mass u (Rat 1 2)) (Mass b0 (Rat 1 2))) (Row v (Mass v (Rat 1 3)) (Mass b1 (Rat 1 3)) (Mass u (Rat 1 3))) (Row w (Mass b1 (Rat 1 4)) (Mass u (Rat 3 8)) (Mass b0 (Rat 1 8)) (Mass v (Rat 1 4))) (Row b0 (Mass x 1)) (Row b1 (Mass y (Rat 1 2)) (Mass x (Rat 1 2)) (Mass b0 0)))
  (TransitionKernel Kb (From S) (To S) (Row x (Mass x 1)) (Row y (Mass y 1)) (Row u (Mass b0 1) (Mass u 0) (Mass b1 0) (Mass v 0)) (Row v (Mass b0 1)) (Row w (Mass b0 1) (Mass u 0) (Mass b1 0) (Mass v 0)) (Row b0 (Mass b1 1)) (Row b1 (Mass b0 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R37 (MinimizeForQueries Chain))
!(dc.run R37 (TracePartition Chain))
!(dc.run R37 (MinimalLinear Chain))
!(dc.run R37 (MeasureBehavioral Merge (Discount (Rat 2 3))))
!(dc.run R37 (MeasureBehavioral Merge (Horizon (Steps 2))))
!(dc.run R37 (CheckTrace Merge))
