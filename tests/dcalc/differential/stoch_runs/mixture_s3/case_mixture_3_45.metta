(DC.Module R45
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 1) (b1 2)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 2)) (Mass v (Rat 1 2))) (Row y (Mass w 1)) (Row u (Mass b0 (Rat 1 3)) (Mass b1 (Rat 1 3)) (Mass v (Rat 1 3))) (Row v (Mass u 1) (Mass v 0)) (Row w (Mass b0 (Rat 1 6)) (Mass b1 (Rat 1 6)) (Mass v (Rat 1 6)) (Mass u (Rat 1 2))) (Row b0 (Mass w (Rat 1 2)) (Mass y (Rat 1 2))) (Row b1 (Mass v 1) (Mass b1 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R45 (MinimizeForQueries Chain))
!(dc.run R45 (TracePartition Chain))
!(dc.run R45 (MinimalLinear Chain))
!(dc.run R45 (MeasureBehavioral Merge (Discount (Rat 1 2))))
!(dc.run R45 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R45 (CheckTrace Merge))
