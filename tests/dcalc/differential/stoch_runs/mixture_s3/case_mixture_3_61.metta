(DC.Module R61
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0 b1))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 0) (y 0) (u 0) (v 0) (w 0) (b0 0) (b1 1)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 1 3)) (Mass v (Rat 2 3))) (Row y (Mass w 1)) (Row u (Mass b1 (Rat 1 3)) (Mass u (Rat 1 3)) (Mass b0 (Rat 1 3))) (Row v (Mass b0 (Rat 1 2)) (Mass v 0) (Mass b1 (Rat 1 2))) (Row w (Mass b1 (Rat 4 9)) (Mass u (Rat 1 9)) (Mass b0 (Rat 4 9)) (Mass v 0)) (Row b0 (Mass v (Rat 1 2)) (Mass b0 (Rat 1 2))) (Row b1 (Mass x 1) (Mass b0 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0) (b1 b1)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R61 (MinimizeForQueries Chain))
!(dc.run R61 (TracePartition Chain))
!(dc.run R61 (MinimalLinear Chain))
!(dc.run R61 (MeasureBehavioral Merge (Discount (Rat 9 10))))
