(DC.Module R90
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum x y u v w b0))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (x 1) (y 1) (u 1) (v 1) (w 1) (b0 0)))
  (TransitionKernel Ka (From S) (To S) (Row x (Mass u (Rat 2 3)) (Mass v (Rat 1 3))) (Row y (Mass w 1)) (Row u (Mass b0 (Rat 1 3)) (Mass u (Rat 1 3)) (Mass v (Rat 1 3))) (Row v (Mass b0 (Rat 1 2)) (Mass u (Rat 1 2)) (Mass v 0)) (Row w (Mass b0 (Rat 7 18)) (Mass u (Rat 7 18)) (Mass v (Rat 2 9))) (Row b0 (Mass u (Rat 1 6)) (Mass v (Rat 5 6)) (Mass y 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (x x) (y x) (u u) (v v) (w w) (b0 b0)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R90 (MinimizeForQueries Chain))
!(dc.run R90 (TracePartition Chain))
!(dc.run R90 (MinimalLinear Chain))
!(dc.run R90 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R90 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R90 (CheckTrace Merge))
