(DC.Module R138
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 0) (s1 1) (s2 1)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s2 (Rat 1 3)) (Mass s1 (Rat 1 3)) (Mass s0 (Rat 1 3))) (Row s1 (Mass s0 1)) (Row s2 (Mass s0 (Rat 2 3)) (Mass s2 (Rat 1 3))))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s2 1)) (Row s1 (Mass s1 1)) (Row s2 (Mass s0 (Rat 1 2)) (Mass s2 (Rat 1 2))))
  (TransitionKernel Kc (From S) (To S) (Row s0 (Mass s1 1)) (Row s1 (Mass s2 0) (Mass s1 1)) (Row s2 (Mass s1 (Rat 1 6)) (Mass s0 (Rat 2 3)) (Mass s2 (Rat 1 6))))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb) (Action c Kc))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s0) (s2 s2)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R138 (MinimizeForQueries Chain))
!(dc.run R138 (TracePartition Chain))
!(dc.run R138 (MinimalLinear Chain))
!(dc.run R138 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R138 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R138 (CheckTrace Merge))
