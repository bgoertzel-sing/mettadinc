(DC.Module R167
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3 s4 s5))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 1) (s1 0) (s2 0) (s3 1) (s4 1) (s5 1)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s1 (Rat 1 3)) (Mass s5 (Rat 1 3)) (Mass s2 (Rat 1 3))) (Row s1 (Mass s5 (Rat 3 4)) (Mass s3 (Rat 1 4)) (Mass s1 0)) (Row s2 (Mass s2 0) (Mass s5 0) (Mass s0 1)) (Row s3 (Mass s2 0) (Mass s0 (Rat 3 4)) (Mass s1 (Rat 1 4))) (Row s4 (Mass s3 0) (Mass s4 1) (Mass s0 0)) (Row s5 (Mass s0 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s5) (s2 s2) (s3 s3) (s4 s4) (s5 s5)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R167 (MinimizeForQueries Chain))
!(dc.run R167 (TracePartition Chain))
!(dc.run R167 (MinimalLinear Chain))
!(dc.run R167 (MeasureBehavioral Merge (Discount (Rat 9 10))))
