(DC.Module R177
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3 s4 s5))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (s0 0) (s1 0) (s2 0) (s3 0) (s4 1) (s5 2)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s5 (Rat 1 2)) (Mass s0 (Rat 1 2)) (Mass s2 0)) (Row s1 (Mass s1 (Rat 1 4)) (Mass s4 (Rat 1 2)) (Mass s0 (Rat 1 4))) (Row s2 (Mass s2 1)) (Row s3 (Mass s5 0) (Mass s0 1)) (Row s4 (Mass s2 1)) (Row s5 (Mass s2 1)))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s2 (Rat 1 2)) (Mass s1 (Rat 1 2))) (Row s1 (Mass s1 1) (Mass s0 0)) (Row s2 (Mass s2 1)) (Row s3 (Mass s5 1) (Mass s0 0)) (Row s4 (Mass s2 0) (Mass s1 1)) (Row s5 (Mass s4 1) (Mass s5 0) (Mass s1 0) (Mass s0 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s1) (s2 s2) (s3 s3) (s4 s3) (s5 s5)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R177 (MinimizeForQueries Chain))
!(dc.run R177 (TracePartition Chain))
!(dc.run R177 (MinimalLinear Chain))
!(dc.run R177 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R177 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R177 (CheckTrace Merge))
