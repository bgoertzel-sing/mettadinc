(DC.Module R36
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3 s4 s5))
  (Carrier Report (Of Nat) (Enum 0 1 2))
  (Map report (From S) (To Report) (Cases (s0 2) (s1 0) (s2 2) (s3 2) (s4 2) (s5 1)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s1 1)) (Row s1 (Mass s2 1) (Mass s1 0)) (Row s2 (Mass s1 0) (Mass s0 1)) (Row s3 (Mass s0 (Rat 2 3)) (Mass s2 (Rat 1 3)) (Mass s1 0)) (Row s4 (Mass s2 1)) (Row s5 (Mass s2 0) (Mass s1 (Rat 1 6)) (Mass s0 (Rat 5 6))))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s1 (Rat 1 2)) (Mass s5 (Rat 1 2)) (Mass s4 0)) (Row s1 (Mass s4 1)) (Row s2 (Mass s2 (Rat 1 2)) (Mass s5 (Rat 1 2))) (Row s3 (Mass s3 (Rat 1 4)) (Mass s2 (Rat 1 4)) (Mass s0 (Rat 1 2)) (Mass s1 0)) (Row s4 (Mass s5 (Rat 1 2)) (Mass s3 (Rat 1 2))) (Row s5 (Mass s3 (Rat 1 2)) (Mass s0 (Rat 1 2)) (Mass s1 0)))
  (TransitionKernel Kc (From S) (To S) (Row s0 (Mass s3 (Rat 1 2)) (Mass s1 (Rat 1 2))) (Row s1 (Mass s3 (Rat 1 2)) (Mass s2 (Rat 1 2))) (Row s2 (Mass s3 1)) (Row s3 (Mass s3 1)) (Row s4 (Mass s4 1)) (Row s5 (Mass s5 1) (Mass s4 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb) (Action c Kc))
  (Map merge (From S) (To S) (Cases (s0 s4) (s1 s1) (s2 s2) (s3 s3) (s4 s4) (s5 s5)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R36 (MinimizeForQueries Chain))
!(dc.run R36 (TracePartition Chain))
!(dc.run R36 (MinimalLinear Chain))
!(dc.run R36 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R36 (MeasureBehavioral Merge (Horizon (Steps 0))))
!(dc.run R36 (CheckTrace Merge))
