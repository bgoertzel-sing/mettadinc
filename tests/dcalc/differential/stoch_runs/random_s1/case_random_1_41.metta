(DC.Module R41
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 1) (s1 0) (s2 1) (s3 1)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s2 0) (Mass s3 1)) (Row s1 (Mass s3 (Rat 1 2)) (Mass s2 (Rat 1 2))) (Row s2 (Mass s3 (Rat 2 3)) (Mass s1 (Rat 1 3))) (Row s3 (Mass s0 (Rat 1 2)) (Mass s1 (Rat 1 2))))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s3 (Rat 1 2)) (Mass s2 (Rat 1 2))) (Row s1 (Mass s0 (Rat 1 4)) (Mass s2 (Rat 1 4)) (Mass s3 (Rat 1 2))) (Row s2 (Mass s3 1) (Mass s0 0)) (Row s3 (Mass s2 (Rat 1 2)) (Mass s0 (Rat 1 2)) (Mass s1 0)))
  (TransitionKernel Kc (From S) (To S) (Row s0 (Mass s2 (Rat 1 3)) (Mass s1 (Rat 1 3)) (Mass s0 (Rat 1 3)) (Mass s3 0)) (Row s1 (Mass s1 1) (Mass s2 0)) (Row s2 (Mass s0 (Rat 1 6)) (Mass s3 (Rat 5 6))) (Row s3 (Mass s2 (Rat 1 2)) (Mass s1 (Rat 1 2)) (Mass s3 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb) (Action c Kc))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s2) (s2 s2) (s3 s3)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R41 (MinimizeForQueries Chain))
!(dc.run R41 (TracePartition Chain))
!(dc.run R41 (MinimalLinear Chain))
!(dc.run R41 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R41 (MeasureBehavioral Merge (Horizon (Steps 4))))
!(dc.run R41 (CheckTrace Merge))
