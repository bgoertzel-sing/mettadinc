(DC.Module R182
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 0) (s1 1) (s2 1) (s3 1)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s0 0) (Mass s3 1)) (Row s1 (Mass s2 1)) (Row s2 (Mass s1 1)) (Row s3 (Mass s1 1)))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s1 (Rat 1 2)) (Mass s2 (Rat 1 2))) (Row s1 (Mass s2 (Rat 2 3)) (Mass s0 (Rat 1 3)) (Mass s3 0)) (Row s2 (Mass s0 (Rat 5 6)) (Mass s1 0) (Mass s3 (Rat 1 6))) (Row s3 (Mass s1 0) (Mass s3 0) (Mass s2 1)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s2) (s2 s2) (s3 s3)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R182 (MinimizeForQueries Chain))
!(dc.run R182 (TracePartition Chain))
!(dc.run R182 (MinimalLinear Chain))
!(dc.run R182 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R182 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R182 (CheckTrace Merge))
