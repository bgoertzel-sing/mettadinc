(DC.Module R19
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3 s4 s5))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 0) (s1 1) (s2 0) (s3 1) (s4 0) (s5 0)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s5 1)) (Row s1 (Mass s1 (Rat 1 2)) (Mass s3 (Rat 1 2))) (Row s2 (Mass s3 (Rat 1 3)) (Mass s2 (Rat 1 3)) (Mass s5 (Rat 1 3))) (Row s3 (Mass s2 0) (Mass s1 1)) (Row s4 (Mass s5 1)) (Row s5 (Mass s3 1) (Mass s1 0)))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s3 1) (Mass s1 0)) (Row s1 (Mass s2 1)) (Row s2 (Mass s2 1)) (Row s3 (Mass s1 (Rat 1 4)) (Mass s4 (Rat 3 4))) (Row s4 (Mass s1 1)) (Row s5 (Mass s4 (Rat 1 2)) (Mass s5 (Rat 1 2)) (Mass s0 0)))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s1) (s2 s1) (s3 s3) (s4 s4) (s5 s5)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R19 (MinimizeForQueries Chain))
!(dc.run R19 (TracePartition Chain))
!(dc.run R19 (MinimalLinear Chain))
!(dc.run R19 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R19 (MeasureBehavioral Merge (Horizon (Steps 0))))
!(dc.run R19 (CheckTrace Merge))
