(DC.Module R192
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3 s4 s5))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 1) (s1 0) (s2 0) (s3 1) (s4 0) (s5 0)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s0 (Rat 1 2)) (Mass s3 (Rat 1 2))) (Row s1 (Mass s1 (Rat 1 2)) (Mass s4 (Rat 1 2))) (Row s2 (Mass s4 (Rat 1 2)) (Mass s0 (Rat 1 2))) (Row s3 (Mass s4 (Rat 1 2)) (Mass s2 (Rat 1 2))) (Row s4 (Mass s2 0) (Mass s0 1) (Mass s1 0)) (Row s5 (Mass s5 (Rat 2 3)) (Mass s0 (Rat 1 3))))
  (Machine Chain (States S) (Observe report report) (Action a Ka))
  (Map merge (From S) (To S) (Cases (s0 s0) (s1 s1) (s2 s2) (s3 s3) (s4 s4) (s5 s2)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R192 (MinimizeForQueries Chain))
!(dc.run R192 (TracePartition Chain))
!(dc.run R192 (MinimalLinear Chain))
!(dc.run R192 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R192 (MeasureBehavioral Merge (Horizon (Steps 1))))
!(dc.run R192 (CheckTrace Merge))
