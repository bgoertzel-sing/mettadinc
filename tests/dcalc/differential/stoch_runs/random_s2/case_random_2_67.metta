(DC.Module R67
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum s0 s1 s2 s3 s4))
  (Carrier Report (Of Nat) (Enum 0 1))
  (Map report (From S) (To Report) (Cases (s0 0) (s1 0) (s2 0) (s3 0) (s4 1)))
  (TransitionKernel Ka (From S) (To S) (Row s0 (Mass s3 (Rat 1 3)) (Mass s0 (Rat 2 3))) (Row s1 (Mass s3 1)) (Row s2 (Mass s0 1) (Mass s4 0)) (Row s3 (Mass s4 1)) (Row s4 (Mass s3 1) (Mass s0 0)))
  (TransitionKernel Kb (From S) (To S) (Row s0 (Mass s1 0) (Mass s0 1)) (Row s1 (Mass s3 0) (Mass s0 (Rat 5 6)) (Mass s4 (Rat 1 6))) (Row s2 (Mass s4 (Rat 1 2)) (Mass s2 (Rat 1 2)) (Mass s3 0)) (Row s3 (Mass s2 1)) (Row s4 (Mass s3 (Rat 1 6)) (Mass s4 (Rat 5 6))))
  (Machine Chain (States S) (Observe report report) (Action a Ka) (Action b Kb))
  (Map merge (From S) (To S) (Cases (s0 s2) (s1 s1) (s2 s2) (s3 s3) (s4 s4)))
  (Representation Merge (Of Chain) (Encode merge)))
!(dc.run R67 (MinimizeForQueries Chain))
!(dc.run R67 (TracePartition Chain))
!(dc.run R67 (MinimalLinear Chain))
!(dc.run R67 (MeasureBehavioral Merge (Discount (Rat 9 10))))
!(dc.run R67 (MeasureBehavioral Merge (Horizon (Steps 2))))
!(dc.run R67 (CheckTrace Merge))
