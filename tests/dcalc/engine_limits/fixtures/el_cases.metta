;; t-2026-11-27-mettadinc-engine-limits-unsupported: engine limits answer Unsupported, real module errors stay InvalidInput.
;; EL_M9: 9 machines, one over the symbolic engine limit of 8: Unsupported naming the limit and the count
(DC.Module EL_M9
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Carrier Word (Of (BitVector 3)) (All))
  (Map read0 (From Word) (To Bit) (Body ($x) (BitAt $x 0)))
  (Map swap01 (From Word) (To Word) (Body ($x) (SwapBits $x 0 1)))
  (Machine M1 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M2 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M3 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M4 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M5 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M6 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M7 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M8 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M9 (States Word) (Observe x0 read0) (Action swap swap01))
  (Derive D (MinimizeForQueries M1))
  )
!(dc.run EL_M9 D)
;; EL_M8: exactly 8 machines, at the limit: must not answer "too many machines"
(DC.Module EL_M8
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Carrier Word (Of (BitVector 3)) (All))
  (Map read0 (From Word) (To Bit) (Body ($x) (BitAt $x 0)))
  (Map swap01 (From Word) (To Word) (Body ($x) (SwapBits $x 0 1)))
  (Machine M1 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M2 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M3 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M4 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M5 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M6 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M7 (States Word) (Observe x0 read0) (Action swap swap01))
  (Machine M8 (States Word) (Observe x0 read0) (Action swap swap01))
  (Derive D (MinimizeForQueries M1))
  )
!(dc.run EL_M8 D)
;; EL_ZQ: (Quot x 0) = (Failed NonPositiveDivisor) (spec l.1858-1860, doc03 B.1): Unsupported naming the failure value
(DC.Module EL_ZQ
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 7))
  (Map m0 (From A0) (To A0) (Body ($x) (Quot $x 0)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run EL_ZQ (CheckNow R))
;; EL_BAD (negative): (Quot 7 2) = 3, an ordinary value outside carrier {7}: a real module error, stays InvalidInput
(DC.Module EL_BAD
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 7))
  (Map m0 (From A0) (To A0) (Body ($x) (Quot $x 2)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run EL_BAD (CheckNow R))
;; EL_CZQ: Cases form, literal pattern, (Quot 7 0) = (Failed NonPositiveDivisor): Unsupported naming the failure value (review 1)
(DC.Module EL_CZQ
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 7))
  (Map m0 (From A0) (To A0) (Cases (7 (Quot 7 0))))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run EL_CZQ (CheckNow R))
;; EL_CZV: Cases form, variable pattern, (Quot $x 0): Unsupported naming the failure value (review 1)
(DC.Module EL_CZV
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 7))
  (Map m0 (From A0) (To A0) (Cases ($x (Quot $x 0))))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run EL_CZV (CheckNow R))
;; EL_CRN: Cases form, Rem by a negative divisor = (Failed NonPositiveDivisor): Unsupported naming the failure value (review 1)
(DC.Module EL_CRN
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 7))
  (Map m0 (From A0) (To A0) (Cases (7 (Rem 7 -2))))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run EL_CRN (CheckNow R))
;; EL_CBAD (negative): Cases form, (Quot 7 2) = 3, an ordinary value outside carrier {7}: a real module error, stays InvalidInput (review 1)
(DC.Module EL_CBAD
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 7))
  (Map m0 (From A0) (To A0) (Cases (7 (Quot 7 2))))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run EL_CBAD (CheckNow R))
