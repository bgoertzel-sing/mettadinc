;; Laws review-1 gate: a map call inside a law term (Coin/Image/Indep/bare case body) is Unsupported, never InvalidInput.
(DC.Module Qcoin
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map pr (From S) (To Bit) (Cases (A 0)))
  (Map inc (From Bit) (To Bit) (Cases (0 1) (1 0)))
  (Map lw (From S) (To (Law Bit)) (Cases (A (Coin (Rat 1 2)))))
  (Map rl (From (Product S Act)) (To (Law Bit)) (Cases ((Tuple A K) (Coin (pr A)))))
  (Measure Pa (On S) (Masses (A 1)))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pa)))
!(dc.run Qcoin (AverageModel M (Under Pa)))

(DC.Module Qimage
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map pr (From S) (To Bit) (Cases (A 0)))
  (Map inc (From Bit) (To Bit) (Cases (0 1) (1 0)))
  (Map lw (From S) (To (Law Bit)) (Cases (A (Coin (Rat 1 2)))))
  (Map rl (From (Product S Act)) (To (Law Bit)) (Cases ((Tuple A K) (Image $b (inc $b) (Coin (Rat 1 4))))))
  (Measure Pa (On S) (Masses (A 1)))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pa)))
!(dc.run Qimage (AverageModel M (Under Pa)))

(DC.Module Qindep
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map pr (From S) (To Bit) (Cases (A 0)))
  (Map inc (From Bit) (To Bit) (Cases (0 1) (1 0)))
  (Map lw (From S) (To (Law Bit)) (Cases (A (Coin (Rat 1 2)))))
  (Map rl (From (Product S Act)) (To (Law Bit)) (Cases ((Tuple A K) (Indep (lw A) (Coin (Rat 1 2))))))
  (Measure Pa (On S) (Masses (A 1)))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pa)))
!(dc.run Qindep (AverageModel M (Under Pa)))

(DC.Module Qbody
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map pr (From S) (To Bit) (Cases (A 0)))
  (Map inc (From Bit) (To Bit) (Cases (0 1) (1 0)))
  (Map lw (From S) (To (Law Bit)) (Cases (A (Coin (Rat 1 2)))))
  (Map rl (From (Product S Act)) (To (Law Bit)) (Cases ((Tuple A K) (lw A))))
  (Measure Pa (On S) (Masses (A 1)))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pa)))
!(dc.run Qbody (AverageModel M (Under Pa)))
