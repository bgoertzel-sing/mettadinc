;; Laws review-1 gates (t-2026-11-27-mettadinc-laws): LawOf of a declared measure (doc03 l.2174,
;; registry Laws entry), Expect over laws with zero-mass outcomes. Hand-checked values in run_laws.py.
(DC.Module LawsR1
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A B C D))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Measure Half (On Bit) (Masses (0 (Rat 1 4)) (1 (Rat 3 4))))
  (Measure Z (On Bit) (Masses (0 0) (1 1)))
  (Map rl (From (Product S Act)) (To (Law Bit))
    (Cases ((Tuple A K) (LawOf Half))
           ((Tuple B K) (Coin (Expect (Coin 0))))
           ((Tuple C K) (Coin (Expect (LawOf Z))))
           ((Tuple D K) (Coin (Expect (Image $b (Mul $b (Rat 1 2)) (Coin 1)))))))
  (Measure Pa (On S) (Masses (A 1) (B 0) (C 0) (D 0)))
  (Measure Pb (On S) (Masses (A 0) (B 1) (C 0) (D 0)))
  (Measure Pc (On S) (Masses (A 0) (B 0) (C 1) (D 0)))
  (Measure Pd (On S) (Masses (A 0) (B 0) (C 0) (D 1)))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pa)))
!(dc.run LawsR1 (AverageModel M (Under Pa)))
!(dc.run LawsR1 (AverageModel M (Under Pb)))
!(dc.run LawsR1 (AverageModel M (Under Pc)))
!(dc.run LawsR1 (AverageModel M (Under Pd)))
(DC.Module Mi
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map rl (From (Product S Act)) (To (Law Bit)) (Cases ((Tuple A K) (Indep (Coin (Rat 1 2)) 3))))
  (Measure Pa (On S) (Masses (A 1)))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pa)))
!(dc.run Mi (AverageModel M (Under Pa)))
