;; Laws exact-value gates (t-2026-11-27-mettadinc-laws). RewardLaw maps built from Point/Coin/Indep/Image/LawOf
;; and computed bodies; AverageModel prints the exact law and mean. Hand-checked values in run_laws.py.
(DC.Module LawsValues
  (Profile Stochastic)
  (Use Decisions)
  (Use Laws)
  (Carrier S (Of Symbol) (Enum A B C D E))
  (Carrier Act (Of Symbol) (Enum K))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map rl (From (Product S Act)) (To (Law Bit))
    (Cases ((Tuple A K) (Image $b (If (Eq $b 1) 0 1) (Coin (Rat 1 3))))
           ((Tuple B K) (Image $t (Mul (GetTuple $t 0) (GetTuple $t 1)) (Indep (Coin (Rat 1 2)) (Coin (Rat 1 3)))))
           ((Tuple C K) (Coin (Div (Add 1 1) 5)))
           ((Tuple D K) (LawOf (Point 1)))
           ((Tuple E K) (Coin (Expect (Image $b (Mul $b (Rat 2 5)) (Coin (Rat 1 2))))))))
  (Measure Pa (On S) (Masses (A 1) (B 0) (C 0) (D 0) (E 0)))
  (Measure Pb (On S) (Masses (A 0) (B 1) (C 0) (D 0) (E 0)))
  (Measure Pc (On S) (Masses (A 0) (B 0) (C 1) (D 0) (E 0)))
  (Measure Pd (On S) (Masses (A 0) (B 0) (C 0) (D 1) (E 0)))
  (Measure Pe (On S) (Masses (A 0) (B 0) (C 0) (D 0) (E 1)))
  (Measure Pu (On S) (Masses (A (Rat 1 5)) (B (Rat 1 5)) (C (Rat 1 5)) (D (Rat 1 5)) (E (Rat 1 5))))
  (DecisionModel M (States S) (Actions Act) (RewardLaw rl) (Prior Pu)))
!(dc.run LawsValues (AverageModel M (Under Pa)))
!(dc.run LawsValues (AverageModel M (Under Pb)))
!(dc.run LawsValues (AverageModel M (Under Pc)))
!(dc.run LawsValues (AverageModel M (Under Pd)))
!(dc.run LawsValues (AverageModel M (Under Pe)))
!(dc.run LawsValues (AverageModel M (Under Pu)))
