;; Review-fixes review 1 F2: exactly 16 representations (the capacity) are admitted; R0 and R15 both work.
(DC.Module ExactlyFull
  (Profile Crisp)
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map id (From Bit) (To Bit) (Table (0 0) (1 1)))
  (Machine M (States Bit) (Observe value id))
  (Representation R0 (Of M) (Encode id))
  (Representation R1 (Of M) (Encode id))
  (Representation R2 (Of M) (Encode id))
  (Representation R3 (Of M) (Encode id))
  (Representation R4 (Of M) (Encode id))
  (Representation R5 (Of M) (Encode id))
  (Representation R6 (Of M) (Encode id))
  (Representation R7 (Of M) (Encode id))
  (Representation R8 (Of M) (Encode id))
  (Representation R9 (Of M) (Encode id))
  (Representation R10 (Of M) (Encode id))
  (Representation R11 (Of M) (Encode id))
  (Representation R12 (Of M) (Encode id))
  (Representation R13 (Of M) (Encode id))
  (Representation R14 (Of M) (Encode id))
  (Representation R15 (Of M) (Encode id)))
!(dc.run ExactlyFull (MeasureNow R0))
!(dc.run ExactlyFull (MeasureNow R15))
