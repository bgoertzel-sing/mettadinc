;; Review 4 F4 (spec Definition 3.5): an abstraction map relates machines with
;; the same interface.  Each mismatch below is refused; Same is Checked.
(DC.Module Interfaces
  (Profile Crisp)
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Carrier Tri (Of Nat) (Enum 0 1 2))
  (Map id (From Bit) (To Bit) (Table (0 0) (1 1)))
  (Map wide (From Bit) (To Tri) (Table (0 0) (1 1)))
  (Machine A (States Bit))
  (Machine B (States Bit) (Observe extra id))
  (Machine C (States Bit) (Observe value id))
  (Machine D (States Bit) (Observe value wide))
  (Machine E (States Bit) (Observe value id) (Action stay id))
  (Machine F (States Bit) (Observe value id))
  (AbstractionMap TgtExtraObs (Source A) (Target B) (Map id))
  (AbstractionMap SrcExtraObs (Source C) (Target A) (Map id))
  (AbstractionMap ObsCarrier (Source C) (Target D) (Map id))
  (AbstractionMap TgtExtraAct (Source F) (Target E) (Map id))
  (AbstractionMap SrcExtraAct (Source E) (Target F) (Map id))
  (AbstractionMap Same (Source C) (Target F) (Map id)))
!(dc.run Interfaces (CheckAbstractionMap TgtExtraObs))
!(dc.run Interfaces (CheckAbstractionMap SrcExtraObs))
!(dc.run Interfaces (CheckAbstractionMap ObsCarrier))
!(dc.run Interfaces (CheckAbstractionMap TgtExtraAct))
!(dc.run Interfaces (CheckAbstractionMap SrcExtraAct))
!(dc.run Interfaces (CheckAbstractionMap Same))
