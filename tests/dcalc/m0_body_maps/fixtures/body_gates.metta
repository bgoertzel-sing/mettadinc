;; Gates for t-2026-11-24-mettadinc-m0-body-maps: (Body ($v) expr) maps in Crisp modules (spec 5.1 l.1721, 5.4 l.1856).
;; Each Body module has a twin (suffix C) with the same maps written out as Table / literal Cases; the twin must
;; answer byte-for-byte as the Body module (module name and digest aside).  Answers worked by hand in ../README.md
;; and checked against Ben's reference evaluator (mg_eval.py) by run_m0_body_maps.py.

;; BG1: Body maps between declared carriers, Int arithmetic.  X = {-2 -1 0 1 2}; neg x = -x; sq x = x*x;
;; pron x = x*x + x (-2:2 -1:0 0:0 1:2 2:6); id x = x.
(DC.Module BG1
  (Profile Crisp)
  (Carrier X  (Of Int) (Enum -2 -1 0 1 2))
  (Carrier Sq (Of Int) (Enum 0 1 4))
  (Carrier Q  (Of Int) (Enum 0 2 6))
  (Map neg  (From X) (To X)  (Body ($x) (Mul $x -1)))
  (Map sq   (From X) (To Sq) (Body ($x) (Mul $x $x)))
  (Map pron (From X) (To Q)  (Body ($x) (Add (Mul $x $x) $x)))
  (Map id   (From X) (To X)  (Body ($x) $x))
  (Machine M  (States X) (Observe sq sq) (Action neg neg))
  (Machine MI (States X) (Observe id id) (Action neg neg))
  (Representation RSq (Of M) (Encode sq))
  (Representation RQ  (Of M) (Encode pron))
  (Representation RI  (Of MI) (Encode sq))
  (Derive MMin (MinimizeForQueries M)))
!(dc.run BG1 (CheckNow RSq))
!(dc.run BG1 (CheckUpdates RSq))
!(dc.run BG1 (CheckBehavioral RSq))
!(dc.run BG1 (CheckNow RQ))
!(dc.run BG1 (CheckUpdates RQ))
!(dc.run BG1 (CheckBehavioral RQ))
!(dc.run BG1 (CheckNow RI))
!(dc.run BG1 (CheckBehavioral RI))
!(dc.run BG1 MMin)
(DC.Module BG1C
  (Profile Crisp)
  (Carrier X  (Of Int) (Enum -2 -1 0 1 2))
  (Carrier Sq (Of Int) (Enum 0 1 4))
  (Carrier Q  (Of Int) (Enum 0 2 6))
  (Map neg  (From X) (To X)  (Table (-2 2) (-1 1) (0 0) (1 -1) (2 -2)))
  (Map sq   (From X) (To Sq) (Table (-2 4) (-1 1) (0 0) (1 1) (2 4)))
  (Map pron (From X) (To Q)  (Table (-2 2) (-1 0) (0 0) (1 2) (2 6)))
  (Map id   (From X) (To X)  (Table (-2 -2) (-1 -1) (0 0) (1 1) (2 2)))
  (Machine M  (States X) (Observe sq sq) (Action neg neg))
  (Machine MI (States X) (Observe id id) (Action neg neg))
  (Representation RSq (Of M) (Encode sq))
  (Representation RQ  (Of M) (Encode pron))
  (Representation RI  (Of MI) (Encode sq))
  (Derive MMin (MinimizeForQueries M)))
!(dc.run BG1C (CheckNow RSq))
!(dc.run BG1C (CheckUpdates RSq))
!(dc.run BG1C (CheckBehavioral RSq))
!(dc.run BG1C (CheckNow RQ))
!(dc.run BG1C (CheckUpdates RQ))
!(dc.run BG1C (CheckBehavioral RQ))
!(dc.run BG1C (CheckNow RI))
!(dc.run BG1C (CheckBehavioral RI))
!(dc.run BG1C MMin)

;; BT1: Body maps declared with type forms (the doc04 shapes: lesion is a constant Body, checkpoint-with-reads the
;; identity Body, both (From (Tuple ...)) / (To (Tuple ...))).  All = Atom x Link in order
;; (present old) (present none) (absent old) (absent none).
(DC.Module BT1
  (Profile Crisp)
  (Carrier Atom (Of Symbol) (Enum present absent))
  (Carrier Link (Of Symbol) (Enum old none))
  (Carrier All  (Of (Tuple Symbol Symbol)) (Product Atom Link))
  (Map lesion (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Body ($x) (Tuple absent none)))
  (Map keep   (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Body ($x) $x))
  (Map forget (From (Tuple Symbol Symbol)) (To (Tuple Symbol)) (Body ($x) (Tuple none)))
  (Map wrap   (From All) (To (Tuple (Tuple Symbol Symbol) Symbol)) (Body ($x) (Tuple $x old)))
  (Map live   (From All) (To Link) (Cases ((Tuple $g $l) $l)))
  (Machine Mx (States All) (Observe live live) (Action lesion lesion))
  (Representation RK (Of Mx) (Encode keep))
  (Representation RF (Of Mx) (Encode forget))
  (Representation RW (Of Mx) (Encode wrap)))
!(dc.run BT1 (CheckNow RK))
!(dc.run BT1 (CheckUpdates RK))
!(dc.run BT1 (CheckBehavioral RK))
!(dc.run BT1 (CheckNow RF))
!(dc.run BT1 (CheckUpdates RF))
!(dc.run BT1 (CheckBehavioral RF))
!(dc.run BT1 (CheckNow RW))
!(dc.run BT1 (CheckBehavioral RW))
(DC.Module BT1C
  (Profile Crisp)
  (Carrier Atom (Of Symbol) (Enum present absent))
  (Carrier Link (Of Symbol) (Enum old none))
  (Carrier All  (Of (Tuple Symbol Symbol)) (Product Atom Link))
  (Map lesion (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol))
    (Cases ((Tuple present old) (Tuple absent none)) ((Tuple present none) (Tuple absent none)) ((Tuple absent old) (Tuple absent none)) ((Tuple absent none) (Tuple absent none))))
  (Map keep   (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol))
    (Cases ((Tuple present old) (Tuple present old)) ((Tuple present none) (Tuple present none)) ((Tuple absent old) (Tuple absent old)) ((Tuple absent none) (Tuple absent none))))
  (Map forget (From (Tuple Symbol Symbol)) (To (Tuple Symbol))
    (Cases ((Tuple present old) (Tuple none)) ((Tuple present none) (Tuple none)) ((Tuple absent old) (Tuple none)) ((Tuple absent none) (Tuple none))))
  (Map wrap   (From All) (To (Tuple (Tuple Symbol Symbol) Symbol))
    (Cases ((Tuple present old) (Tuple (Tuple present old) old)) ((Tuple present none) (Tuple (Tuple present none) old)) ((Tuple absent old) (Tuple (Tuple absent old) old)) ((Tuple absent none) (Tuple (Tuple absent none) old))))
  (Map live   (From All) (To Link) (Cases ((Tuple $g $l) $l)))
  (Machine Mx (States All) (Observe live live) (Action lesion lesion))
  (Representation RK (Of Mx) (Encode keep))
  (Representation RF (Of Mx) (Encode forget))
  (Representation RW (Of Mx) (Encode wrap)))
!(dc.run BT1C (CheckNow RK))
!(dc.run BT1C (CheckUpdates RK))
!(dc.run BT1C (CheckBehavioral RK))
!(dc.run BT1C (CheckNow RF))
!(dc.run BT1C (CheckUpdates RF))
!(dc.run BT1C (CheckBehavioral RF))
!(dc.run BT1C (CheckNow RW))
!(dc.run BT1C (CheckBehavioral RW))

;; BT2: type-form To on a declared From carrier (tabulated at declaration, spec 5.1/5.3 as for Cases): the same
;; arithmetic as BG1, with codes and observations as one-element tuples.  Unlike BT1 the values depend on the input
;; non-symmetrically, so a lowering that bound $x to the wrong element would answer differently.
(DC.Module BT2
  (Profile Crisp)
  (Carrier X (Of Int) (Enum -2 -1 0 1 2))
  (Map neg   (From X) (To X) (Body ($x) (Mul $x -1)))
  (Map sqt   (From X) (To (Tuple Int)) (Body ($x) (Tuple (Mul $x $x))))
  (Map pront (From X) (To (Tuple Int)) (Body ($x) (Tuple (Add (Mul $x $x) $x))))
  (Machine M (States X) (Observe sq sqt) (Action neg neg))
  (Representation RQ (Of M) (Encode pront)))
!(dc.run BT2 (CheckNow RQ))
!(dc.run BT2 (CheckUpdates RQ))
!(dc.run BT2 (CheckBehavioral RQ))
(DC.Module BT2C
  (Profile Crisp)
  (Carrier X (Of Int) (Enum -2 -1 0 1 2))
  (Map neg   (From X) (To X) (Table (-2 2) (-1 1) (0 0) (1 -1) (2 -2)))
  (Map sqt   (From X) (To (Tuple Int)) (Cases (-2 (Tuple 4)) (-1 (Tuple 1)) (0 (Tuple 0)) (1 (Tuple 1)) (2 (Tuple 4))))
  (Map pront (From X) (To (Tuple Int)) (Cases (-2 (Tuple 2)) (-1 (Tuple 0)) (0 (Tuple 0)) (1 (Tuple 2)) (2 (Tuple 6))))
  (Machine M (States X) (Observe sq sqt) (Action neg neg))
  (Representation RQ (Of M) (Encode pront)))
!(dc.run BT2C (CheckNow RQ))
!(dc.run BT2C (CheckUpdates RQ))
!(dc.run BT2C (CheckBehavioral RQ))

;; BB1: a Body map as a (To Bool) Observe port (the bool-observe lowering reaches the same Body code); the twin uses Cases.
(DC.Module BB1
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Map yes  (From A) (To Bool) (Body ($a) True))
  (Map swap (From A) (To A) (Cases (p q) (q p)))
  (Map one  (From A) (To A) (Body ($a) p))
  (Machine M (States A) (Observe yes yes) (Action swap swap))
  (Representation R (Of M) (Encode one)))
!(dc.run BB1 (CheckNow R))
!(dc.run BB1 (CheckBehavioral R))
(DC.Module BB1C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Map yes  (From A) (To Bool) (Cases (p True) (q True)))
  (Map swap (From A) (To A) (Cases (p q) (q p)))
  (Map one  (From A) (To A) (Cases (p p) (q p)))
  (Machine M (States A) (Observe yes yes) (Action swap swap))
  (Representation R (Of M) (Encode one)))
!(dc.run BB1C (CheckNow R))
!(dc.run BB1C (CheckBehavioral R))
