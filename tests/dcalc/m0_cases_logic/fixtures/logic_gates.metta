;; Gates for t-2026-11-23-mettadinc-m0-cases-logic: If/Eq/And/Or/Not in Crisp Cases bodies.
;; Every module LGn has a twin LGnC with the same maps written as literal Cases rows (no logic operator).
;; The gate requires LGn and LGnC to answer identically (module name and digest masked), and every status and
;; witness to equal Ben's reference evaluator (docs/e0 mg_eval + dclib, via ../m0_typeform_maps/reference_answers.py).
;; Hand derivations: ../README.md.
;; LG1: If/Eq/Or on a symbol carrier.
(DC.Module LG1
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map isa (From S) (To O) (Cases ($s (If (Eq $s a) yes no))))
  (Map step (From S) (To S) (Cases ($s (If (Eq $s a) b (If (Eq $s b) c a)))))
  (Map code (From S) (To O) (Cases ($s (If (Or (Eq $s a) (Eq $s c)) yes no))))
  (Machine M (States S) (Observe isa isa) (Action step step))
  (Representation R (Of M) (Encode code))
  (Representation RI (Of M) (Encode step)))
!(dc.run LG1 (CheckNow R))
!(dc.run LG1 (CheckUpdates R))
!(dc.run LG1 (CheckNow RI))
(DC.Module LG1C
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map isa (From S) (To O) (Cases (a yes) (b no) (c no)))
  (Map step (From S) (To S) (Cases (a b) (b c) (c a)))
  (Map code (From S) (To O) (Cases (a yes) (b no) (c yes)))
  (Machine M (States S) (Observe isa isa) (Action step step))
  (Representation R (Of M) (Encode code))
  (Representation RI (Of M) (Encode step)))
!(dc.run LG1C (CheckNow R))
!(dc.run LG1C (CheckUpdates R))
!(dc.run LG1C (CheckNow RI))
;; LG2: three-operand And/Or, Not, a Subset predicate, a Bool Observe port and Bool components of a type-form code.
(DC.Module LG2
  (Profile Crisp)
  (Carrier X (Of Symbol) (Enum p q))
  (Carrier XXX (Of (Tuple Symbol Symbol Symbol)) (Product X X X))
  (Map notall (From (Tuple Symbol Symbol Symbol)) (To Bool) (Cases ((Tuple $x $y $z) (Not (And (Eq $x p) (Eq $y p) (Eq $z p))))))
  (Carrier St (Of (Tuple Symbol Symbol Symbol)) (Subset XXX notall))
  (Map maj (From St) (To Bool) (Cases ((Tuple $x $y $z) (Or (And (Eq $x p) (Eq $y p)) (And (Eq $x p) (Eq $z p)) (And (Eq $y p) (Eq $z p))))))
  (Map rot (From St) (To St) (Cases ((Tuple $x $y $z) (Tuple $y $z $x))))
  (Map setq (From St) (To St) (Cases ((Tuple $x $y $z) (Tuple q $y $z))))
  (Map code (From St) (To (Tuple Bool Bool)) (Cases ((Tuple $x $y $z) (Tuple (Eq $x $y) (Eq $y $z)))))
  (Map code3 (From St) (To (Tuple Bool Symbol)) (Cases ((Tuple $x $y $z) (Tuple (Or (And (Eq $x p) (Eq $y p)) (And (Eq $x p) (Eq $z p)) (And (Eq $y p) (Eq $z p))) $x))))
  (Map idc (From St) (To (Tuple Symbol Symbol Symbol)) (Cases ((Tuple $x $y $z) (Tuple $x $y $z))))
  (Machine M (States St) (Observe maj maj) (Action rot rot) (Action setq setq))
  (Representation R (Of M) (Encode code))
  (Representation R3 (Of M) (Encode code3))
  (Representation RI (Of M) (Encode idc)))
!(dc.run LG2 (CheckNow R))
!(dc.run LG2 (CheckUpdates R))
!(dc.run LG2 (CheckNow R3))
!(dc.run LG2 (CheckUpdates R3))
!(dc.run LG2 (CheckNow RI))
!(dc.run LG2 (CheckUpdates RI))
(DC.Module LG2C
  (Profile Crisp)
  (Carrier X (Of Symbol) (Enum p q))
  (Carrier XXX (Of (Tuple Symbol Symbol Symbol)) (Product X X X))
  (Map notall (From (Tuple Symbol Symbol Symbol)) (To Bool) (Cases ((Tuple p p p) False) ((Tuple p p q) True) ((Tuple p q p) True) ((Tuple p q q) True) ((Tuple q p p) True) ((Tuple q p q) True) ((Tuple q q p) True) ((Tuple q q q) True)))
  (Carrier St (Of (Tuple Symbol Symbol Symbol)) (Subset XXX notall))
  (Map maj (From St) (To Bool) (Cases ((Tuple p p q) True) ((Tuple p q p) True) ((Tuple p q q) False) ((Tuple q p p) True) ((Tuple q p q) False) ((Tuple q q p) False) ((Tuple q q q) False)))
  (Map rot (From St) (To St) (Cases ((Tuple p p q) (Tuple p q p)) ((Tuple p q p) (Tuple q p p)) ((Tuple p q q) (Tuple q q p)) ((Tuple q p p) (Tuple p p q)) ((Tuple q p q) (Tuple p q q)) ((Tuple q q p) (Tuple q p q)) ((Tuple q q q) (Tuple q q q))))
  (Map setq (From St) (To St) (Cases ((Tuple p p q) (Tuple q p q)) ((Tuple p q p) (Tuple q q p)) ((Tuple p q q) (Tuple q q q)) ((Tuple q p p) (Tuple q p p)) ((Tuple q p q) (Tuple q p q)) ((Tuple q q p) (Tuple q q p)) ((Tuple q q q) (Tuple q q q))))
  (Map code (From St) (To (Tuple Bool Bool)) (Cases ((Tuple p p q) (Tuple True False)) ((Tuple p q p) (Tuple False False)) ((Tuple p q q) (Tuple False True)) ((Tuple q p p) (Tuple False True)) ((Tuple q p q) (Tuple False False)) ((Tuple q q p) (Tuple True False)) ((Tuple q q q) (Tuple True True))))
  (Map code3 (From St) (To (Tuple Bool Symbol)) (Cases ((Tuple p p q) (Tuple True p)) ((Tuple p q p) (Tuple True p)) ((Tuple p q q) (Tuple False p)) ((Tuple q p p) (Tuple True q)) ((Tuple q p q) (Tuple False q)) ((Tuple q q p) (Tuple False q)) ((Tuple q q q) (Tuple False q))))
  (Map idc (From St) (To (Tuple Symbol Symbol Symbol)) (Cases ((Tuple p p q) (Tuple p p q)) ((Tuple p q p) (Tuple p q p)) ((Tuple p q q) (Tuple p q q)) ((Tuple q p p) (Tuple q p p)) ((Tuple q p q) (Tuple q p q)) ((Tuple q q p) (Tuple q q p)) ((Tuple q q q) (Tuple q q q))))
  (Machine M (States St) (Observe maj maj) (Action rot rot) (Action setq setq))
  (Representation R (Of M) (Encode code))
  (Representation R3 (Of M) (Encode code3))
  (Representation RI (Of M) (Encode idc)))
!(dc.run LG2C (CheckNow R))
!(dc.run LG2C (CheckUpdates R))
!(dc.run LG2C (CheckNow R3))
!(dc.run LG2C (CheckUpdates R3))
!(dc.run LG2C (CheckNow RI))
!(dc.run LG2C (CheckUpdates RI))
;; LG3: If and Eq on Nat literals, with Add inside a branch.
(DC.Module LG3
  (Profile Crisp)
  (Carrier N (Of Nat) (Enum 0 1 2 3))
  (Carrier B (Of Nat) (Enum 0 1))
  (Map step (From N) (To N) (Cases ($n (If (Eq $n 3) 0 (Add $n 1)))))
  (Map zero (From N) (To B) (Cases ($n (If (Eq $n 0) 1 0))))
  (Map par (From N) (To B) (Cases ($n (If (Or (Eq $n 0) (Eq $n 2)) 0 1))))
  (Map idn (From N) (To N) (Cases ($n (If (Eq $n 3) 3 $n))))
  (Machine M (States N) (Observe zero zero) (Action step step))
  (Representation R (Of M) (Encode par))
  (Representation RI (Of M) (Encode idn)))
!(dc.run LG3 (CheckNow R))
!(dc.run LG3 (CheckUpdates R))
!(dc.run LG3 (CheckNow RI))
(DC.Module LG3C
  (Profile Crisp)
  (Carrier N (Of Nat) (Enum 0 1 2 3))
  (Carrier B (Of Nat) (Enum 0 1))
  (Map step (From N) (To N) (Cases (0 1) (1 2) (2 3) (3 0)))
  (Map zero (From N) (To B) (Cases (0 1) (1 0) (2 0) (3 0)))
  (Map par (From N) (To B) (Cases (0 0) (1 1) (2 0) (3 1)))
  (Map idn (From N) (To N) (Cases (0 0) (1 1) (2 2) (3 3)))
  (Machine M (States N) (Observe zero zero) (Action step step))
  (Representation R (Of M) (Encode par))
  (Representation RI (Of M) (Encode idn)))
!(dc.run LG3C (CheckNow R))
!(dc.run LG3C (CheckUpdates R))
!(dc.run LG3C (CheckNow RI))
;; LG4: If/Eq in the observation of an AbstractionMap's Source (was typeform_unsupported UE before this lowering).
(DC.Module LG4
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map pick (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (If (Eq $a p) (Tuple $a $b) (Tuple $b $a)))))
  (Machine S (States AA) (Observe id pick) (Action id id))
  (Machine T (States AA) (Observe id id) (Action id id))
  (AbstractionMap H (Source S) (Target T) (Map id)))
!(dc.run LG4 (CheckAbstractionMap H))
(DC.Module LG4C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map pick (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple p p) (Tuple p p)) ((Tuple p q) (Tuple p q)) ((Tuple q p) (Tuple p q)) ((Tuple q q) (Tuple q q))))
  (Machine S (States AA) (Observe id pick) (Action id id))
  (Machine T (States AA) (Observe id id) (Action id id))
  (AbstractionMap H (Source S) (Target T) (Map id)))
!(dc.run LG4C (CheckAbstractionMap H))
;; LG5: Eq as a Bool Observe port (was bool_observe_gates BU2 before this lowering).
(DC.Module LG5
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q r s t))
  (Carrier K (Of Symbol) (Enum k1 k2 k3))
  (Map live (From A) (To Bool) (Cases ($a (Eq $a q))))
  (Map step (From A) (To A) (Cases (p q) (q p) (r s) (s r) (t t)))
  (Map e1 (From A) (To K) (Cases (p k1) (q k2) (r k1) (s k2) (t k3)))
  (Machine M (States A) (Observe live live) (Action step step))
  (Representation R1 (Of M) (Encode e1)))
!(dc.run LG5 (CheckNow R1))
(DC.Module LG5C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q r s t))
  (Carrier K (Of Symbol) (Enum k1 k2 k3))
  (Map live (From A) (To Bool) (Cases (p False) (q True) (r False) (s False) (t False)))
  (Map step (From A) (To A) (Cases (p q) (q p) (r s) (s r) (t t)))
  (Map e1 (From A) (To K) (Cases (p k1) (q k2) (r k1) (s k2) (t k3)))
  (Machine M (States A) (Observe live live) (Action step step))
  (Representation R1 (Of M) (Encode e1)))
!(dc.run LG5C (CheckNow R1))
;; LG6: If/Eq in a type-form Action (was typeform_unsupported UB before this lowering), with a non-injective code.
(DC.Module LG6
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map pick (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (If (Eq $a p) (Tuple $a $b) (Tuple $b $a)))))
  (Map fst (From (Tuple Symbol Symbol)) (To (Tuple Symbol)) (Cases ((Tuple $a $b) (Tuple $a))))
  (Machine M (States AA) (Observe id id) (Action pick pick))
  (Machine MF (States AA) (Observe fst fst) (Action pick pick))
  (Representation R (Of M) (Encode id))
  (Representation RF (Of MF) (Encode fst)))
!(dc.run LG6 (CheckNow R))
!(dc.run LG6 (CheckUpdates RF))
(DC.Module LG6C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map pick (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple p p) (Tuple p p)) ((Tuple p q) (Tuple p q)) ((Tuple q p) (Tuple p q)) ((Tuple q q) (Tuple q q))))
  (Map fst (From (Tuple Symbol Symbol)) (To (Tuple Symbol)) (Cases ((Tuple $a $b) (Tuple $a))))
  (Machine M (States AA) (Observe id id) (Action pick pick))
  (Machine MF (States AA) (Observe fst fst) (Action pick pick))
  (Representation R (Of M) (Encode id))
  (Representation RF (Of MF) (Encode fst)))
!(dc.run LG6C (CheckNow R))
!(dc.run LG6C (CheckUpdates RF))
;; LG7: Eq compares integer literals by value inside Tuples too (review 1 F2): (Tuple 1) and (Tuple 01) are the same value.
(DC.Module LG7
  (Profile Crisp)
  (Carrier N (Of Nat) (Enum 0 1 2))
  (Carrier O (Of Symbol) (Enum yes no))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map id (From N) (To N) (Cases ($n $n)))
  (Map ob (From N) (To O) (Cases ($n (If (Eq (Tuple $n) (Tuple 01)) yes no))))
  (Map e (From N) (To K) (Cases (0 k1) (1 k1) (2 k2)))
  (Machine M (States N) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode e)))
!(dc.run LG7 (CheckNow R))
(DC.Module LG7C
  (Profile Crisp)
  (Carrier N (Of Nat) (Enum 0 1 2))
  (Carrier O (Of Symbol) (Enum yes no))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map id (From N) (To N) (Cases ($n $n)))
  (Map ob (From N) (To O) (Cases (0 no) (1 yes) (2 no)))
  (Map e (From N) (To K) (Cases (0 k1) (1 k1) (2 k2)))
  (Machine M (States N) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode e)))
!(dc.run LG7C (CheckNow R))
