;; If/Eq/And/Or/Not forms still outside the M0 fragment: each answers Unsupported, and the reason names the form
;; (t-2026-11-23-mettadinc-m0-cases-logic).  Expected reasons: ../run_m0_cases_logic.py UNS.
;; UA: And with one operand
(DC.Module UA
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases ($s $s)))
  (Map ob (From S) (To O) (Cases ($s (If (And (Eq $s a)) yes no))))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UA (CheckNow R))
;; UB: Or with no operand
(DC.Module UB
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases ($s $s)))
  (Map ob (From S) (To O) (Cases ($s (If (Or) yes no))))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UB (CheckNow R))
;; UC: Eq reading a Const (the lowering does not resolve Const names)
(DC.Module UC
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Const ka S a)
  (Map id (From S) (To S) (Cases ($s $s)))
  (Map ob (From S) (To O) (Cases ($s (If (Eq $s ka) yes no))))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UC (CheckNow R))
;; UD: If/Eq in a Graded module (lowered only in Crisp)
(DC.Module UD
  (Profile Graded)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases ($s $s)))
  (Map ob (From S) (To O) (Cases ($s (If (Eq $s a) yes no))))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UD (CheckNow R))
;; UE: control, an operator that stays outside (Sub), inside an If branch that is taken
(DC.Module UE
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases ($s $s)))
  (Map ob (From S) (To O) (Cases ($s (If (Eq $s a) (Sub 1 1) no))))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UE (CheckNow R))
;; UF: a Const read nested in a Tuple inside Eq (review 1 F1: was read as the literal symbol ka, giving Checked where the
;; spec meaning, ka = a, gives Refuted (Pair a b) (Observe ob))
(DC.Module UF
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Const ka S a)
  (Map id (From S) (To S) (Cases ($s $s)))
  (Map ob (From S) (To O) (Cases ($s (If (Eq (Tuple $s ka) (Tuple a a)) yes no))))
  (Map e (From S) (To O) (Cases ($s yes)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode e)))
!(dc.run UF (CheckNow R))
;; UG: a Const read nested in a Tuple inside Not/Eq in a Subset predicate (review 1 F1: kept all four states where the
;; spec meaning keeps two)
(DC.Module UG
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q r s))
  (Const kp A p)
  (Map keep (From A) (To Bool) (Cases ($a (Not (Eq (Tuple $a) (Tuple kp))))))
  (Carrier T (Of Symbol) (Subset A keep))
  (Map id (From T) (To T) (Cases ($s $s)))
  (Machine M (States T) (Observe id id) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UG (CheckNow R))
;; UH: a Const read nested in an Add inside Eq
(DC.Module UH
  (Profile Crisp)
  (Carrier N (Of Nat) (Enum 0 1 2))
  (Carrier O (Of Symbol) (Enum yes no))
  (Const kn N 1)
  (Map id (From N) (To N) (Cases ($n $n)))
  (Map ob (From N) (To O) (Cases ($n (If (Eq (Add $n kn) 2) yes no))))
  (Machine M (States N) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run UH (CheckNow R))
