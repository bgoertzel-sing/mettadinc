;; t-2026-11-24-mettadinc-m0-gap-g: (To Bool) Observe maps declared with a type-form From (repro g).
;; Every module GGn has a twin GGnC that differs only in the From of its Bool Observe maps, which names the
;; declared state carrier instead of the type form; the twin is lowered by the bool-observe lowering of
;; t-2026-11-23-mettadinc-m0-bool-observe.  The answers worked by hand are in ../README.md.
;; GG1: Bool Observe map from Cases with logic forms, on a Product carrier; Encode codes of two kinds.
(DC.Module GG1
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier YN (Of Symbol) (Enum y n))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From AA) (To AA) (Cases ($x $x)))
  (Map swap (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map fst (From AA) (To A) (Cases ((Tuple $a $b) $a)))
  (Map eqc (From AA) (To YN) (Cases ((Tuple $a $b) (If (Eq $a $b) y n))))
  (Map same (From (Tuple Symbol Symbol)) (To Bool) (Cases ((Tuple $a $b) (Eq $a $b))))
  (Machine M (States AA) (Observe same same) (Action swap swap))
  (Representation RF (Of M) (Encode fst))
  (Representation RE (Of M) (Encode eqc))
  (Representation RI (Of M) (Encode id)))
!(dc.run GG1 (CheckNow RF))
!(dc.run GG1 (CheckUpdates RF))
!(dc.run GG1 (CheckNow RE))
!(dc.run GG1 (CheckUpdates RE))
!(dc.run GG1 (CheckNow RI))
(DC.Module GG1C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier YN (Of Symbol) (Enum y n))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From AA) (To AA) (Cases ($x $x)))
  (Map swap (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map fst (From AA) (To A) (Cases ((Tuple $a $b) $a)))
  (Map eqc (From AA) (To YN) (Cases ((Tuple $a $b) (If (Eq $a $b) y n))))
  (Map same (From AA) (To Bool) (Cases ((Tuple $a $b) (Eq $a $b))))
  (Machine M (States AA) (Observe same same) (Action swap swap))
  (Representation RF (Of M) (Encode fst))
  (Representation RE (Of M) (Encode eqc))
  (Representation RI (Of M) (Encode id)))
!(dc.run GG1C (CheckNow RF))
!(dc.run GG1C (CheckUpdates RF))
!(dc.run GG1C (CheckNow RE))
!(dc.run GG1C (CheckUpdates RE))
!(dc.run GG1C (CheckNow RI))
;; GG2: one type-form Bool map used on a Subset carrier (tabulated on the states where it is used: it has no value
;; on the states outside S), and two Bool maps compared by an AbstractionMap, as in doc04 AnchorMigration.
(DC.Module GG2
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map diag (From AA) (To Bool) (Cases ((Tuple $a $b) (Not (Eq $a $b)))))
  (Carrier S (Of (Tuple Symbol Symbol)) (Subset AA diag))
  (Map flip (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map one (From S) (To A) (Cases ($x p)))
  (Map pfirst (From (Tuple Symbol Symbol)) (To Bool) (Cases ((Tuple p q) True) ((Tuple q p) False)))
  (Map psecond (From (Tuple Symbol Symbol)) (To Bool) (Cases ((Tuple $a $b) (Eq $b p))))
  (Map pq (From (Tuple Symbol Symbol)) (To Bool) (Cases ((Tuple $a $b) (Eq $a p))))
  (Machine M1 (States S) (Observe live pfirst) (Action flip flip))
  (Machine M2 (States S) (Observe live psecond) (Action flip flip))
  (Machine M3 (States S) (Observe live pq) (Action flip flip))
  (Representation R1 (Of M1) (Encode one))
  (Map flip-s (From S) (To S) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map id-s (From S) (To S) (Cases ($x $x)))
  (AbstractionMap H12 (Source M1) (Target M2) (Map flip-s))
  (AbstractionMap H13 (Source M1) (Target M3) (Map flip-s))
  (AbstractionMap H12I (Source M1) (Target M2) (Map id-s))
  (AbstractionMap H13I (Source M1) (Target M3) (Map id-s)))
!(dc.run GG2 (CheckNow R1))
!(dc.run GG2 (CheckUpdates R1))
!(dc.run GG2 (CheckAbstractionMap H12))
!(dc.run GG2 (CheckAbstractionMap H13))
!(dc.run GG2 (CheckAbstractionMap H12I))
!(dc.run GG2 (CheckAbstractionMap H13I))
(DC.Module GG2C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map diag (From AA) (To Bool) (Cases ((Tuple $a $b) (Not (Eq $a $b)))))
  (Carrier S (Of (Tuple Symbol Symbol)) (Subset AA diag))
  (Map flip (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map one (From S) (To A) (Cases ($x p)))
  (Map pfirst (From S) (To Bool) (Cases ((Tuple p q) True) ((Tuple q p) False)))
  (Map psecond (From S) (To Bool) (Cases ((Tuple $a $b) (Eq $b p))))
  (Map pq (From S) (To Bool) (Cases ((Tuple $a $b) (Eq $a p))))
  (Machine M1 (States S) (Observe live pfirst) (Action flip flip))
  (Machine M2 (States S) (Observe live psecond) (Action flip flip))
  (Machine M3 (States S) (Observe live pq) (Action flip flip))
  (Representation R1 (Of M1) (Encode one))
  (Map flip-s (From S) (To S) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map id-s (From S) (To S) (Cases ($x $x)))
  (AbstractionMap H12 (Source M1) (Target M2) (Map flip-s))
  (AbstractionMap H13 (Source M1) (Target M3) (Map flip-s))
  (AbstractionMap H12I (Source M1) (Target M2) (Map id-s))
  (AbstractionMap H13I (Source M1) (Target M3) (Map id-s)))
!(dc.run GG2C (CheckNow R1))
!(dc.run GG2C (CheckUpdates R1))
!(dc.run GG2C (CheckAbstractionMap H12))
!(dc.run GG2C (CheckAbstractionMap H13))
!(dc.run GG2C (CheckAbstractionMap H12I))
!(dc.run GG2C (CheckAbstractionMap H13I))
;; GG3: a Body map (constant True) as the Bool Observe port, with a type-form From.
(DC.Module GG3
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map swap (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map one (From AA) (To A) (Cases ($x p)))
  (Map yes (From (Tuple Symbol Symbol)) (To Bool) (Body ($x) True))
  (Machine M (States AA) (Observe yes yes) (Action swap swap))
  (Representation R (Of M) (Encode one)))
!(dc.run GG3 (CheckNow R))
!(dc.run GG3 (CheckUpdates R))
(DC.Module GG3C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map swap (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map one (From AA) (To A) (Cases ($x p)))
  (Map yes (From AA) (To Bool) (Body ($x) True))
  (Machine M (States AA) (Observe yes yes) (Action swap swap))
  (Representation R (Of M) (Encode one)))
!(dc.run GG3C (CheckNow R))
!(dc.run GG3C (CheckUpdates R))
