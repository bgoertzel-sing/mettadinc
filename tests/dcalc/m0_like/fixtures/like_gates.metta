;; Gates for t-2026-11-23-mettadinc-m0-like-machines: (Machine M (States S) (Like N)) in the Crisp M0 lowering.
;; Hand-worked answers: tests/dcalc/m0_like/README.md.  run_m0_like.py checks every answer, and also against
;; Ben's reference evaluator (docs/e0/.../04_omega_memory_goals_part1/validation_bundle/mg_eval.py + models/dclib.py).
;;
;; Shared base: A = {a b c d}; step swaps a<->b and c<->d; obs: a,c -> o1, b,d -> o2.
;; Live = (Reach Base (From a)) = {a b}.  enc1: a k1, b k2, c k1, d k1.  enc2: a k1, b k1, c k2, d k2.

;; LB: the representations on Base itself (all of A).
(DC.Module LB
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Representation R1 (Of Base) (Encode enc1))
  (Representation R2 (Of Base) (Encode enc2))
)
!(dc.run LB (CheckNow R1))
!(dc.run LB (CheckUpdates R1))
!(dc.run LB (CheckBehavioral R1))
!(dc.run LB (CheckNow R2))
!(dc.run LB (CheckBehavioral R2))

;; LS: Scoped (States Live) (Like Base): the same entries on the scope {a b}.
(DC.Module LS
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine Scoped (States Live) (Like Base))
  (Representation R1 (Of Scoped) (Encode enc1))
  (Representation R2 (Of Scoped) (Encode enc2))
  (Derive ScopedMin (MinimizeForQueries Scoped))
)
!(dc.run LS (CheckNow R1))
!(dc.run LS (CheckUpdates R1))
!(dc.run LS (CheckBehavioral R1))
!(dc.run LS (CheckNow R2))
!(dc.run LS (CheckBehavioral R2))
!(dc.run LS ScopedMin)

;; LW: control, Scoped written out (Observe obs obs) (Action step step): must answer as LS.
(DC.Module LW
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine Scoped (States Live) (Observe obs obs) (Action step step))
  (Representation R1 (Of Scoped) (Encode enc1))
  (Representation R2 (Of Scoped) (Encode enc2))
  (Derive ScopedMin (MinimizeForQueries Scoped))
)
!(dc.run LW (CheckNow R1))
!(dc.run LW (CheckUpdates R1))
!(dc.run LW (CheckBehavioral R1))
!(dc.run LW (CheckNow R2))
!(dc.run LW (CheckBehavioral R2))
!(dc.run LW ScopedMin)

;; LC: a Like of a Like machine on the same scope: answers as LS.
(DC.Module LC
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine Scoped0 (States Live) (Like Base))
  (Machine Scoped (States Live) (Like Scoped0))
  (Representation R1 (Of Scoped) (Encode enc1))
  (Representation R2 (Of Scoped) (Encode enc2))
)
!(dc.run LC (CheckNow R1))
!(dc.run LC (CheckUpdates R1))
!(dc.run LC (CheckBehavioral R1))
!(dc.run LC (CheckNow R2))
!(dc.run LC (CheckBehavioral R2))

;; LA: Like on the full carrier (States A): answers as LB.
(DC.Module LA
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine Copy (States A) (Like Base))
  (Representation R1 (Of Copy) (Encode enc1))
  (Representation R2 (Of Copy) (Encode enc2))
)
!(dc.run LA (CheckNow R1))
!(dc.run LA (CheckUpdates R1))
!(dc.run LA (CheckBehavioral R1))
!(dc.run LA (CheckNow R2))
!(dc.run LA (CheckBehavioral R2))
