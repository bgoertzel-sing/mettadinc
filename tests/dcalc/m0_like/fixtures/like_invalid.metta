;; Malformed uses of Like: every request answers InvalidInput.
(DC.Module LN1
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine M (States Live) (Like Nope))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LN1 (CheckNow R1))

