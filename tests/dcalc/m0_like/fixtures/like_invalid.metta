;; LN5: States is {a c}, not closed under step (a -> b): the copied action leaves the carrier.
(DC.Module LN5
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Map keep (From A) (To Bool) (Cases (a True) (b False) (c True) (d False)))
  (Carrier Sub (Of Symbol) (Subset A keep))
  (Machine M (States Sub) (Like Base))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LN5 (CheckNow R1))

;; LN6: States is an unrelated carrier: the copied maps do not start at it.
(DC.Module LN6
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Carrier B (Of Symbol) (Enum a b))
  (Machine M (States B) (Like Base))
  (Representation R1 (Of M) (Encode encb))
  (Map encb (From B) (To K) (Cases (a k1) (b k2)))
)
!(dc.run LN6 (CheckNow R1))

(DC.Module LN7
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine M (States Live) (Like (Base)))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LN7 (CheckNow R1))
