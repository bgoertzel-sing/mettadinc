;; Uses of Like outside the M0 lowering: Unsupported, the reason names Like.
(DC.Module LU1
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine M (States Live) (Like Base) (Observe obs obs))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LU1 (CheckNow R1))

;; LU2: forward reference (N declared after M).
(DC.Module LU2
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine M (States A) (Like Later))
  (Machine Later (States A) (Observe obs obs) (Action step step))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LU2 (CheckNow R1))

;; LU3: N is itself outside the fragment (an Available field).
(DC.Module LU3
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine N (States A) (Observe obs obs) (Action step step) (Available step step))
  (Machine M (States A) (Like N))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LU3 (CheckNow R1))

;; LU4: a Graded module.
(DC.Module LU4
  (Profile Graded)
  (Carrier A (Of Symbol) (Enum a b c d))
  (Carrier O (Of Symbol) (Enum o1 o2))
  (Carrier K (Of Symbol) (Enum k1 k2))
  (Map step (From A) (To A) (Cases (a b) (b a) (c d) (d c)))
  (Map obs  (From A) (To O) (Cases (a o1) (b o2) (c o1) (d o2)))
  (Map enc1 (From A) (To K) (Cases (a k1) (b k2) (c k1) (d k1)))
  (Map enc2 (From A) (To K) (Cases (a k1) (b k1) (c k2) (d k2)))
  (Machine Base (States A) (Observe obs obs) (Action step step))
  (Carrier Live (Of Symbol) (Reach Base (From a)))
  (Machine M (States A) (Like Base))
  (Representation R1 (Of M) (Encode enc1))
  (Representation R2 (Of M) (Encode enc2))
)
!(dc.run LU4 (CheckNow R1))
