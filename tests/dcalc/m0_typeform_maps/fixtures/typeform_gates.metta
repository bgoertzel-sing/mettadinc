;; Gates for t-2026-11-23-mettadinc-m0-typeform-maps: maps declared with a type form in From/To
;; (spec 5.1 grammar: Map's From/To are registry "expr" fields; 5.2 typed carriers; 5.3 admission
;; by enumeration).  Every type-form module TFn has a twin TFnC written with carrier names only;
;; the gate requires the same Status, Value and Evidence from both (only the module name, digest
;; and the code carrier's name in Target may differ).  The expected answers are worked by hand in
;; ../README.md.

;; ---- TF1: type-form Observe/Action/Encode; the code drops the first component -> CheckNow Refuted
(DC.Module TF1
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier B (Of Symbol) (Enum r s))
  (Carrier AB (Of (Tuple Symbol Symbol)) (Product A B))
  (Map fst  (From (Tuple Symbol Symbol)) (To A) (Cases ((Tuple $a $b) $a)))
  (Map id   (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map keep2 (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $b $b))))
  (Machine M (States AB) (Observe fst fst) (Action id id))
  (Representation R (Of M) (Encode keep2))
  (Representation RI (Of M) (Encode id)))
!(dc.run TF1 (CheckNow R))
!(dc.run TF1 (CheckNow RI))
(DC.Module TF1C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier B (Of Symbol) (Enum r s))
  (Carrier AB (Of (Tuple Symbol Symbol)) (Product A B))
  (Carrier BB (Of (Tuple Symbol Symbol)) (Product B B))
  (Map fst  (From AB) (To A) (Cases ((Tuple $a $b) $a)))
  (Map id   (From AB) (To AB) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map keep2 (From AB) (To BB) (Cases ((Tuple $a $b) (Tuple $b $b))))
  (Machine M (States AB) (Observe fst fst) (Action id id))
  (Representation R (Of M) (Encode keep2))
  (Representation RI (Of M) (Encode id)))
!(dc.run TF1C (CheckNow R))
!(dc.run TF1C (CheckNow RI))

;; ---- TF2: a type-form Action (swap) and a type-form code (first component) -> CheckNow Checked, CheckUpdates Refuted
(DC.Module TF2
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map fst  (From (Tuple Symbol Symbol)) (To A) (Cases ((Tuple $a $b) $a)))
  (Map swap (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map code1 (From (Tuple Symbol Symbol)) (To (Tuple Symbol)) (Cases ((Tuple $a $b) (Tuple $a))))
  (Machine M (States AA) (Observe fst fst) (Action swap swap))
  (Representation R (Of M) (Encode code1)))
!(dc.run TF2 (CheckNow R))
!(dc.run TF2 (CheckUpdates R))
(DC.Module TF2C
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Carrier A1 (Of (Tuple Symbol)) (Product A))
  (Map fst  (From AA) (To A) (Cases ((Tuple $a $b) $a)))
  (Map swap (From AA) (To AA) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Map code1 (From AA) (To A1) (Cases ((Tuple $a $b) (Tuple $a))))
  (Machine M (States AA) (Observe fst fst) (Action swap swap))
  (Representation R (Of M) (Encode code1)))
!(dc.run TF2C (CheckNow R))
!(dc.run TF2C (CheckUpdates R))

;; ---- TF3: doc04 s6.4 AnchorMigration with its Bool observations, If/Eq/And/Or/Not and Body maps
;; written out as Enum observations and literal Cases rows; the type-form maps (From (Tuple Symbol Symbol))
;; are kept, on Subset carriers.  doc04 l.1422/1425: NaiveMigration Refuted, CellMigration Checked.
(DC.Module TF3
  (Profile Crisp)
  (Carrier Atom    (Of Symbol) (Enum present absent))
  (Carrier OldLink (Of Symbol) (Enum old none))
  (Carrier NewLink (Of Symbol) (Enum new old none))
  (Carrier Live    (Of Symbol) (Enum yes no))
  (Map old-consistent (From (Tuple Symbol Symbol)) (To Bool)
    (Cases ((Tuple present old) True) ((Tuple present none) False) ((Tuple absent old) False) ((Tuple absent none) True)))
  (Map new-consistent (From (Tuple Symbol Symbol)) (To Bool)
    (Cases ((Tuple present new) True) ((Tuple present old) True) ((Tuple present none) False)
           ((Tuple absent new) False) ((Tuple absent old) False) ((Tuple absent none) True)))
  (Carrier OldAll   (Of (Tuple Symbol Symbol)) (Product Atom OldLink))
  (Carrier NewAll   (Of (Tuple Symbol Symbol)) (Product Atom NewLink))
  (Carrier OldState (Of (Tuple Symbol Symbol)) (Subset OldAll old-consistent))
  (Carrier NewState (Of (Tuple Symbol Symbol)) (Subset NewAll new-consistent))
  (Map lesion (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $g $l) (Tuple absent none))))
  (Map repair-old (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol))
    (Cases ((Tuple absent $l) (Tuple present old)) ((Tuple present $l) (Tuple present $l))))
  (Map repair-naive (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol))
    (Cases ((Tuple absent $l) (Tuple present old)) ((Tuple present $l) (Tuple present $l))))
  (Map repair-cell (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol))
    (Cases ((Tuple absent $l) (Tuple present new)) ((Tuple present $l) (Tuple present $l))))
  (Map live-old (From (Tuple Symbol Symbol)) (To Live) (Cases ((Tuple $g old) yes) ((Tuple $g none) no)))
  (Map live-new (From (Tuple Symbol Symbol)) (To Live) (Cases ((Tuple $g new) yes) ((Tuple $g old) no) ((Tuple $g none) no)))
  (Machine Before     (States OldState) (Observe live live-old) (Action lesion lesion) (Action repair repair-old))
  (Machine AfterNaive (States NewState) (Observe live live-new) (Action lesion lesion) (Action repair repair-naive))
  (Machine AfterCell  (States NewState) (Observe live live-new) (Action lesion lesion) (Action repair repair-cell))
  (Map rename (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol))
    (Cases ((Tuple $g old) (Tuple $g new)) ((Tuple $g none) (Tuple $g none))))
  (AbstractionMap NaiveMigration (Source Before) (Target AfterNaive) (Map rename))
  (AbstractionMap CellMigration  (Source Before) (Target AfterCell)  (Map rename)))
!(dc.run TF3 (CheckAbstractionMap NaiveMigration))
!(dc.run TF3 (CheckAbstractionMap CellMigration))
(DC.Module TF3C
  (Profile Crisp)
  (Carrier Atom    (Of Symbol) (Enum present absent))
  (Carrier OldLink (Of Symbol) (Enum old none))
  (Carrier NewLink (Of Symbol) (Enum new old none))
  (Carrier Live    (Of Symbol) (Enum yes no))
  (Carrier OldAll   (Of (Tuple Symbol Symbol)) (Product Atom OldLink))
  (Carrier NewAll   (Of (Tuple Symbol Symbol)) (Product Atom NewLink))
  (Map old-consistent (From OldAll) (To Bool)
    (Cases ((Tuple present old) True) ((Tuple present none) False) ((Tuple absent old) False) ((Tuple absent none) True)))
  (Map new-consistent (From NewAll) (To Bool)
    (Cases ((Tuple present new) True) ((Tuple present old) True) ((Tuple present none) False)
           ((Tuple absent new) False) ((Tuple absent old) False) ((Tuple absent none) True)))
  (Carrier OldState (Of (Tuple Symbol Symbol)) (Subset OldAll old-consistent))
  (Carrier NewState (Of (Tuple Symbol Symbol)) (Subset NewAll new-consistent))
  (Map lesion-old (From OldAll) (To OldAll) (Cases ((Tuple $g $l) (Tuple absent none))))
  (Map lesion-new (From NewAll) (To NewAll) (Cases ((Tuple $g $l) (Tuple absent none))))
  (Map repair-old (From OldAll) (To OldAll)
    (Cases ((Tuple absent $l) (Tuple present old)) ((Tuple present $l) (Tuple present $l))))
  (Map repair-naive (From NewAll) (To NewAll)
    (Cases ((Tuple absent $l) (Tuple present old)) ((Tuple present $l) (Tuple present $l))))
  (Map repair-cell (From NewAll) (To NewAll)
    (Cases ((Tuple absent $l) (Tuple present new)) ((Tuple present $l) (Tuple present $l))))
  (Map live-old (From OldAll) (To Live) (Cases ((Tuple $g old) yes) ((Tuple $g none) no)))
  (Map live-new (From NewAll) (To Live) (Cases ((Tuple $g new) yes) ((Tuple $g old) no) ((Tuple $g none) no)))
  (Machine Before     (States OldState) (Observe live live-old) (Action lesion lesion-old) (Action repair repair-old))
  (Machine AfterNaive (States NewState) (Observe live live-new) (Action lesion lesion-new) (Action repair repair-naive))
  (Machine AfterCell  (States NewState) (Observe live live-new) (Action lesion lesion-new) (Action repair repair-cell))
  (Map rename (From OldState) (To NewState)
    (Cases ((Tuple $g old) (Tuple $g new)) ((Tuple $g none) (Tuple $g none))))
  (AbstractionMap NaiveMigration (Source Before) (Target AfterNaive) (Map rename))
  (AbstractionMap CellMigration  (Source Before) (Target AfterCell)  (Map rename)))
!(dc.run TF3C (CheckAbstractionMap NaiveMigration))
!(dc.run TF3C (CheckAbstractionMap CellMigration))

;; ---- TF4: doc04 s7.3 TaskResume shape: type-form To on checkpoint maps (From a carrier) over a Reach carrier.
;; The checkpoint without the result field loses what withdraw needs -> CheckUpdates Refuted; with it -> Checked.
(DC.Module TF4
  (Profile Crisp)
  (Carrier Ev   (Of Symbol) (Enum valid withdrawn))
  (Carrier Res  (Of Symbol) (Enum none r1))
  (Carrier Flag (Of Symbol) (Enum current stale))
  (Carrier Task (Of (Tuple Symbol Symbol Symbol)) (Product Ev Res Flag))
  (Const start Task (Tuple valid none current))
  (Map derive (From Task) (To Task)
    (Cases ((Tuple valid none $f) (Tuple valid r1 current)) ((Tuple valid r1 $f) (Tuple valid r1 $f)) ((Tuple withdrawn $r $f) (Tuple withdrawn $r $f))))
  (Map withdraw (From Task) (To Task)
    (Cases ((Tuple $v none $f) (Tuple withdrawn none $f)) ((Tuple $v r1 $f) (Tuple withdrawn r1 stale))))
  (Map revalidate (From Task) (To Task)
    (Cases ((Tuple $v $r stale) (Tuple $v none current)) ((Tuple $v $r current) (Tuple $v $r current))))
  (Map flag (From Task) (To Flag) (Cases ((Tuple $v $r $f) $f)))
  (Machine Restart (States Task) (Observe flag flag) (Action derive derive) (Action withdraw withdraw) (Action revalidate revalidate))
  (Carrier Live (Of (Tuple Symbol Symbol Symbol)) (Reach Restart (From start)))
  (Machine Resume (States Live) (Observe flag flag) (Action derive derive) (Action withdraw withdraw) (Action revalidate revalidate))
  (Map checkpoint-without-res (From Task) (To (Tuple Symbol Symbol)) (Cases ((Tuple $v $r $f) (Tuple $v $f))))
  (Map checkpoint-with-res (From Task) (To (Tuple Symbol Symbol Symbol)) (Cases ((Tuple $v $r $f) (Tuple $v $r $f))))
  (Representation NoRes   (Of Resume) (Encode checkpoint-without-res))
  (Representation WithRes (Of Resume) (Encode checkpoint-with-res)))
!(dc.run TF4 (CheckNow NoRes))
!(dc.run TF4 (CheckUpdates NoRes))
!(dc.run TF4 (CheckUpdates WithRes))
(DC.Module TF4C
  (Profile Crisp)
  (Carrier Ev   (Of Symbol) (Enum valid withdrawn))
  (Carrier Res  (Of Symbol) (Enum none r1))
  (Carrier Flag (Of Symbol) (Enum current stale))
  (Carrier Task (Of (Tuple Symbol Symbol Symbol)) (Product Ev Res Flag))
  (Carrier EvFlag (Of (Tuple Symbol Symbol)) (Product Ev Flag))
  (Const start Task (Tuple valid none current))
  (Map derive (From Task) (To Task)
    (Cases ((Tuple valid none $f) (Tuple valid r1 current)) ((Tuple valid r1 $f) (Tuple valid r1 $f)) ((Tuple withdrawn $r $f) (Tuple withdrawn $r $f))))
  (Map withdraw (From Task) (To Task)
    (Cases ((Tuple $v none $f) (Tuple withdrawn none $f)) ((Tuple $v r1 $f) (Tuple withdrawn r1 stale))))
  (Map revalidate (From Task) (To Task)
    (Cases ((Tuple $v $r stale) (Tuple $v none current)) ((Tuple $v $r current) (Tuple $v $r current))))
  (Map flag (From Task) (To Flag) (Cases ((Tuple $v $r $f) $f)))
  (Machine Restart (States Task) (Observe flag flag) (Action derive derive) (Action withdraw withdraw) (Action revalidate revalidate))
  (Carrier Live (Of (Tuple Symbol Symbol Symbol)) (Reach Restart (From start)))
  (Machine Resume (States Live) (Observe flag flag) (Action derive derive) (Action withdraw withdraw) (Action revalidate revalidate))
  (Map checkpoint-without-res (From Task) (To EvFlag) (Cases ((Tuple $v $r $f) (Tuple $v $f))))
  (Map checkpoint-with-res (From Task) (To Task) (Cases ((Tuple $v $r $f) (Tuple $v $r $f))))
  (Representation NoRes   (Of Resume) (Encode checkpoint-without-res))
  (Representation WithRes (Of Resume) (Encode checkpoint-with-res)))
!(dc.run TF4C (CheckNow NoRes))
!(dc.run TF4C (CheckUpdates NoRes))
!(dc.run TF4C (CheckUpdates WithRes))
