;; Malformed uses of type-form maps: each module answers InvalidInput (t-2026-11-23-mettadinc-m0-typeform-maps).
;; NA: the From type is not the element type of the carrier where the map is used (spec 5.2: Symbol vs (Tuple Symbol Symbol))
(DC.Module NA
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Map fst (From (Tuple Symbol Symbol)) (To A) (Cases ((Tuple $a $b) $a)))
  (Map id (From A) (To A) (Cases ($a $a)))
  (Machine M (States A) (Observe fst fst) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run NA (CheckNow R))
;; NB: a value that is not of the declared To type ((Tuple p) for (Tuple Symbol Symbol))
(DC.Module NB
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier B (Of Symbol) (Enum r s))
  (Carrier AB (Of (Tuple Symbol Symbol)) (Product A B))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map short (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a))))
  (Machine M (States AB) (Observe short short) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run NB (CheckNow R))
;; NC: a type-form Action whose value leaves the state carrier (spec 5.3: outputs stay in the carrier)
(DC.Module NC
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier B (Of Symbol) (Enum r s))
  (Carrier AB (Of (Tuple Symbol Symbol)) (Product A B))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map swap (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $b $a))))
  (Machine M (States AB) (Observe id id) (Action swap swap))
  (Representation R (Of M) (Encode id)))
!(dc.run NC (CheckNow R))
;; ND: a malformed type form (an empty Tuple)
(DC.Module ND
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Map bad (From (Tuple)) (To A) (Cases ($x p)))
  (Map id (From A) (To A) (Cases ($a $a)))
  (Machine M (States A) (Observe id id) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run ND (CheckNow R))
;; NE: a Cases pattern that no value of the From type can match (three components for a pair type)
(DC.Module NE
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b $c) (Tuple $a $b))))
  (Machine M (States AA) (Observe id id) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run NE (CheckNow R))
;; NF: Cases not total on the carrier where the map is used (no case for first component q)
(DC.Module NF
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map part (From (Tuple Symbol Symbol)) (To A) (Cases ((Tuple p $b) $b)))
  (Machine M (States AA) (Observe part part) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run NF (CheckNow R))
;; NG: a type-form Action whose To type is not the element type of the states
(DC.Module NG
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map first (From (Tuple Symbol Symbol)) (To (Tuple Symbol)) (Cases ((Tuple $a $b) (Tuple $a))))
  (Machine M (States AA) (Observe id id) (Action first first))
  (Representation R (Of M) (Encode id)))
!(dc.run NG (CheckNow R))
;; NH: overlapping Cases rows on the carrier where the map is used
(DC.Module NH
  (Profile Crisp)
  (Carrier A (Of Symbol) (Enum p q))
  (Carrier AA (Of (Tuple Symbol Symbol)) (Product A A))
  (Map id (From (Tuple Symbol Symbol)) (To (Tuple Symbol Symbol)) (Cases ((Tuple $a $b) (Tuple $a $b))))
  (Map pick (From (Tuple Symbol Symbol)) (To A) (Cases ((Tuple p $b) p) ((Tuple $a $b) $a)))
  (Machine M (States AA) (Observe pick pick) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run NH (CheckNow R))
