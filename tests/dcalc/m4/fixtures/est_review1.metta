(DC.Module EstReview1
  (Profile Stochastic)
  (Use Estimates)
  (Stream Replies (Source "../../../../docs/e0/docs/06_wmtm_worked_example/validation_bundle/streams/replies.json")
    (Digest "sha256:1f5d10eff762371dffdef5e0be4f940e39366a8fe2c6b9227bb7cdb66c82ca0f")
    (Population "replies") (Selection "all replies") (Policy "v1")))
!(dc.run EstReview1 (EstimateRate (On Replies) (Column "stale") (Equals 1) (Level (Rat 1 100)) (Estimator Hoeffding)))
!(dc.run EstReview1 (EstimateRate (On Replies) (Column "stale") (Equals 1) (Level (Rat 1 100)) (Estimator ExactBinomial)))
!(dc.run EstReview1 (EstimateRate (On Replies) (Column "stale") (Equals 1) (Level (Rat 1 100)) (Sample 200) (Seed 20261112)))
!(dc.run EstReview1 (EstimateDupRate (On Replies) (Column "day") (Level (Rat 1 100))))
!(dc.run EstReview1 (EstimateDupRate (On Replies) (Column "day") (Level (Rat 1 100)) (Sample 100) (Seed 7)))
!(dc.run EstReview1 (EstimateRate (On Replies) (Column "stale") (Equals 1) (Level (Rat 1 100)) (ReuseUnder "v1")))
