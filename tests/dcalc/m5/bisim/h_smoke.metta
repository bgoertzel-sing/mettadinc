(DC.Module Bis
  (Profile Nondeterministic)
  (Use Simulation)
  (Carrier St (Of Symbol) (Enum P0 P1 P2 P3 Q0 Q1 Q2 Dead))
  (Carrier YN (Of Symbol) (Enum Yes No))
  (Carrier Code (Of Symbol) (Enum K0 K1 K2 K3 K4 K5 K6))
  (Map alive (From St) (To YN) (Cases (P0 Yes) (P1 Yes) (P2 Yes) (P3 Yes) (Q0 Yes) (Q1 Yes) (Q2 Yes) (Dead No)))
  (Map ma (From St) (To St) (Choice (P0 P1) (P1 Dead) (P2 Dead) (P3 Dead) (Q0 Q1 Q2) (Q1 Dead) (Q2 Dead) (Dead Dead)))
  (Map mb (From St) (To St) (Choice (P0 Dead) (P1 P2) (P2 Dead) (P3 Dead) (Q0 Dead) (Q1 P2) (Q2 Dead) (Dead Dead)))
  (Map mc (From St) (To St) (Choice (P0 Dead) (P1 P3) (P2 Dead) (P3 Dead) (Q0 Dead) (Q1 Dead) (Q2 P3) (Dead Dead)))
  (Map enc-bad (From St) (To Code) (Cases (P0 K0) (Q0 K0) (P1 K1) (P2 K2) (P3 K3) (Q1 K4) (Q2 K5) (Dead K6)))
  (Map enc-ok (From St) (To Code) (Cases (P0 K0) (Q0 K1) (P1 K2) (P2 K3) (P3 K3) (Q1 K4) (Q2 K5) (Dead K6)))
  (Machine M (States St) (Observe alive alive) (Action a ma) (Action b mb) (Action c mc) (Bag Set))
  (Representation Bad (Of M) (Encode enc-bad))
  (Representation Ok (Of M) (Encode enc-ok)))
!(dc.run Bis (MeasureBehavioral Bad (Discount (Rat 1 2))))
!(dc.run Bis (MeasureBehavioral Ok (Discount (Rat 1 2))))
!(dc.run Bis (MeasureBehavioral Bad))
!(dc.run Bis (MeasureBehavioral Bad (Discount (Rat 1 2)) (Horizon (Steps 1))))
!(dc.run Bis (MeasureBehavioral Bad (Discount (Rat 1 2)) (Budget (Unrollings 1))))
!(dc.run Bis (CheckBehavioral Bad (Discount (Rat 1 2)) (Within (Rat 1 4))))
!(dc.run Bis (CheckBehavioral Bad (Discount (Rat 1 2)) (Within (Rat 1 8))))
!(dc.run Bis (CheckBehavioral Bad (Within (Rat 1 2))))
