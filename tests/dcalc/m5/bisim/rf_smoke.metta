(DC.Module AccessProtocol
  (Profile Nondeterministic)
  (Use Simulation)
  (Carrier Login (Of Symbol) (Enum S0 S1 S2 Locked Auth Admin))
  (Carrier Stage (Of Symbol) (Enum Start Locked Auth Admin))
  (Map stage-of (From Login) (To Stage)
    (Cases (S0 Start) (S1 Start) (S2 Start) (Locked Locked) (Auth Auth) (Admin Admin)))
  (Map fail (From Login) (To Login)
    (Cases (S0 S1) (S1 S2) (S2 Locked) (Locked Locked) (Auth Auth) (Admin Admin)))
  (Map ok (From Login) (To Login)
    (Cases (S0 Auth) (S1 Auth) (S2 Auth) (Locked Locked) (Auth Auth) (Admin Admin)))
  (Map escalate (From Login) (To Login)
    (Cases (S0 S0) (S1 S1) (S2 S2) (Locked Locked) (Auth Admin) (Admin Admin)))
  (Machine Protocol (States Login) (Observe stage stage-of)
    (Action fail fail) (Action ok ok) (Action escalate escalate))
  (Map identity (From Stage) (To Stage) (Cases (Start Start) (Locked Locked) (Auth Auth) (Admin Admin)))
  (Map afail (From Stage) (To Stage)
    (Choice (Start Start Locked) (Locked Locked) (Auth Auth) (Admin Admin)))
  (Map aok (From Stage) (To Stage)
    (Choice (Start Auth) (Locked Locked) (Auth Auth) (Admin Admin)))
  (Map aescalate (From Stage) (To Stage)
    (Choice (Start Start) (Locked Locked) (Auth Admin) (Admin Admin)))
  (Machine Abstract (States Stage) (Observe stage identity)
    (Action fail afail) (Action ok aok) (Action escalate aescalate) (Bag Set))
  (Simulation StageSim (Source Protocol) (Target Abstract) (Relation stage-of))
  (Representation StageQuotient (Of Protocol) (Encode stage-of))
  (Derive Safe (CheckSafety Abstract (Never (EnterFrom Admin (Not Auth))) (Via StageSim) (Init S0)))
  (Derive Lockout (CheckSafety Abstract (Never (ReachWithin Locked 2)) (Via StageSim) (Init S0))))
!(dc.run AccessProtocol (Refine StageQuotient (Preserve Encoding) (Until Stable)))
!(dc.run AccessProtocol (Refine StageQuotient))
!(dc.run AccessProtocol (Refine StageQuotient (Until (Steps 1))))
!(dc.run AccessProtocol (Refine StageQuotient (Budget (Unrollings 0))))
!(dc.run AccessProtocol (Refine StageQuotient (Budget (Unrollings 5))))
!(dc.run AccessProtocol (Refine StageQuotient (Under Foo)))
!(dc.run AccessProtocol Lockout)
