;; Review 2 F1 probe: multi-image Via relation, EnterFrom from-side pullback.
(DC.Module EnterFromProbe
  (Profile Nondeterministic)
  (Use Simulation)
  (Carrier Src (Of Symbol) (Enum S0 S2))
  (Carrier Tgt (Of Symbol) (Enum T0 T1))
  (Carrier Obs (Of Symbol) (Enum O))
  (Map sobs (From Src) (To Obs) (Cases (S0 O) (S2 O)))
  (Map tobs (From Tgt) (To Obs) (Cases (T0 O) (T1 O)))
  (Map sa0 (From Src) (To Src) (Cases (S0 S0) (S2 S0)))
  (Machine A (States Src) (Observe o sobs) (Action a0 sa0))
  (Map ta0 (From Tgt) (To Tgt) (Choice (T0 T1) (T1 T1)))
  (Machine B (States Tgt) (Observe o tobs) (Action a0 ta0) (Bag Set))
  (Map rel (From Src) (To Tgt) (Choice (S0 T1) (S2 T0 T1)))
  (Simulation H (Source A) (Target B) (Relation rel)))
!(dc.run EnterFromProbe (CheckSimulation H))
!(dc.run EnterFromProbe (CheckSafety B (Never (EnterFrom T1 (Not T0))) (Via H) (Init S2)))
!(dc.run EnterFromProbe (CheckSafety B (Never (EnterFrom T1 (Not T0))) (Via H) (Init S2) (Budget (Unrollings 5))))
!(dc.run EnterFromProbe (CheckSafety B (Never (EnterFrom T1 (Not T0))) (Via H) (Init S2) (Budget (Unrollings 0))))
