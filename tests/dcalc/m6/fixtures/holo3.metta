;; M6 review-1 F3 probe: exact 3-cycle with a non-involutive pushforward.
;; Spec Def 10.2: holonomy (phi, iota) lies in the gauge iff (phi, iota^-1) in G.
(DC.Module Holo3
  (Profile Crisp)
  (Use Transfers Hives)
  (Carrier S (Of Symbol) (Enum s0 s1 s2))
  (Carrier Bit (Of Nat) (Enum 0 1))
  (Map eq (From (Product S S)) (To Bit)
    (Cases ((Tuple s0 s0) 1) ((Tuple s0 s1) 0) ((Tuple s0 s2) 0)
           ((Tuple s1 s0) 0) ((Tuple s1 s1) 1) ((Tuple s1 s2) 0)
           ((Tuple s2 s0) 0) ((Tuple s2 s1) 0) ((Tuple s2 s2) 1)))
  (Map id3   (From S) (To S) (Cases (s0 s0) (s1 s1) (s2 s2)))
  (Map shift (From S) (To S) (Cases (s0 s1) (s1 s2) (s2 s0)))
  (Map unshift (From S) (To S) (Cases (s0 s2) (s1 s0) (s2 s1)))
  (MethodSystem A (States S) (Methods S) (Response eq))
  (MethodSystem B (States S) (Methods S) (Response eq))
  (MethodSystem C (States S) (Methods S) (Response eq))
  (Transfer AB (Source A) (Target B) (StatePullback id3) (MethodPushforward id3))
  (Transfer BC (Source B) (Target C) (StatePullback id3) (MethodPushforward id3))
  (Transfer CA (Source C) (Target A) (StatePullback unshift) (MethodPushforward shift))
  (Symmetry RotA (Of A) (States shift) (Methods shift))
  (Symmetry RotB (Of B) (States shift) (Methods shift))
  (Symmetry RotC (Of C) (States shift) (Methods shift))
  (TransferHive Rot (Member A) (Member B) (Member C)
    (Edge AB) (Edge BC) (Edge CA) (Cycle A B C)
    (Gauge A RotA) (Gauge B RotB) (Gauge C RotC)))
!(dc.run Holo3 (CheckTransfer CA))
!(dc.run Holo3 (CheckTransferHive Rot))
