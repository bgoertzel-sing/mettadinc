;; M6 review-2 F5 probe: KernelOf only under Proposition 10.4 (exact edges, bijective pushforwards).
(DC.Module KofHyp
  (Profile Crisp)
  (Use Transfers Hives)
  (Carrier Beacon (Of Symbol) (Enum Left Right))
  (Carrier Choice (Of Symbol) (Enum ChooseLeft ChooseRight))
  (Carrier Reward (Of Nat) (Enum 0 1))
  (Map reward (From (Product Beacon Choice)) (To Reward)
    (Cases ((Tuple Left ChooseLeft) 1) ((Tuple Left ChooseRight) 0)
           ((Tuple Right ChooseLeft) 0) ((Tuple Right ChooseRight) 1)))
  (Map same-state  (From Beacon) (To Beacon) (Cases (Left Left) (Right Right)))
  (Map flip-state  (From Beacon) (To Beacon) (Cases (Left Right) (Right Left)))
  (Map same-method (From Choice) (To Choice) (Cases (ChooseLeft ChooseLeft) (ChooseRight ChooseRight)))
  (Map flip-method (From Choice) (To Choice) (Cases (ChooseLeft ChooseRight) (ChooseRight ChooseLeft)))
  (MethodSystem A (States Beacon) (Methods Choice) (Response reward))
  (MethodSystem B (States Beacon) (Methods Choice) (Response reward))
  (MethodSystem C (States Beacon) (Methods Choice) (Response reward))
  (Transfer AB (Source A) (Target B) (StatePullback same-state) (MethodPushforward same-method))
  (Transfer BC (Source B) (Target C) (StatePullback same-state) (MethodPushforward same-method))
  (Transfer BadCA  (Source C) (Target A) (StatePullback flip-state) (MethodPushforward same-method))
  (Transfer GoodCA (Source C) (Target A) (StatePullback flip-state) (MethodPushforward flip-method))
  (Derive ABchecked     (CheckTransfer AB))
  (Derive BCchecked     (CheckTransfer BC))
  (Derive GoodCAchecked (CheckTransfer GoodCA))
  (Derive RoundTrip (ComposeTransfers (Output ABchecked Transfer) (Output BCchecked Transfer)
                                      (Output GoodCAchecked Transfer)))
  (Symmetry MirrorA (Of A) (States flip-state) (Methods flip-method))
  (Symmetry MirrorB (Of B) (States flip-state) (Methods flip-method))
  (Symmetry MirrorC (Of C) (States flip-state) (Methods flip-method))
  (TransferHive Beacons (Member A) (Member B) (Member C)
    (Edge AB) (Edge BC) (Edge GoodCA) (Cycle A B C)
    (Gauge A MirrorA) (Gauge B MirrorB) (Gauge C MirrorC))
  (TransferHive BeaconsStrict (Member A) (Member B) (Member C)
    (Edge AB) (Edge BC) (Edge GoodCA) (Cycle A B C))
  (Derive Derived   (KernelOf Beacons))
  (Derive Saturated (KernelOf Beacons (Saturate Gauge)))
  (Map const-method (From Choice) (To Choice) (Cases (ChooseLeft ChooseLeft) (ChooseRight ChooseLeft)))
  (Transfer ConstCA (Source C) (Target A) (StatePullback same-state) (MethodPushforward const-method))
  (TransferHive Bad (Member A) (Member B) (Member C) (Edge AB) (Edge BC) (Edge BadCA) (Cycle A B C))
  (TransferHive Const (Member A) (Member B) (Member C) (Edge AB) (Edge BC) (Edge ConstCA) (Cycle A B C)))
!(dc.run KofHyp (KernelOf Bad))
!(dc.run KofHyp (KernelOf Bad (Saturate Gauge)))
!(dc.run KofHyp (KernelOf Const))
!(dc.run KofHyp (KernelOf Beacons))
