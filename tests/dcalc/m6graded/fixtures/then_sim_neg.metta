;; m6-graded step 2 negatives: Then on simulations (copy of then_sim.metta plus H3) (spec Table 4 l.893-909: Simulation arrows are relations,
;; composed relationally; Def 3.7 l.805-811).  A -> B -> C, every observation O.
(DC.Module ThenSimNeg
  (Profile Nondeterministic)
  (Use Simulation)
  (Carrier X (Of Symbol) (Enum X0 X1))
  (Carrier Y (Of Symbol) (Enum Y0 Y1))
  (Carrier Z (Of Symbol) (Enum Z0))
  (Carrier Obs (Of Symbol) (Enum O))
  (Map xo (From X) (To Obs) (Cases (X0 O) (X1 O)))
  (Map yo (From Y) (To Obs) (Cases (Y0 O) (Y1 O)))
  (Map zo (From Z) (To Obs) (Cases (Z0 O)))
  (Map xa (From X) (To X) (Cases (X0 X1) (X1 X0)))
  (Map ya (From Y) (To Y) (Choice (Y0 Y0 Y1) (Y1 Y0 Y1)))
  (Map za (From Z) (To Z) (Cases (Z0 Z0)))
  (Machine A (States X) (Observe o xo) (Action a0 xa))
  (Machine B (States Y) (Observe o yo) (Action a0 ya) (Bag Set))
  (Machine C (States Z) (Observe o zo) (Action a0 za) (Bag Set))
  (Map r1 (From X) (To Y) (Choice (X0 Y0) (X1 Y1)))
  (Map r2 (From Y) (To Z) (Choice (Y0 Z0) (Y1 Z0)))
  (Simulation H1 (Source A) (Target B) (Relation r1))
  (Simulation H2 (Source B) (Target C) (Relation r2))
  (Derive S1 (CheckSimulation H1))
  (Derive S2 (CheckSimulation H2))
  ;; H3: B -> A with Y0 ~ X0, Y1 ~ X1.  B steps Y0 -> Y1 but A steps X0 -> X1 only from X0 -> X1 ... Y0 -> Y0 needs X1 ~ Y0: not related, so H3 is Refuted.
  (Map r3 (From Y) (To X) (Choice (Y0 X0) (Y1 X1)))
  (Simulation H3 (Source B) (Target A) (Relation r3))
  (Derive S3 (CheckSimulation H3))
  (Derive S3b (CheckSimulation H3 (Budget (PairExpansions 0)))))
!(dc.run ThenSimNeg S3)
!(dc.run ThenSimNeg (Then (Output S3 Value) (Output S1 Value)))
!(dc.run ThenSimNeg (Then (Output S2 Value) (Output S1 Value)))
!(dc.run ThenSimNeg (Then (Output S3b Value) (Output S1 Value)))
!(dc.run ThenSimNeg (Then (Output S1 Value) (Output S1 Value)))
