;; t-2026-11-26-mettadinc-shared-loader: shared map rules on the Families elaborator output path (families.c fe_table_rules).
;; A Symbolic module folds a Table on a symbol carrier and drops it before admission; the shared rules now run on it first.
;; Each module breaks one rule in idx (dup, partial) or tag (codomain: i2 is not in carrier K).  FmControl is decided.
;; Template: families/fixtures/for_small.metta (FS).
(DC.Module FmTableDup
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors Families)
  (Carrier Bit  (Of Nat) (Enum 0 1))
  (Carrier Word (Of (BitVector 3)) (All))
  (Carrier Ix (Of Symbol) (Enum i0 i1 i2))
  (Carrier K (Of Symbol) (Enum k0 k1 k2))
  (Map idx (From Ix) (To Nat) (Table (i0 0) (i1 1) (i2 2) (i0 1)))
  (Map tag (From Ix) (To K) (Table (i0 k0) (i1 k1) (i2 k2)))
  (Map setb (Parameters ($i Ix)) (From Word) (To Word) (Body ($x) (SetBit $x (idx $i) 1)))
  (Map read2 (From Word) (To Bit) (Body ($x) (BitAt $x 2)))
  (Machine M (States Word) (Observe x2 read2) (Action (set $i) (setb $i) (For $i Ix)))
  (Carrier FromZero (Of (BitVector 3)) (Reach M (From 0)))
  (Machine MR (States FromZero) (Observe x2 read2) (ActionsOf M))
  (BlockPartition Bit2Low (On FromZero)
    (Block B0 (Body ($x) (Eq (BitAt $x 2) 0)) 0)
    (Successor Any B0 B0)))
(DC.Module FmTableTotal
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors Families)
  (Carrier Bit  (Of Nat) (Enum 0 1))
  (Carrier Word (Of (BitVector 3)) (All))
  (Carrier Ix (Of Symbol) (Enum i0 i1 i2))
  (Carrier K (Of Symbol) (Enum k0 k1 k2))
  (Map idx (From Ix) (To Nat) (Table (i0 0) (i1 1)))
  (Map tag (From Ix) (To K) (Table (i0 k0) (i1 k1) (i2 k2)))
  (Map setb (Parameters ($i Ix)) (From Word) (To Word) (Body ($x) (SetBit $x (idx $i) 1)))
  (Map read2 (From Word) (To Bit) (Body ($x) (BitAt $x 2)))
  (Machine M (States Word) (Observe x2 read2) (Action (set $i) (setb $i) (For $i Ix)))
  (Carrier FromZero (Of (BitVector 3)) (Reach M (From 0)))
  (Machine MR (States FromZero) (Observe x2 read2) (ActionsOf M))
  (BlockPartition Bit2Low (On FromZero)
    (Block B0 (Body ($x) (Eq (BitAt $x 2) 0)) 0)
    (Successor Any B0 B0)))
(DC.Module FmTableCodomain
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors Families)
  (Carrier Bit  (Of Nat) (Enum 0 1))
  (Carrier Word (Of (BitVector 3)) (All))
  (Carrier Ix (Of Symbol) (Enum i0 i1 i2))
  (Carrier K (Of Symbol) (Enum k0 k1 k2))
  (Map idx (From Ix) (To Nat) (Table (i0 0) (i1 1) (i2 2)))
  (Map tag (From Ix) (To K) (Table (i0 k0) (i1 k1) (i2 i2)))
  (Map setb (Parameters ($i Ix)) (From Word) (To Word) (Body ($x) (SetBit $x (idx $i) 1)))
  (Map read2 (From Word) (To Bit) (Body ($x) (BitAt $x 2)))
  (Machine M (States Word) (Observe x2 read2) (Action (set $i) (setb $i) (For $i Ix)))
  (Carrier FromZero (Of (BitVector 3)) (Reach M (From 0)))
  (Machine MR (States FromZero) (Observe x2 read2) (ActionsOf M))
  (BlockPartition Bit2Low (On FromZero)
    (Block B0 (Body ($x) (Eq (BitAt $x 2) 0)) 0)
    (Successor Any B0 B0)))
(DC.Module FmControl
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors Families)
  (Carrier Bit  (Of Nat) (Enum 0 1))
  (Carrier Word (Of (BitVector 3)) (All))
  (Carrier Ix (Of Symbol) (Enum i0 i1 i2))
  (Carrier K (Of Symbol) (Enum k0 k1 k2))
  (Map idx (From Ix) (To Nat) (Table (i0 0) (i1 1) (i2 2)))
  (Map tag (From Ix) (To K) (Table (i0 k0) (i1 k1) (i2 k2)))
  (Map setb (Parameters ($i Ix)) (From Word) (To Word) (Body ($x) (SetBit $x (idx $i) 1)))
  (Map read2 (From Word) (To Bit) (Body ($x) (BitAt $x 2)))
  (Machine M (States Word) (Observe x2 read2) (Action (set $i) (setb $i) (For $i Ix)))
  (Carrier FromZero (Of (BitVector 3)) (Reach M (From 0)))
  (Machine MR (States FromZero) (Observe x2 read2) (ActionsOf M))
  (BlockPartition Bit2Low (On FromZero)
    (Block B0 (Body ($x) (Eq (BitAt $x 2) 0)) 0)
    (Successor Any B0 B0)))
!(dc.run FmTableDup (CheckBlockPartition Bit2Low (Of MR)))
!(dc.run FmTableTotal (CheckBlockPartition Bit2Low (Of MR)))
!(dc.run FmTableCodomain (CheckBlockPartition Bit2Low (Of MR)))
!(dc.run FmControl (CheckBlockPartition Bit2Low (Of MR)))
