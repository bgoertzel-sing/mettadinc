;; t-2026-11-26-mettadinc-shared-loader: shared map rules, M7 availability (ops_m7.c dc_req_m7 via m7_rules / dc_mr_value).
;; Template: review_fixes/fixtures/mut_m7_partial.metta.  Exact-equal duplicate Cases keys are refused first by the admit.c lint
;; (review_fixes mut_m7_caseoverlap_*), so no duplicate module here.  M7Control is decided (Refuted), not InvalidInput.
(DC.Module M7EncPartial
  (Profile Crisp)
  (Use Hyperseed)
  (Type Report (Sum Missing (Observed PBit)))
  (Carrier Case (Of Symbol) (Enum Absent Neither Support Oppose Both))
  (Map report (From Case) (To Report)
    (Cases (Absent Missing) (Neither (Observed (PBit 0 0))) (Support (Observed (PBit 1 0))) (Oppose (Observed (PBit 0 1))) (Both (Observed (PBit 1 1)))))
  (Map bias (From Case) (To Int)
    (Cases (Absent 0) (Neither 0) (Support 1) (Oppose -1)))
  (Map stay (From Case) (To Case) (Cases (Absent Absent) (Neither Neither) (Support Support) (Oppose Oppose) (Both Both)))
  (Machine Reports (States Case) (Observe report report) (Action stay stay))
  (Representation Bias (Of Reports) (Encode bias)))
(DC.Module M7ObsPartial
  (Profile Crisp)
  (Use Hyperseed)
  (Type Report (Sum Missing (Observed PBit)))
  (Carrier Case (Of Symbol) (Enum Absent Neither Support Oppose Both))
  (Map report (From Case) (To Report)
    (Cases (Absent Missing) (Neither (Observed (PBit 0 0))) (Support (Observed (PBit 1 0))) (Oppose (Observed (PBit 0 1)))))
  (Map bias (From Case) (To Int)
    (Cases (Absent 0) (Neither 0) (Support 1) (Oppose -1) (Both 0)))
  (Map stay (From Case) (To Case) (Cases (Absent Absent) (Neither Neither) (Support Support) (Oppose Oppose) (Both Both)))
  (Machine Reports (States Case) (Observe report report) (Action stay stay))
  (Representation Bias (Of Reports) (Encode bias)))
