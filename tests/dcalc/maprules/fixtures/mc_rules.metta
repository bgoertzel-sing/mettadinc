;; t-2026-11-26-mettadinc-shared-loader: shared map rules, Crisp profile (model.c map loaders).
;; Each module breaks exactly one rule in map id; exact-equal duplicate Cases keys are left to the admit.c lint,
;; so the Cases duplicate case is a pattern overlap. McControl answers Checked. Template: m0_cases_logic logic_negative.metta.
(DC.Module McTableDup
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Table (a a) (b b) (a b)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
(DC.Module McTableTotal
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Table (a a)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
(DC.Module McTableCodomain
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Table (a a) (b yes)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
(DC.Module McCasesOverlap
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases (a a) ($s $s)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
(DC.Module McCasesTotal
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases (a a)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
(DC.Module McCasesCodomain
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Cases (a a) (b yes)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
(DC.Module McControl
  (Profile Crisp)
  (Carrier S (Of Symbol) (Enum a b))
  (Carrier O (Of Symbol) (Enum yes no))
  (Map id (From S) (To S) (Table (a a) (b b)))
  (Map ob (From S) (To O) (Table (a yes) (b no)))
  (Machine M (States S) (Observe ob ob) (Action id id))
  (Representation R (Of M) (Encode id)))
!(dc.run McTableDup (CheckNow R))
!(dc.run McTableTotal (CheckNow R))
!(dc.run McTableCodomain (CheckNow R))
!(dc.run McCasesOverlap (CheckNow R))
!(dc.run McCasesTotal (CheckNow R))
!(dc.run McCasesCodomain (CheckNow R))
!(dc.run McControl (CheckNow R))
