;; t-2026-11-26-mettadinc-shared-loader: shared map rules, Stochastic profile (stoch.c maps + TransitionKernel).
;; Each module breaks exactly one rule; StControl answers Checked. Template: examples_e2e/repro/stoch_reach_carrier_control.metta.
(DC.Module StMapTotal
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StMapCodomain
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c a)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerDupRow
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)) (Row a (Mass a 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerMissingRow
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerDupOutcome
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b (Rat 1 2)) (Mass b (Rat 1 2))) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerCodomain
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass o 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerMassNeg
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b (Rat 3 2)) (Mass c (Rat -1 2))) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerMassSum
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b (Rat 1 2))) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StControl
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
;; Review 1 F1: Reach restriction (stoch.c st_restrict_ker -> dc_mr_mass_row R4, st_restrict_map endo -> dc_mr_value R3); StReachControl answers Checked.
(DC.Module StReachMass
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (TransitionKernel K2 (From S) (To S) (Row a (Mass c 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine N (States S) (Observe obs obs) (Action go K))
  (Carrier R (Of Symbol) (Reach N (From a)))
  (Machine M (States R) (Observe obs obs) (Action go K2))
  (Derive LM (MinimalLinear M)))
(DC.Module StReachImage
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (Map f (From S) (To S) (Cases (a c) (b b) (c c)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine N (States S) (Observe obs obs) (Action go K))
  (Carrier R (Of Symbol) (Reach N (From a)))
  (Machine M (States R) (Observe obs obs) (Action go f))
  (Derive LM (MinimalLinear M)))
(DC.Module StReachControl
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine N (States S) (Observe obs obs) (Action go K))
  (Carrier R (Of Symbol) (Reach N (From a)))
  (Machine M (States R) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
!(dc.run StMapTotal LM)
!(dc.run StMapCodomain LM)
!(dc.run StKerDupRow LM)
!(dc.run StKerMissingRow LM)
!(dc.run StKerDupOutcome LM)
!(dc.run StKerCodomain LM)
!(dc.run StKerMassNeg LM)
!(dc.run StKerMassSum LM)
!(dc.run StReachMass LM)
!(dc.run StReachImage LM)
!(dc.run StReachControl LM)
!(dc.run StControl LM)
;; t-2026-11-27-mettadinc-loader-followups item 4: a linear-arrow matrix column (A0, a Source state) outside the Target states;
;; the column check goes through the shared R3 call dc_mr_value (stoch.c linear-arrow loader). StLinControl = D2Min.
(DC.Module StLinBadCol
  (Profile Stochastic)
  (Use Linear)
  (Carrier Report (Of Nat) (Enum 0 1))
  (Carrier SA (Of Symbol) (Enum A0))
  (Map repA (From SA) (To Report) (Cases (A0 0)))
  (TransitionKernel KAa (From SA) (To SA) (Row A0 (Mass A0 1)))
  (Machine MA (States SA) (Observe report repA) (Action a KAa))
  (Carrier SB (Of Symbol) (Enum B0))
  (Map repB (From SB) (To Report) (Cases (B0 1)))
  (TransitionKernel KBa (From SB) (To SB) (Row B0 (Mass B0 1)))
  (Machine MB (States SB) (Observe report repB) (Action a KBa))
  (LinearArrow L (Source MA) (Target MB) (Kind Positive) (Matrix (Rows (A0 (A0 1)))))
  (Derive LChecked (CheckLinearArrow L)))
!(dc.run StLinBadCol LChecked)
(DC.Module StLinControl
  (Profile Stochastic)
  (Use Linear)
  (Carrier Report (Of Nat) (Enum 0 1))
  (Carrier SA (Of Symbol) (Enum A0))
  (Map repA (From SA) (To Report) (Cases (A0 0)))
  (TransitionKernel KAa (From SA) (To SA) (Row A0 (Mass A0 1)))
  (Machine MA (States SA) (Observe report repA) (Action a KAa))
  (Carrier SB (Of Symbol) (Enum B0))
  (Map repB (From SB) (To Report) (Cases (B0 1)))
  (TransitionKernel KBa (From SB) (To SB) (Row B0 (Mass B0 1)))
  (Machine MB (States SB) (Observe report repB) (Action a KBa))
  (LinearArrow L (Source MA) (Target MB) (Kind Positive) (Matrix (Rows (A0 (B0 1)))))
  (Derive LChecked (CheckLinearArrow L)))
!(dc.run StLinControl LChecked)
