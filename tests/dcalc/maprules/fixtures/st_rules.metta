;; t-2026-11-26-mettadinc-shared-loader: shared map rules, Stochastic profile (stoch.c maps + TransitionKernel).
;; Each module breaks exactly one rule; StControl answers Checked. Template: examples_e2e/repro/stoch_reach_carrier_control.metta.
(DC.Module StMapTotal
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StMapCodomain
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c a)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerDupRow
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)) (Row a (Mass a 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerMissingRow
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerDupOutcome
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b (Rat 1 2)) (Mass b (Rat 1 2))) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerCodomain
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass o 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerMassNeg
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b (Rat 3 2)) (Mass c (Rat -1 2))) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StKerMassSum
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b (Rat 1 2))) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
(DC.Module StControl
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Carrier O (Of Symbol) (Enum o p))
  (Map obs (From S) (To O) (Cases (a o) (b o) (c p)))
  (TransitionKernel K (From S) (To S) (Row a (Mass b 1)) (Row b (Mass b 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe obs obs) (Action go K))
  (Derive LM (MinimalLinear M)))
!(dc.run StMapTotal LM)
!(dc.run StMapCodomain LM)
!(dc.run StKerDupRow LM)
!(dc.run StKerMissingRow LM)
!(dc.run StKerDupOutcome LM)
!(dc.run StKerCodomain LM)
!(dc.run StKerMassNeg LM)
!(dc.run StKerMassSum LM)
!(dc.run StControl LM)
