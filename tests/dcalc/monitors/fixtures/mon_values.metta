(DC.Module MonFix
  (Profile Stochastic)
  (Use Decisions Laws Families Monitors)
  (Carrier One  (Of Symbol) (Enum one))
  (Carrier Rate (Of Symbol) (Enum low high))
  (Map rate (From Rate) (To Rational01) (Table (low (Rat 1 4)) (high (Rat 1 2))))
  (Map flag (Parameters ($r Rate)) (From One) (To (Law Nat)) (Body ($u) (Coin (rate $r))))
  (Monitor Up     (Context One) (Null (flag low)) (Alternative (flag high)) (Columns (observation "x")))
  (Monitor Same   (Context One) (Null (flag low)) (Alternative (flag low))  (Columns (observation "x")))
  (Monitor Direct (Context One) (Null (Coin (Rat 1 4))) (Alternative (Coin (Rat 1 2))) (Columns (observation "x")))
  (Stream Hot  (Source "streams/hot.json")  (Digest "sha256:329ae55366ee77dcb37a2f661572ec64be8664c469dad27b391375cd1f5fa221")  (Provenance "fixture: eight ones"))
  (Stream Cold (Source "streams/cold.json") (Digest "sha256:1c9303c13e7c32ec29353c6cf449028efab21da687fb9b3e4b7cafddda0eaaf4") (Provenance "fixture: one then five zeros")))
!(dc.run MonFix (CheckMonitor Up))
!(dc.run MonFix (CheckMonitor Same))
!(dc.run MonFix (CheckMonitor Direct))
!(dc.run MonFix (Detect Up (On Hot) (Level (Rat 1 10))))
!(dc.run MonFix (Detect Up (On Cold) (Level (Rat 1 10))))
!(dc.run MonFix (Detect Up Same (On Hot) (Level (Rat 1 10))))
!(dc.run MonFix (Detect Up Same (On Hot) (Level (Rat 1 10)) (Combine Mixture)))
!(dc.run MonFix (Detect Up (On Hot) (Level (Rat 1 10)) (Scheme ShiryaevRoberts)))
!(dc.run MonFix (Detect Up (On Hot) (Level 0)))
