;; NatArith explicit-vs-symbolic agreement (t-2026-11-26-mettadinc-natarith-v2): the same six NatArith maps on
;; {0..7}, once as an explicit Int carrier (Crisp, M0) and once as (BitVector 3) words (symbolic M3).
;; run_natarith_gates.py requires identical partitions (block reps and sizes) for every D_<prim>.
(DC.Module NAE
  (Profile Crisp)
  (Use NatArith)
  (Carrier X (Of Int) (Enum 0 1 2 3 4 5 6 7))
  (Map q3 (From X) (To X) (Body ($x) (Quot $x 3)))
  (Map r3 (From X) (To X) (Body ($x) (Rem $x 3)))
  (Map mn5 (From X) (To X) (Body ($x) (Min $x 5)))
  (Map mx5 (From X) (To X) (Body ($x) (Max $x 5)))
  (Map lt4 (From X) (To X) (Body ($x) (If (Lt $x 4) $x 7)))
  (Map le4 (From X) (To X) (Body ($x) (If (Le $x 4) $x 7)))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Machine M_q3 (States X) (Observe o q3) (Action a act))
  (Derive D_q3 (MinimizeForQueries M_q3))
  (Machine M_r3 (States X) (Observe o r3) (Action a act))
  (Derive D_r3 (MinimizeForQueries M_r3))
  (Machine M_mn5 (States X) (Observe o mn5) (Action a act))
  (Derive D_mn5 (MinimizeForQueries M_mn5))
  (Machine M_mx5 (States X) (Observe o mx5) (Action a act))
  (Derive D_mx5 (MinimizeForQueries M_mx5))
  (Machine M_lt4 (States X) (Observe o lt4) (Action a act))
  (Derive D_lt4 (MinimizeForQueries M_lt4))
  (Machine M_le4 (States X) (Observe o le4) (Action a act))
  (Derive D_le4 (MinimizeForQueries M_le4)))
!(dc.run NAE D_q3)
!(dc.run NAE D_r3)
!(dc.run NAE D_mn5)
!(dc.run NAE D_mx5)
!(dc.run NAE D_lt4)
!(dc.run NAE D_le4)
(DC.Module NAS
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Use NatArith)
  (Carrier X (Of (BitVector 3)) (All))
  (Map q3 (From X) (To X) (Body ($x) (Quot $x 3)))
  (Map r3 (From X) (To X) (Body ($x) (Rem $x 3)))
  (Map mn5 (From X) (To X) (Body ($x) (Min $x 5)))
  (Map mx5 (From X) (To X) (Body ($x) (Max $x 5)))
  (Map lt4 (From X) (To X) (Body ($x) (If (Lt $x 4) $x 7)))
  (Map le4 (From X) (To X) (Body ($x) (If (Le $x 4) $x 7)))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Machine M_q3 (States X) (Observe o q3) (Action a act))
  (Derive D_q3 (MinimizeForQueries M_q3))
  (Machine M_r3 (States X) (Observe o r3) (Action a act))
  (Derive D_r3 (MinimizeForQueries M_r3))
  (Machine M_mn5 (States X) (Observe o mn5) (Action a act))
  (Derive D_mn5 (MinimizeForQueries M_mn5))
  (Machine M_mx5 (States X) (Observe o mx5) (Action a act))
  (Derive D_mx5 (MinimizeForQueries M_mx5))
  (Machine M_lt4 (States X) (Observe o lt4) (Action a act))
  (Derive D_lt4 (MinimizeForQueries M_lt4))
  (Machine M_le4 (States X) (Observe o le4) (Action a act))
  (Derive D_le4 (MinimizeForQueries M_le4)))
!(dc.run NAS D_q3)
!(dc.run NAS D_r3)
!(dc.run NAS D_mn5)
!(dc.run NAS D_mx5)
!(dc.run NAS D_lt4)
!(dc.run NAS D_le4)
