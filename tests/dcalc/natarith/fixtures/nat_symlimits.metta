;; NatArith symbolic-engine limits (t-2026-11-26-mettadinc-natarith-v2, review 1 finding 2).
;; Forms outside the symbolic fragment must answer Unsupported with a reason, never InvalidInput.
;; NSL: (BitVector 3) words, symbolic engine. NSE: the same valid map on an explicit Int carrier {0..7} (Checked).
(DC.Module NSL
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Use NatArith)
  (Carrier X (Of (BitVector 3)) (All))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Map qv (From X) (To X) (Body ($x) (Quot 6 $x)))
  (Map qz (From X) (To X) (Body ($x) (Quot $x 0)))
  (Map mx9 (From X) (To X) (Body ($x) (Max $x 9)))
  (Map qm (From X) (To X) (Body ($x) (Quot 6 (Max $x 1))))
  (Machine M_qv (States X) (Observe o qv) (Action a act))
  (Machine M_qz (States X) (Observe o qz) (Action a act))
  (Machine M_mx9 (States X) (Observe o mx9) (Action a act))
  (Machine M_qm (States X) (Observe o qm) (Action a act))
  (Machine M_qa (States X) (Observe o act) (Action a qm))
  (Derive D_qv (MinimizeForQueries M_qv))
  (Derive D_qz (MinimizeForQueries M_qz))
  (Derive D_mx9 (MinimizeForQueries M_mx9))
  (Derive D_qm (MinimizeForQueries M_qm))
  (Derive D_qa (MinimizeForQueries M_qa)))
!(dc.run NSL D_qv)
!(dc.run NSL D_qz)
!(dc.run NSL D_mx9)
!(dc.run NSL D_qm)
!(dc.run NSL D_qa)
(DC.Module NSE
  (Profile Crisp)
  (Use NatArith)
  (Carrier X (Of Int) (Enum 0 1 2 3 4 5 6 7))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Map qm (From X) (To X) (Body ($x) (Quot 6 (Max $x 1))))
  (Machine M_qm (States X) (Observe o qm) (Action a act))
  (Derive D_qm (MinimizeForQueries M_qm)))
!(dc.run NSE D_qm)
