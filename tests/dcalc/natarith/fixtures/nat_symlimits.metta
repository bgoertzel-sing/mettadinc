;; NatArith symbolic-engine limits (t-2026-11-26-mettadinc-natarith-v2, review 1 finding 2).
;; Forms outside the symbolic fragment must answer Unsupported with a reason, never InvalidInput.
;; Review 2 finding 1 (revision 3): the limited form may also sit one level below another head (NatArith, If,
;; Le/Lt, Rem) and in an Action map, an Encode map (CheckNow) or a block predicate (CheckBlockPartition):
;; modules NSN and NSD below (split because a symbolic module holds at most 8 machines).
;; Note: the CNF twin self-check (nat_twin_check) only runs for maps whose input is at most 10 bits; a wider
;; map such as (Quot $x 1000) on 12-bit words answers Checked without it. This is by design (all-words check cost).
;; NSL: (BitVector 3) words, symbolic engine. NSE: the same valid map on an explicit Int carrier {0..7} (Checked).
(DC.Module NSL
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Use NatArith)
  (Carrier X (Of (BitVector 3)) (All))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Map qv (From X) (To X) (Body ($x) (Quot 6 $x)))
  (Map qz (From X) (To X) (Body ($x) (Quot $x 0)))
  (Map mx9 (From X) (To X) (Body ($x) (Max $x 9)))
  (Map qm (From X) (To X) (Body ($x) (Quot 6 (Max $x 1))))
  (Machine M_qv (States X) (Observe o qv) (Action a act))
  (Machine M_qz (States X) (Observe o qz) (Action a act))
  (Machine M_mx9 (States X) (Observe o mx9) (Action a act))
  (Machine M_qm (States X) (Observe o qm) (Action a act))
  (Machine M_qa (States X) (Observe o act) (Action a qm))
  (Derive D_qv (MinimizeForQueries M_qv))
  (Derive D_qz (MinimizeForQueries M_qz))
  (Derive D_mx9 (MinimizeForQueries M_mx9))
  (Derive D_qm (MinimizeForQueries M_qm))
  (Derive D_qa (MinimizeForQueries M_qa)))
!(dc.run NSL D_qv)
!(dc.run NSL D_qz)
!(dc.run NSL D_mx9)
!(dc.run NSL D_qm)
!(dc.run NSL D_qa)
(DC.Module NSN
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Use NatArith)
  (Carrier X (Of (BitVector 3)) (All))
  (Carrier B (Of (BitVector 1)) (All))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Map obs (From X) (To B) (Body ($x) (Lt $x 4)))
  (Map d1 (From X) (To X) (Body ($x) (Max (Quot 6 $x) 1)))
  (Map d2 (From X) (To X) (Body ($x) (If (Lt $x 2) (Quot 6 $x) 1)))
  (Map d3 (From X) (To X) (Body ($x) (Min 1 (Max $x 9))))
  (Map d5 (From X) (To X) (Body ($x) (Quot (Max $x 9) 2)))
  (Machine M_d1 (States X) (Observe o d1) (Action a act))
  (Derive D_d1 (MinimizeForQueries M_d1))
  (Machine M_d2 (States X) (Observe o d2) (Action a act))
  (Derive D_d2 (MinimizeForQueries M_d2))
  (Machine M_d3 (States X) (Observe o d3) (Action a act))
  (Derive D_d3 (MinimizeForQueries M_d3))
  (Machine M_d5 (States X) (Observe o d5) (Action a act))
  (Derive D_d5 (MinimizeForQueries M_d5)))
!(dc.run NSN D_d1)
!(dc.run NSN D_d2)
!(dc.run NSN D_d3)
!(dc.run NSN D_d5)
(DC.Module NSD
  (Profile (Dynamics Deterministic) (Values Crisp) (Carriers Symbolic))
  (Use BitVectors)
  (Use NatArith)
  (Carrier X (Of (BitVector 3)) (All))
  (Carrier B (Of (BitVector 1)) (All))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Map obs (From X) (To B) (Body ($x) (Lt $x 4)))
  (Map d6 (From X) (To X) (Body ($x) (If (Lt $x 8) $x (Quot $x 0))))
  (Map d7 (From X) (To X) (Body ($x) (Rem (Quot $x 0) 2)))
  (Map d1 (From X) (To X) (Body ($x) (Max (Quot 6 $x) 1)))
  (Map d4 (From X) (To B) (Body ($x) (Le (Quot 6 $x) 2)))
  (Machine M_d6 (States X) (Observe o d6) (Action a act))
  (Derive D_d6 (MinimizeForQueries M_d6))
  (Machine M_d7 (States X) (Observe o d7) (Action a act))
  (Derive D_d7 (MinimizeForQueries M_d7))
  (Machine M_d4 (States X) (Observe o d4) (Action a act))
  (Derive D_d4 (MinimizeForQueries M_d4))
  (Machine M_da (States X) (Observe o act) (Action a d6))
  (Derive D_da (MinimizeForQueries M_da))
  (Machine M_ob (States X) (Observe o obs) (Action a act))
  (Representation R6 (Of M_ob) (Encode d6))
  (Representation R1 (Of M_ob) (Encode d1))
  (BlockPartition BP (On X)
    (Block P0 (Body ($x) (Le (Quot 6 $x) 2)) 0)
    (Block P1 (Body ($x) (Not (Le (Quot 6 $x) 2))) 1)
    (Successor a P0 P0) (Successor a P1 P1))
  (BlockPartition BZ (On X)
    (Block Z0 (Body ($x) (Eq (Rem (Quot $x 0) 2) 0)) 0)
    (Block Z1 (Body ($x) (Not (Eq (Rem (Quot $x 0) 2) 0))) 1)
    (Successor a Z0 Z0) (Successor a Z1 Z1))
  (Derive DP (CheckBlockPartition BP (Of M_ob)))
  (Derive DZ (CheckBlockPartition BZ (Of M_ob))))
!(dc.run NSD D_d6)
!(dc.run NSD D_d7)
!(dc.run NSD D_d4)
!(dc.run NSD D_da)
!(dc.run NSD (CheckNow R6))
!(dc.run NSD (CheckNow R1))
!(dc.run NSD DP)
!(dc.run NSD DZ)
(DC.Module NSE
  (Profile Crisp)
  (Use NatArith)
  (Carrier X (Of Int) (Enum 0 1 2 3 4 5 6 7))
  (Map act (From X) (To X) (Body ($x) (Max (Quot $x 2) 1)))
  (Map qm (From X) (To X) (Body ($x) (Quot 6 (Max $x 1))))
  (Machine M_qm (States X) (Observe o qm) (Action a act))
  (Derive D_qm (MinimizeForQueries M_qm)))
!(dc.run NSE D_qm)
