;; NatArith exact-value gates (t-2026-11-26-mettadinc-natarith-v2), doc03 s3.13 l.1166-1172, B.1 l.4395-4398.
;; Every case is a map from a singleton carrier into a singleton carrier holding the expected value, so a wrong
;; value is InvalidInput naming it and the right one is Checked. Release mode: Unsupported (NatArith beyond-only).
;; NQ: (Quot -7 2) = -4; (Quot 7 2) = 3; (Quot 6 3) = 2; (Quot 0 5) = 0; (Quot -1 3) = -1
(DC.Module NQ
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum -7))
  (Carrier V0 (Of Int) (Enum -4))
  (Map m0 (From A0) (To V0) (Body ($x) (Quot $x 2)))
  (Carrier A1 (Of Int) (Enum 7))
  (Carrier V1 (Of Int) (Enum 3))
  (Map m1 (From A1) (To V1) (Body ($x) (Quot $x 2)))
  (Carrier A2 (Of Int) (Enum 6))
  (Carrier V2 (Of Int) (Enum 2))
  (Map m2 (From A2) (To V2) (Body ($x) (Quot $x 3)))
  (Carrier A3 (Of Int) (Enum 0))
  (Carrier V3 (Of Int) (Enum 0))
  (Map m3 (From A3) (To V3) (Body ($x) (Quot $x 5)))
  (Carrier A4 (Of Int) (Enum -1))
  (Carrier V4 (Of Int) (Enum -1))
  (Map m4 (From A4) (To V4) (Body ($x) (Quot $x 3)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NQ (CheckNow R))
;; NR: (Rem -7 2) = 1; (Rem 7 2) = 1; (Rem 6 3) = 0; (Rem 0 5) = 0; (Rem -1 3) = 2
(DC.Module NR
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum -7))
  (Carrier V0 (Of Int) (Enum 1))
  (Map m0 (From A0) (To V0) (Body ($x) (Rem $x 2)))
  (Carrier A1 (Of Int) (Enum 7))
  (Carrier V1 (Of Int) (Enum 1))
  (Map m1 (From A1) (To V1) (Body ($x) (Rem $x 2)))
  (Carrier A2 (Of Int) (Enum 6))
  (Carrier V2 (Of Int) (Enum 0))
  (Map m2 (From A2) (To V2) (Body ($x) (Rem $x 3)))
  (Carrier A3 (Of Int) (Enum 0))
  (Carrier V3 (Of Int) (Enum 0))
  (Map m3 (From A3) (To V3) (Body ($x) (Rem $x 5)))
  (Carrier A4 (Of Int) (Enum -1))
  (Carrier V4 (Of Int) (Enum 2))
  (Map m4 (From A4) (To V4) (Body ($x) (Rem $x 3)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NR (CheckNow R))
;; NMN: (Min 3 3) = 3; (Min -2 5) = -2; (Min 9 4) = 4
(DC.Module NMN
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 3))
  (Carrier V0 (Of Int) (Enum 3))
  (Map m0 (From A0) (To V0) (Body ($x) (Min $x 3)))
  (Carrier A1 (Of Int) (Enum -2))
  (Carrier V1 (Of Int) (Enum -2))
  (Map m1 (From A1) (To V1) (Body ($x) (Min $x 5)))
  (Carrier A2 (Of Int) (Enum 9))
  (Carrier V2 (Of Int) (Enum 4))
  (Map m2 (From A2) (To V2) (Body ($x) (Min $x 4)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NMN (CheckNow R))
;; NMX: (Max 3 3) = 3; (Max -2 5) = 5; (Max 9 4) = 9
(DC.Module NMX
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 3))
  (Carrier V0 (Of Int) (Enum 3))
  (Map m0 (From A0) (To V0) (Body ($x) (Max $x 3)))
  (Carrier A1 (Of Int) (Enum -2))
  (Carrier V1 (Of Int) (Enum 5))
  (Map m1 (From A1) (To V1) (Body ($x) (Max $x 5)))
  (Carrier A2 (Of Int) (Enum 9))
  (Carrier V2 (Of Int) (Enum 9))
  (Map m2 (From A2) (To V2) (Body ($x) (Max $x 4)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NMX (CheckNow R))
;; NLE: (Le 3 3) = True; (Le 2 3) = True; (Le 4 3) = False
(DC.Module NLE
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 3))
  (Carrier V0 (Of Bool) (Enum True))
  (Map m0 (From A0) (To V0) (Body ($x) (Le $x 3)))
  (Carrier A1 (Of Int) (Enum 2))
  (Carrier V1 (Of Bool) (Enum True))
  (Map m1 (From A1) (To V1) (Body ($x) (Le $x 3)))
  (Carrier A2 (Of Int) (Enum 4))
  (Carrier V2 (Of Bool) (Enum False))
  (Map m2 (From A2) (To V2) (Body ($x) (Le $x 3)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NLE (CheckNow R))
;; NLT: (Lt 3 3) = False; (Lt 2 3) = True; (Lt 4 3) = False
(DC.Module NLT
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 3))
  (Carrier V0 (Of Bool) (Enum False))
  (Map m0 (From A0) (To V0) (Body ($x) (Lt $x 3)))
  (Carrier A1 (Of Int) (Enum 2))
  (Carrier V1 (Of Bool) (Enum True))
  (Map m1 (From A1) (To V1) (Body ($x) (Lt $x 3)))
  (Carrier A2 (Of Int) (Enum 4))
  (Carrier V2 (Of Bool) (Enum False))
  (Map m2 (From A2) (To V2) (Body ($x) (Lt $x 3)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NLT (CheckNow R))
;; NZQ: (Quot 5 0) = (Failed NonPositiveDivisor): InvalidInput naming the failure value
(DC.Module NZQ
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 5))
  (Map m0 (From A0) (To A0) (Body ($x) (Quot $x 0)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NZQ (CheckNow R))
;; NZR: (Rem 5 0) = (Failed NonPositiveDivisor): InvalidInput naming the failure value
(DC.Module NZR
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 5))
  (Map m0 (From A0) (To A0) (Body ($x) (Rem $x 0)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NZR (CheckNow R))
;; NNQ: (Quot 5 -2) = (Failed NonPositiveDivisor): InvalidInput naming the failure value
(DC.Module NNQ
  (Profile Crisp)
  (Use NatArith)
  (Carrier A0 (Of Int) (Enum 5))
  (Map m0 (From A0) (To A0) (Body ($x) (Quot $x -2)))
  (Map id (From A0) (To A0) (Body ($x) $x))
  (Machine M (States A0) (Observe o m0) (Action a id))
  (Representation R (Of M) (Encode m0)))
!(dc.run NNQ (CheckNow R))
;; NIF: (If (Le x 3) (Min x 2) (Quot x 0)) on {0..3} = 0 1 2 2; the Quot-by-zero branch must never be evaluated
(DC.Module NIF
  (Profile Crisp)
  (Use NatArith)
  (Carrier X (Of Int) (Enum 0 1 2 3))
  (Carrier Y (Of Int) (Enum 0 1 2))
  (Map g (From X) (To Y) (Body ($x) (If (Le $x 3) (Min $x 2) (Quot $x 0))))
  (Map id (From X) (To X) (Body ($x) $x))
  (Machine M (States X) (Observe o g) (Action a id))
  (Representation R (Of M) (Encode g)))
!(dc.run NIF (CheckNow R))
