  (TransitionKernel K13 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K14 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe f f) (Action go f)))
!(dc.run FK (TracePartition M))
