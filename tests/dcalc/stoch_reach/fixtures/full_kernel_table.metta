;; t-2026-11-26-mettadinc-stoch-reach-followups case 2: the kernel table is full (16 = ST_MAXD declared kernels) when a Map is
;; used as an Action; the V03 0/1 kernel cannot be built: an engine limit -> Unsupported, not InvalidInput.
(DC.Module FK
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Map f (From S) (To S) (Cases (a b) (b a) (c c)))
  (TransitionKernel K0 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K1 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K2 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K3 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K4 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K5 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K6 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K7 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K8 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K9 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K10 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K11 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K12 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K13 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K14 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K15 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (Machine M (States S) (Observe f f) (Action go f)))
(DC.Module FK15
  (Profile Stochastic)
  (Use Linear)
  (Carrier S (Of Symbol) (Enum a b c))
  (Map f (From S) (To S) (Cases (a b) (b a) (c c)))
  (TransitionKernel K0 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
  (TransitionKernel K1 (From S) (To S) (Row a (Mass b 1)) (Row b (Mass a 1)) (Row c (Mass c 1)))
