From 514b554c502351416cd2cf8e69891f3691c81c5e Mon Sep 17 00:00:00 2001
From: ProtoMegaBot2 <protomega2@hive.local>
Date: Fri, 6 Nov 2026 12:50:37 +0000
Subject: [PATCH] dcalc: register MeTTaDinC M0 core as native module (import
 bit 23, provisional)

Adds src/library_dcalc.{h,c} (CETTA_NATIVE_IMPORT_DCALC defined once),
a g_native_modules entry, a grounded_dispatch_accepts_data_arg exception
for the request argument, and a DCALC_DIR Makefile block.
Against zariuq/CeTTa 4c285a97. Local only; not pushed.
---
 Makefile                |  8 ++++++-
 native/native_modules.c |  2 ++
 src/eval.c              |  6 +++++
 src/library_dcalc.c     | 51 +++++++++++++++++++++++++++++++++++++++++
 src/library_dcalc.h     | 20 ++++++++++++++++
 5 files changed, 86 insertions(+), 1 deletion(-)
 create mode 100644 src/library_dcalc.c
 create mode 100644 src/library_dcalc.h

diff --git a/Makefile b/Makefile
index d957a450..46621e5a 100644
--- a/Makefile
+++ b/Makefile
@@ -689,7 +689,7 @@ PROC_FORK_SPAWN_CPPFLAGS =
 ifeq ($(CETTA_PROC_FORK_SPAWN),1)
 PROC_FORK_SPAWN_CPPFLAGS = -DCETTA_PROC_FORK_SPAWN=1
 endif
-CPPFLAGS = -Isrc -I. -Iexperiments/gslt2parse_foundation/native $(BRIDGE_CFLAGS) $(PY_CFLAGS) $(GMP_CFLAGS) $(LIB_PROLOG_CFLAGS) $(HTTP_CFLAGS) $(DURABLE_CFLAGS) $(PROVENANCE_CPPFLAGS) $(PRIME_RECEIPT_INDEX_CPPFLAGS) $(PRIME_NEED_HEAP_INDEX_CPPFLAGS) $(PRIME_NEED_CLOSURE_CAPTURE_CPPFLAGS) $(PRIME_EVAL_STACK_CPPFLAGS) $(PROC_FORK_SPAWN_CPPFLAGS) -include $(BUILD_CONFIG_HEADER)
+CPPFLAGS = -Isrc -I. $(CPPFLAGS_DCALC) -Iexperiments/gslt2parse_foundation/native $(BRIDGE_CFLAGS) $(PY_CFLAGS) $(GMP_CFLAGS) $(LIB_PROLOG_CFLAGS) $(HTTP_CFLAGS) $(DURABLE_CFLAGS) $(PROVENANCE_CPPFLAGS) $(PRIME_RECEIPT_INDEX_CPPFLAGS) $(PRIME_NEED_HEAP_INDEX_CPPFLAGS) $(PRIME_NEED_CLOSURE_CAPTURE_CPPFLAGS) $(PRIME_EVAL_STACK_CPPFLAGS) $(PROC_FORK_SPAWN_CPPFLAGS) -include $(BUILD_CONFIG_HEADER)
 CFLAGS = -O3 -Wall -Werror -std=c11 -pthread
 DEPFLAGS = -MMD -MP
 # Libraries a binary does not use are not recorded as its dependencies, with
@@ -786,6 +786,12 @@ SRC += src/binary_codec.c src/library_binary.c
 SRC += src/library_heap.c
 SRC += src/library_work.c
 SRC += src/library_dag.c
+# MeTTaDinC M0 core (native module "dcalc").  DCALC_DIR is the mettadinc
+# src/dcalc directory; the default assumes CeTTa is the mettadinc submodule.
+DCALC_DIR ?= ../src/dcalc
+DCALC_CORE_SRC = sexp.c sha256.c binding.c api.c model.c ops_core.c obligations.c ops_req.c ops_induce.c ops_abs.c ops_dispatch.c records.c
+SRC += src/library_dcalc.c $(addprefix $(DCALC_DIR)/,$(DCALC_CORE_SRC))
+CPPFLAGS_DCALC = -I$(DCALC_DIR)
 SRC += src/u64_index.c
 SRC += src/library_syntax.c
 SRC += src/str_stream.c
