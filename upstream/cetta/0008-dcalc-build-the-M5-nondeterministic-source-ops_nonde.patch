From 859e2189741a89b23ca7c70ea377735f08368dad Mon Sep 17 00:00:00 2001
From: ProtoMegaBot2 <protomega2@hive.local>
Date: Fri, 13 Nov 2026 00:35:27 +0000
Subject: [PATCH] dcalc: build the M5 nondeterministic source (ops_nondet.c)

---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 7db1bae4..a2b3cc2f 100644
--- a/Makefile
+++ b/Makefile
@@ -789,7 +789,7 @@ SRC += src/library_dag.c
 # MeTTaDinC M0 core (native module "dcalc").  DCALC_DIR is the mettadinc
 # src/dcalc directory; the default assumes CeTTa is the mettadinc submodule.
 DCALC_DIR ?= ../src/dcalc
-DCALC_CORE_SRC = rat.c graded.c ops_graded.c ops_refine.c ops_weakest.c ops_approx.c ops_kernels.c sexp.c sha256.c registry_gen.c registry_beyond_gen.c registry.c admit.c binding.c api.c model.c ops_core.c obligations.c ops_req.c ops_induce.c ops_abs.c ops_dispatch.c records.c bdd.c ops_sym.c stoch.c estimates.c ops_est.c
+DCALC_CORE_SRC = rat.c graded.c ops_graded.c ops_refine.c ops_weakest.c ops_approx.c ops_kernels.c sexp.c sha256.c registry_gen.c registry_beyond_gen.c registry.c admit.c binding.c api.c model.c ops_core.c obligations.c ops_req.c ops_induce.c ops_abs.c ops_dispatch.c records.c bdd.c ops_sym.c stoch.c estimates.c ops_est.c ops_nondet.c
 SRC += src/library_dcalc.c $(addprefix $(DCALC_DIR)/,$(DCALC_CORE_SRC))
 CPPFLAGS_DCALC = -I$(DCALC_DIR)
 SRC += src/u64_index.c
