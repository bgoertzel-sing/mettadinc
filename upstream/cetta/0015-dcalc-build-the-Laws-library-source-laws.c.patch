 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 70cc3334..d670dbf1 100644
--- a/Makefile
+++ b/Makefile
@@ -789,7 +789,7 @@ SRC += src/library_dag.c
 # MeTTaDinC M0 core (native module "dcalc").  DCALC_DIR is the mettadinc
 # src/dcalc directory; the default assumes CeTTa is the mettadinc submodule.
 DCALC_DIR ?= ../src/dcalc
-DCALC_CORE_SRC = rat.c lp_exact.c graded.c ops_graded.c ops_refine.c ops_weakest.c ops_approx.c ops_kernels.c sexp.c sha256.c registry_gen.c registry_beyond_gen.c registry.c admit.c binding.c api.c model.c ops_core.c obligations.c ops_req.c ops_induce.c ops_abs.c ops_dispatch.c records.c bdd.c ops_sym.c stoch.c estimates.c ops_est.c ops_nondet.c ops_contracts.c ops_hives.c ops_transfers.c ops_m7.c ops_m7_snapshot.c ops_m7_arith.c families.c
+DCALC_CORE_SRC = rat.c lp_exact.c graded.c ops_graded.c ops_refine.c ops_weakest.c ops_approx.c ops_kernels.c sexp.c sha256.c registry_gen.c registry_beyond_gen.c registry.c admit.c binding.c api.c model.c ops_core.c obligations.c ops_req.c ops_induce.c ops_abs.c ops_dispatch.c records.c bdd.c ops_sym.c stoch.c estimates.c ops_est.c ops_nondet.c ops_contracts.c ops_hives.c ops_transfers.c ops_m7.c ops_m7_snapshot.c ops_m7_arith.c families.c laws.c
 SRC += src/library_dcalc.c $(addprefix $(DCALC_DIR)/,$(DCALC_CORE_SRC))
 CPPFLAGS_DCALC = -I$(DCALC_DIR)
 SRC += src/u64_index.c
